#version 460
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
layout(constant_id=0) const uint tile_m=8;
layout(constant_id=1) const uint tile_n=16;
layout(constant_id=2) const uint tile_k=16;
layout(local_size_x_id=3) in;
layout(set=0, binding=0, std430) readonly buffer InputA { float16_t a[]; };
layout(set=0, binding=1, std430) readonly buffer InputB { float16_t b[]; };
layout(set=0, binding=2, std430) writeonly buffer OutputC { float c[]; };
const uint size = 256;
void main() {
    uint row=gl_WorkGroupID.y*tile_m, col=gl_WorkGroupID.x*tile_n;
    uint base=gl_WorkGroupID.z*size*size;
    coopmat<float16_t, gl_ScopeSubgroup, tile_m, tile_k, gl_MatrixUseA> ma;
    coopmat<float16_t, gl_ScopeSubgroup, tile_k, tile_n, gl_MatrixUseB> mb;
    coopmat<float, gl_ScopeSubgroup, tile_m, tile_n, gl_MatrixUseAccumulator> mc;
    mc = coopmat<float, gl_ScopeSubgroup, tile_m, tile_n, gl_MatrixUseAccumulator>(0.0);
    for (uint k=0; k<size; k+=tile_k) {
        coopMatLoad(ma, a, base + row*size+k, size, gl_CooperativeMatrixLayoutRowMajor);
        coopMatLoad(mb, b, base + k*size+col, size, gl_CooperativeMatrixLayoutRowMajor);
        mc = coopMatMulAdd(ma, mb, mc);
    }
    coopMatStore(mc, c, base+row*size+col, size, gl_CooperativeMatrixLayoutRowMajor);
}
