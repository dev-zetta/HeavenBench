# Only project sources enter the build. SDKs and pinned libraries are fetched
# inside Docker; local caches, originals, tooling and optional asset packs stay out.
**
!.dockerignore
!.clang-tidy
!.gitattributes
!.gitignore
!CMakeLists.txt
!LICENSE
!README.md
!CHANGELOG.md
!config.json
!.github/**
!android/**
!benchmark/**
!cmake/**
!docker/**
!docs/**
!packaging/**
!patches/**
!scripts/**
!tests/**
!tools/**
!lib/lz4/**
!lib/nlohmann/**
!lib/OpenSubdiv/**
**/.git
**/.gradle
**/.idea
**/.vs
**/.vscode
**/.codex
**/.agents
**/.kiro
**/.aws
**/AGENTS.md
**/__pycache__
**/.venv
**/.pytest_cache
**/*.py[cod]
**/build
**/build-*
**/*.[uU][nN][gG]
**/Unigine_Heaven-*
**/.Unigine_Heaven-*
**/.heaven-assets-*
**/imgui.ini
**/.DS_Store
**/Thumbs.db
**/*.iml
android/local.properties
