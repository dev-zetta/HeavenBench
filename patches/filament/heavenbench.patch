+/*
+ * Copyright (C) 2026 HeavenBench contributors
+ * Licensed under the Apache License, Version 2.0.
+ */
+#ifndef TNT_BACKEND_VULKAN_COMMAND_CONTEXT_H
+#define TNT_BACKEND_VULKAN_COMMAND_CONTEXT_H
+
+#include <bluevk/BlueVK.h>
+#include <backend/NativeCommand.h>
+#include <array>
+
+namespace filament::backend {
+
+struct VulkanCommandImage {
+    VkImage image = VK_NULL_HANDLE;
+    VkFormat format = VK_FORMAT_UNDEFINED;
+    VkExtent2D extent{};
+    VkImageLayout layout = VK_IMAGE_LAYOUT_GENERAL;
+    VkImageAspectFlags aspect = VK_IMAGE_ASPECT_COLOR_BIT;
+    VkImageView view = VK_NULL_HANDLE;
+    VkDeviceMemory memory = VK_NULL_HANDLE;
+    VkImageUsageFlags usage = 0;
+    VkImageLayout restoredLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+    uint32_t mipLevels = 1;
+    uint32_t arrayLayers = 1;
+};
+
+// Borrowed handles, valid only during NativeCommand::callback. Inputs are in
+// GENERAL with shader reads synchronized for compute. A callback may record
+// commands but must restore that layout and must never submit the shared queue.
+// Filament retains the input resources through completion of this submission.
+// Consumers tagging inputs for later presentation must use restoredLayout and
+// separately retain the owning Texture until their presentation work drains.
+struct VulkanCommandContext {
+    VkInstance instance = VK_NULL_HANDLE;
+    VkPhysicalDevice physicalDevice = VK_NULL_HANDLE;
+    VkDevice device = VK_NULL_HANDLE;
+    VkCommandBuffer commandBuffer = VK_NULL_HANDLE;
+    uint32_t queueFamily = UINT32_MAX;
+    std::array<VulkanCommandImage, NativeCommand::TEXTURE_COUNT> images{};
+    // SDK work is isolated in a secondary command buffer. Set this on any
+    // recording failure to discard every native command, including partial
+    // initialization/history writes. A successful history seed still commits.
+    bool* discard = nullptr;
+};
+
+} // namespace filament::backend
+#endif
