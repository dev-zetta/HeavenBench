diff --git a/libs/utils/include/utils/ProfilerTrace.h b/libs/utils/include/utils/ProfilerTrace.h
new file mode 100644
index 0000000000000000000000000000000000000000..036893dfa1d16a8ac30d2aa73978c8251a3e7a9e
--- /dev/null
+++ b/libs/utils/include/utils/ProfilerTrace.h
@@ -0,0 +1,149 @@
+/* Copyright (C) 2026 The Android Open Source Project
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy at http://www.apache.org/licenses/LICENSE-2.0
+ */
+#ifndef TNT_UTILS_PROFILERTRACE_H
+#define TNT_UTILS_PROFILERTRACE_H
+
+#include <utils/compiler.h>
+#include <stdint.h>
+
+namespace utils::profiling {
+
+struct Context {
+    uint64_t attempt_id = 0;
+    uint64_t submission_id = 0;
+    uint64_t filament_frame_id = 0;
+    uint64_t renderer_id = 0;
+    uint64_t view_id = 0;
+    uint64_t capture_id = 0;
+};
+
+enum class CpuEventKind : uint8_t { SCOPE, INSTANT, COUNTER, ASYNC_BEGIN, ASYNC_END, DROPPED };
+struct CpuEvent {
+    Context context;
+    uint64_t scope_id = 0;
+    uint64_t parent_id = 0;
+    uint64_t thread_id = 0;
+    int64_t begin_ns = 0;
+    int64_t end_ns = 0;
+    const char* category = nullptr;
+    const char* name = nullptr;
+    CpuEventKind kind = CpuEventKind::SCOPE;
+    int64_t value = 0;
+    uint64_t cookie = 0;
+};
+
+enum class GpuStatus : uint8_t { AVAILABLE, UNSUPPORTED, DISJOINT, ERROR, DROPPED, PENDING };
+enum class GpuBackend : uint8_t { UNKNOWN, VULKAN, OPENGL };
+struct GpuCapabilities {
+    GpuBackend backend = GpuBackend::UNKNOWN;
+    bool hardware_timestamps = false;
+    bool cpu_clock_calibrated = false;
+    uint8_t timestamp_valid_bits = 0;
+    double timestamp_period_ns = 0;
+    uint32_t max_passes_per_frame = 256;
+    uint32_t max_frames_in_flight = 16;
+    const char* reason = nullptr;
+    bool diagnostics_requested = false;
+    bool pipeline_statistics_supported = false;
+    bool pipeline_statistics_enabled = false;
+    bool executable_properties_supported = false;
+    bool executable_info_supported = false;
+    bool executable_info_enabled = false;
+    bool internal_representations_requested = false;
+    bool internal_representations_enabled = false;
+    const char* pipeline_statistics_reason = nullptr;
+    const char* executable_info_reason = nullptr;
+};
+
+// GPU times are relative to a hardware timestamp at this frame's beginning.
+// They never share the CPU steady-clock origin. Unavailable times stay -1.
+struct GpuSample {
+    Context context;
+    uint64_t pass_id = 0;
+    uint64_t parent_pass_id = 0;
+    const char* name = nullptr;
+    int64_t begin_ns = -1;
+    int64_t end_ns = -1;
+    GpuStatus status = GpuStatus::PENDING;
+    uint64_t command_count = 0;
+    uint64_t primitive_count = 0;
+    // Sum of RenderPass culler-visible input ranges executed in this FG pass.
+    // This is renderables (explicit groups count once), not instance placements.
+    uint64_t visible_renderables = 0;
+    bool name_truncated = false;
+    // Sum of the instance count of each executed draw. Repeated geometry,
+    // shadow passes and split primitives can invoke the same placement again.
+    uint64_t draw_instance_invocations = 0;
+    // Actual native draw commands grouped by the bound pipeline's fragment rate. These are not
+    // fragment shader invocations, shaded pixels, or a measurement of hardware rate clamping.
+    uint64_t native_draw_commands_full = 0;
+    uint64_t native_draw_commands_2x1 = 0;
+    uint64_t native_draw_commands_2x2 = 0;
+    // Independent of timestamp availability. False for a missing native adapter or dropped pass.
+    bool native_draw_commands_available = false;
+    // Actual hardware query counters, independent of timestamp availability. Counts describe
+    // the whole pass, including repeated shader work; they are never inferred from draw sizes.
+    GpuStatus pipeline_statistics_status = GpuStatus::UNSUPPORTED;
+    const char* pipeline_statistics_reason = "no native pipeline-statistics adapter is available";
+    uint64_t input_assembly_vertices = 0;
+    uint64_t input_assembly_primitives = 0;
+    uint64_t vertex_shader_invocations = 0;
+    uint64_t clipping_invocations = 0;
+    uint64_t clipping_primitives = 0;
+    uint64_t fragment_shader_invocations = 0;
+};
+
+enum class PipelineExecutableEventKind : uint8_t {
+    PIPELINE, STATISTIC, INTERNAL_REPRESENTATION, USE, LOSS
+};
+enum class PipelineStatisticFormat : uint8_t { BOOL32, INT64, UINT64, FLOAT64 };
+// Compilation statistics and IR are driver-reported compiler data, not runtime GPU counters.
+// IDs are monotonic within this diagnostic process, not reproducible across builds or sessions.
+// Names and text are borrowed only for the callback. Snapshot delivery occurs outside draw calls.
+struct PipelineExecutableEvent {
+    PipelineExecutableEventKind kind = PipelineExecutableEventKind::PIPELINE;
+    Context context;
+    uint64_t pipeline_id = 0;
+    uint64_t program_id = 0;
+    uint64_t pass_id = 0;
+    uint32_t executable_index = 0;
+    uint32_t stages = 0;
+    uint32_t subgroup_size = 0;
+    const char* program_name = nullptr;
+    const char* name = nullptr;
+    const char* description = nullptr;
+    const char* text = nullptr;
+    const char* reason = nullptr;
+    GpuStatus status = GpuStatus::UNSUPPORTED;
+    PipelineStatisticFormat format = PipelineStatisticFormat::UINT64;
+    bool bool_value = false;
+    int64_t signed_value = 0;
+    uint64_t unsigned_value = 0;
+    double float_value = 0;
+    uint64_t original_size = 0;
+    bool truncated = false;
+};
+
+struct Observer {
+    void* user = nullptr;
+    void (*cpu)(void*, CpuEvent const&) noexcept = nullptr;
+    void (*gpu)(void*, GpuSample const&) noexcept = nullptr;
+    void (*capabilities)(void*, GpuCapabilities const&) noexcept = nullptr;
+    void (*pipeline_executable)(void*, PipelineExecutableEvent const&) noexcept = nullptr;
+};
+
+// Install before capture; the observer and its user data must outlive every
+// worker/driver call. Callbacks run on their producer threads and must not block,
+// allocate, throw, or call a graphics API. Borrowed strings last only for the call.
+UTILS_PUBLIC void setObserver(Observer const* observer) noexcept;
+UTILS_PUBLIC void setEnabled(bool enabled) noexcept;
+UTILS_PUBLIC bool isEnabled() noexcept;
+UTILS_PUBLIC Context getContext() noexcept;
+UTILS_PUBLIC void setContext(Context context) noexcept;
+UTILS_PUBLIC uint64_t nextId() noexcept;
+
+} // namespace utils::profiling
+#endif
