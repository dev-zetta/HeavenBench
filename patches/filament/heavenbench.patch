+    void (*endFrame)(void*) noexcept;
+    void (*beginPass)(void*, Context, uint64_t, const char*) noexcept;
+    void (*endPass)(void*, uint64_t) noexcept;
+    void (*counters)(void*, uint64_t, uint64_t, uint64_t) noexcept;
+};
+UTILS_PUBLIC void setGpuAdapter(GpuAdapter const* adapter) noexcept;
+UTILS_PUBLIC void gpuBeginFrame(Context context) noexcept;
+UTILS_PUBLIC void gpuEndFrame() noexcept;
+UTILS_PUBLIC void gpuBeginPass(Context context, uint64_t id, const char* name) noexcept;
+UTILS_PUBLIC void gpuEndPass(uint64_t id) noexcept;
+UTILS_PUBLIC void gpuCounters(uint64_t commands, uint64_t primitives, uint64_t visible) noexcept;
+UTILS_PUBLIC uint64_t getGpuPassId() noexcept;
