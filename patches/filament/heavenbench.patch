+#ifndef TNT_BACKEND_GPU_PROFILER_H
+#define TNT_BACKEND_GPU_PROFILER_H
+
+#include <private/utils/ProfilerTrace.h>
+#include <backend/DriverEnums.h>
+#include <array>
+#include <cmath>
+#include <cstring>
+#include <limits>
