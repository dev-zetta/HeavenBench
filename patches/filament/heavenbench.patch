+// CDF of the tangent disk X coordinate under UNIFORM SOLID ANGLE on
+// the sun cap. This stable expression tends to the disk-area CDF as c→1.
+highp float contactSunCapCdf(highp float x, highp float c) {
+    x = clamp(x, -1.0, 1.0);
+    highp float side = sqrt(max(1.0 - x*x, 0.0));
+    highp float d = 1.0 - c;
+    highp float a = x * side / (c * side*side + x*x);
+    highp float correction = d > 0.0 ? atan(d * a) / d : x * side;
+    return saturate(0.5 + (asin(x) + correction) / PI);
+}
+
+highp float contactSunInverseCapCdf(highp float target, highp float lower,
+        highp float c) {
+    highp float upper = 1.0;
+    for (int i = 0; i < 12; ++i) {
+        highp float middle = 0.5 * (lower + upper);
+        if (contactSunCapCdf(middle, c) < target) {
+            lower = middle;
+        } else {
+            upper = middle;
+        }
+    }
+    highp float x = 0.5 * (lower + upper);
+    highp float side = sqrt(max(1.0 - x*x, 0.0));
+    highp float density = (1.0 + c) * c * side /
+            (PI * (c*c + (1.0 - c*c) * x*x));
+    if (density > 0.0) {
+        // One Newton correction remains inside the conditional bracket.
+        x = clamp(x - (contactSunCapCdf(x, c) - target) / density, lower, upper);
+    }
+    return x;
+}
