+// Executes the retained compiler-metadata collector with a controlled Vulkan driver ABI.
+// This is not a reimplementation of its enumeration/storage policy and needs no GPU/device.
+#include "vulkan/VulkanPipelineDiagnostics.h"
+#include <array>
+#include <cstdio>
+#include <cstring>
+#include <memory>
+#include <stdexcept>
+#include <string_view>
+
+namespace p = utils::profiling;
+using filament::backend::VulkanPipelineDiagnostics;
+namespace {
+enum class Mode {
+    Normal, NoProcedures, EmptyExecutables, ExecutableOverflow, ExecutableMutation,
+    StatisticOverflow, StatisticMutation, RepresentationOverflow, RepresentationMutation,
+    OversizedText, ChangingText
+};
+Mode mode = Mode::Normal;
+std::uint32_t dataReads = 0;
+void require(bool value, char const* reason) {
+    if (!value) throw std::runtime_error(reason);
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL properties(VkDevice, VkPipelineInfoKHR const*,
+        std::uint32_t* count, VkPipelineExecutablePropertiesKHR* output) {
+    if (!output) {
+        *count = mode == Mode::EmptyExecutables ? 0 : mode == Mode::ExecutableOverflow ? 9 : 1;
+        return VK_SUCCESS;
+    }
+    if (mode == Mode::ExecutableMutation) { *count = 9; return VK_INCOMPLETE; }
+    require(*count >= 1 && output[0].sType == VK_STRUCTURE_TYPE_PIPELINE_EXECUTABLE_PROPERTIES_KHR,
+            "collector supplied malformed executable output");
+    *count = 1;
+    output[0].stages = VK_SHADER_STAGE_FRAGMENT_BIT;
+    output[0].subgroupSize = 16;
+    std::strcpy(output[0].name, "controlled fragment executable");
+    std::strcpy(output[0].description, "independent driver ABI fixture");
+    return VK_SUCCESS;
+}
+VKAPI_ATTR VkResult VKAPI_CALL statistics(VkDevice, VkPipelineExecutableInfoKHR const*,
+        std::uint32_t* count, VkPipelineExecutableStatisticKHR* output) {
+    if (!output) { *count = mode == Mode::StatisticOverflow ? 65 : 4; return VK_SUCCESS; }
+    if (mode == Mode::StatisticMutation) { *count = 65; return VK_INCOMPLETE; }
+    require(*count >= 4, "collector did not preserve statistic capacity");
+    *count = 4;
+    constexpr std::array formats = {
+        VK_PIPELINE_EXECUTABLE_STATISTIC_FORMAT_BOOL32_KHR,
+        VK_PIPELINE_EXECUTABLE_STATISTIC_FORMAT_INT64_KHR,
+        VK_PIPELINE_EXECUTABLE_STATISTIC_FORMAT_UINT64_KHR,
+        VK_PIPELINE_EXECUTABLE_STATISTIC_FORMAT_FLOAT64_KHR};
+    constexpr std::array names = {"boolean", "signed", "unsigned", "floating"};
+    for (std::size_t i = 0; i < formats.size(); ++i) {
+        require(output[i].sType == VK_STRUCTURE_TYPE_PIPELINE_EXECUTABLE_STATISTIC_KHR,
+                "collector omitted statistic sType");
+        output[i].format = formats[i];
+        std::strcpy(output[i].name, names[i]);
+        std::strcpy(output[i].description, "compile-time driver value, not runtime work");
+    }
+    output[0].value.b32 = VK_TRUE;
+    output[1].value.i64 = -17;
+    output[2].value.u64 = UINT64_C(9007199254740993);
+    output[3].value.f64 = .125;
+    return VK_SUCCESS;
+}
+VKAPI_ATTR VkResult VKAPI_CALL representations(VkDevice, VkPipelineExecutableInfoKHR const*,
+        std::uint32_t* count, VkPipelineExecutableInternalRepresentationKHR* output) {
+    if (!output) { *count = mode == Mode::RepresentationOverflow ? 9 : 2; return VK_SUCCESS; }
+    if (mode == Mode::RepresentationMutation) { *count = 9; return VK_INCOMPLETE; }
+    require(*count >= 2, "collector did not preserve IR capacity");
+    *count = 2;
+    for (unsigned i = 0; i < 2; ++i) {
+        require(output[i].sType == VK_STRUCTURE_TYPE_PIPELINE_EXECUTABLE_INTERNAL_REPRESENTATION_KHR,
+                "collector omitted IR sType");
+        auto& value = output[i];
+        std::strcpy(value.name, i == 0 ? "assembly text" : "binary IR");
+        std::strcpy(value.description, "controlled optional driver representation");
+        value.isText = i == 0 ? VK_TRUE : VK_FALSE;
+        size_t const requested = i == 0 ? (mode == Mode::OversizedText ? 65537u : 6144u) : 8u;
+        if (value.pData) {
+            ++dataReads;
+            if (mode == Mode::ChangingText) { value.dataSize = 8192; return VK_INCOMPLETE; }
+            require(i == 0 && value.dataSize >= requested,
+                    "collector tried binary or insufficient IR data retrieval");
+            std::memset(value.pData, 'I', requested);
+            static_cast<char*>(value.pData)[requested - 1] = 0;
+        }
+        value.dataSize = requested;
+    }
+    return VK_SUCCESS;
+}
+VKAPI_ATTR PFN_vkVoidFunction VKAPI_CALL procedure(VkDevice, char const* name) {
+    if (mode == Mode::NoProcedures) return nullptr;
+    if (std::string_view(name) == "vkGetPipelineExecutablePropertiesKHR") {
+        return reinterpret_cast<PFN_vkVoidFunction>(properties);
+    }
+    if (std::string_view(name) == "vkGetPipelineExecutableStatisticsKHR") {
+        return reinterpret_cast<PFN_vkVoidFunction>(statistics);
+    }
+    if (std::string_view(name) == "vkGetPipelineExecutableInternalRepresentationsKHR") {
+        return reinterpret_cast<PFN_vkVoidFunction>(representations);
+    }
+    return nullptr;
+}
+struct Records {
+    struct Item {
+        p::PipelineExecutableEvent event{};
+        std::array<char, 256> name{}, reason{};
+        std::array<char, 4097> text{};
+    };
+    std::array<Item, 128> items{};
+    std::size_t count = 0;
+    std::uint64_t lost = 0;
+    std::uint64_t metadataLoss = 0, irLoss = 0;
+    std::size_t headers = 0, statistics = 0;
+    p::Observer observer{};
+    Records() {
+        observer.user = this;
+        observer.pipeline_executable = [](void* user, p::PipelineExecutableEvent const& event) noexcept {
+            auto& self = *static_cast<Records*>(user);
+            if (event.kind == p::PipelineExecutableEventKind::LOSS) {
+                self.lost += event.unsigned_value ? event.unsigned_value : 1;
+                if (event.reason && std::strstr(event.reason, "compiler metadata cache")) {
+                    self.metadataLoss += event.unsigned_value;
+                }
+                if (event.reason && std::strstr(event.reason, "optional compiler IR cache")) {
+                    self.irLoss += event.unsigned_value;
+                }
+            }
+            if (event.kind == p::PipelineExecutableEventKind::PIPELINE) ++self.headers;
+            if (event.kind == p::PipelineExecutableEventKind::STATISTIC) ++self.statistics;
+            if (self.count < self.items.size()) {
+                auto& item = self.items[self.count];
+                item.event = event;
+                if (event.name) std::strncpy(item.name.data(), event.name, item.name.size() - 1);
+                if (event.reason) std::strncpy(item.reason.data(), event.reason, item.reason.size() - 1);
+                if (event.text) std::strncpy(item.text.data(), event.text, item.text.size() - 1);
+            }
+            ++self.count;
+        };
+    }
+    void clear() { count = 0; lost = metadataLoss = irLoss = 0; headers = statistics = 0; }
+};
+p::Context epoch(std::uint64_t id) { p::Context result{}; result.capture_id = id; return result; }
+void normal(Records& records) {
+    mode = Mode::Normal; dataReads = 0; records.clear();
+    VulkanPipelineDiagnostics collector(VK_NULL_HANDLE, true);
+    auto const id = collector.capture(VK_NULL_HANDLE, 77, "material fixture; variant=3");
+    collector.poll(nullptr);
+    require(records.count == 0, "compiler collection incorrectly depends on a live recording callback");
+    auto context = epoch(51); collector.poll(&context);
+    require(records.count == 7 && dataReads == 1, "bounded scalar/text/binary events missing");
+    require(records.items[0].event.pipeline_id == id && records.items[0].event.program_id == 77 &&
+            records.items[0].event.context.capture_id == 51 &&
+            records.items[0].event.subgroup_size == 16, "compiler metadata lost identity or epoch");
+    require(records.items[1].event.format == p::PipelineStatisticFormat::BOOL32 &&
+            records.items[1].event.bool_value &&
+            records.items[2].event.format == p::PipelineStatisticFormat::INT64 &&
+            records.items[2].event.signed_value == -17 &&
+            records.items[3].event.format == p::PipelineStatisticFormat::UINT64 &&
+            records.items[3].event.unsigned_value == UINT64_C(9007199254740993) &&
+            records.items[4].event.format == p::PipelineStatisticFormat::FLOAT64 &&
+            records.items[4].event.float_value == .125, "driver scalar formats lost native precision/sign");
+    require(records.items[5].event.kind == p::PipelineExecutableEventKind::INTERNAL_REPRESENTATION &&
+            records.items[5].event.original_size == 6144 && records.items[5].event.truncated &&
+            std::strlen(records.items[5].text.data()) == 4096 &&
+            records.items[6].event.status == p::GpuStatus::UNSUPPORTED &&
+            records.items[6].text[0] == 0, "IR snippet bound or binary exclusion failed");
+    collector.poll(nullptr);
+    require(records.count == 7, "compiler replay repeats without a capture request");
+    records.clear(); context = epoch(52); collector.poll(&context);
+    require(records.count == 7 && records.items[0].event.context.capture_id == 52 &&
+            records.items[0].event.pipeline_id == id && dataReads == 1,
+            "new capture does not replay retained metadata independently of driver lifetime");
+}
+void failureModes(Records& records) {
+    for (Mode test : {Mode::NoProcedures, Mode::EmptyExecutables, Mode::ExecutableOverflow,
+            Mode::ExecutableMutation, Mode::StatisticOverflow, Mode::StatisticMutation,
+            Mode::RepresentationOverflow, Mode::RepresentationMutation}) {
+        mode = test; dataReads = 0; records.clear();
+        VulkanPipelineDiagnostics collector(VK_NULL_HANDLE, true);
+        collector.capture(VK_NULL_HANDLE, 1, "failure mode");
+        auto context = epoch(1); collector.poll(&context);
+        require(records.lost > 0 && dataReads == 0, "failed/mutating enumeration did not disclose loss");
+    }
+    for (Mode test : {Mode::OversizedText, Mode::ChangingText}) {
+        mode = test; dataReads = 0; records.clear();
+        VulkanPipelineDiagnostics collector(VK_NULL_HANDLE, true);
+        collector.capture(VK_NULL_HANDLE, 1, "bounded text");
+        auto context = epoch(1); collector.poll(&context);
+        require(records.count == 7 && records.items[5].text[0] == 0 &&
+                records.items[5].event.status != p::GpuStatus::AVAILABLE &&
+                (test != Mode::OversizedText || (records.items[5].event.original_size == 65537 &&
+                    records.items[5].event.truncated && dataReads == 0)),
+                "oversized/changing driver IR was copied or silently accepted");
+    }
+    mode = Mode::Normal; dataReads = 0; records.clear();
+    VulkanPipelineDiagnostics noText(VK_NULL_HANDLE, false);
+    noText.capture(VK_NULL_HANDLE, 1, "statistics only");
+    auto context = epoch(1); noText.poll(&context);
+    require(records.count == 5 && dataReads == 0, "opt-out unexpectedly queried optional IR");
+}
+void bounds(Records& records) {
+    mode = Mode::Normal; records.clear();
+    VulkanPipelineDiagnostics collector(VK_NULL_HANDLE, false);
+    std::uint64_t previousId = 0;
+    for (unsigned i = 0; i < 513; ++i) {
+        auto const id = collector.capture(VK_NULL_HANDLE, i + 1, "cache bound");
+        require(id > previousId, "actual pipeline creations reused an opaque diagnostic identity");
+        previousId = id;
+    }
+    auto context = epoch(1); collector.poll(&context);
+    require(records.count == 513 * 5 && records.headers == 513 && records.statistics == 513 * 4 &&
+            records.lost == 0, "more than 512 actual pipelines lost mandatory compiler metadata");
+    std::size_t const previous = records.count; collector.poll(nullptr);
+    require(records.count == previous, "loss delta re-emitted without a new loss");
+    mode = Mode::NoProcedures; records.clear();
+    VulkanPipelineDiagnostics ceiling(VK_NULL_HANDLE, false);
+    for (unsigned i = 0; i < 4097; ++i) ceiling.capture(VK_NULL_HANDLE, i + 1, "pipeline ceiling");
+    ceiling.poll(&context);
+    require(records.count == 4097 && records.metadataLoss == 1,
+            "4096-pipeline hard ceiling omitted explicit overflow disclosure");
+}
+void optionalTextPriority(Records& records) {
+    mode = Mode::Normal; records.clear(); dataReads = 0;
+    VulkanPipelineDiagnostics collector(VK_NULL_HANDLE, true);
+    for (unsigned i = 0; i < 1024; ++i) collector.capture(VK_NULL_HANDLE, i + 1, "protected metadata");
+    auto context = epoch(10); collector.poll(&context);
+    require(records.headers == 1024 && records.statistics == 4096 && records.metadataLoss == 0 &&
+            records.irLoss > 0 && dataReads < 1024,
+            "optional IR exhaustion erased headers/statistics or kept retrieving unretainable text");
+    records.clear(); context = epoch(11); collector.poll(&context);
+    require(records.headers == 1024 && records.statistics == 4096 && records.metadataLoss == 0 &&
+            records.irLoss > 0, "new-epoch replay lost mandatory metadata after optional-text exhaustion");
+}
+} // namespace
+
+int main() {
+    auto previous = bluevk::vkGetDeviceProcAddr;
+    try {
+        bluevk::vkGetDeviceProcAddr = procedure;
+        auto records = std::make_unique<Records>();
+        p::setObserver(&records->observer);
+        normal(*records); failureModes(*records); bounds(*records); optionalTextPriority(*records);
+        p::setObserver(nullptr);
+        bluevk::vkGetDeviceProcAddr = previous;
+        std::puts("Vulkan compiler diagnostics contracts: PASS");
+        return 0;
+    } catch (std::exception const& error) {
+        p::setObserver(nullptr);
+        bluevk::vkGetDeviceProcAddr = previous;
+        std::fprintf(stderr, "Vulkan compiler diagnostics contracts: FAIL: %s\n", error.what());
+        return 1;
+    }
+}
diff --git a/filament/backend/test/test_VulkanPipelineLifetime.cpp b/filament/backend/test/test_VulkanPipelineLifetime.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..188a6a36a43451da59a1bc3cdb658eff7b29402f
--- /dev/null
+++ b/filament/backend/test/test_VulkanPipelineLifetime.cpp
@@ -0,0 +1,109 @@
+/*
+ * Copyright (C) 2026 The Android Open Source Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+// Standalone production-policy fixture. No Vulkan loader or graphics device is needed.
+#include "vulkan/VulkanPipelineLifetime.h"
+
+#include <cstdio>
+#include <memory>
+#include <stdexcept>
+
+namespace {
+
+enum class Status { RECORDING, PENDING, COMPLETED, ERROR };
+struct Fence { Status status = Status::RECORDING; };
+using Lifetime = filament::backend::VulkanPipelineLifetime<Fence>;
+constexpr uint64_t MAXIMUM_AGE = 45;
+
+bool completed(Fence const& fence) { return fence.status == Status::COMPLETED; }
+void require(bool condition, char const* message) {
+    if (!condition) throw std::runtime_error(message);
+}
+
+void stalledSubmission() {
+    Lifetime lifetime;
+    auto fence = std::make_shared<Fence>();
+    lifetime.used(2, false, fence);
+    for (uint64_t time = 3; time < 1000; ++time) {
+        require(!lifetime.canEvict(time, MAXIMUM_AGE, completed),
+                "GC ticks must not retire a still-recording command buffer's pipeline");
+    }
+    fence->status = Status::PENDING;
+    require(!lifetime.canEvict(1000, MAXIMUM_AGE, completed),
+            "Expired age must not retire a pending GPU submission");
+    fence->status = Status::ERROR;
+    require(!lifetime.canEvict(1001, MAXIMUM_AGE, completed),
+            "An unavailable / failed completion is not successful retirement");
+    fence->status = Status::COMPLETED;
+    require(lifetime.canEvict(1002, MAXIMUM_AGE, completed),
+            "An old completed entry must remain evictable");
+}
+
+void sameQueueAndRepeatedBind() {
+    Lifetime lifetime;
+    auto first = std::make_shared<Fence>();
+    first->status = Status::COMPLETED;
+    lifetime.used(1, false, first);
+    auto latest = std::make_shared<Fence>();
+    lifetime.used(100, false, latest);
+    require(!lifetime.canEvict(1000, MAXIMUM_AGE, completed),
+            "Later use on the same queue must supersede a completed older fence");
+    // The equal-static-key bind path uses this same operation, so it renews age and fence credit.
+    lifetime.used(1001, false, latest);
+    latest->status = Status::COMPLETED;
+    require(!lifetime.canEvict(1046, MAXIMUM_AGE, completed),
+            "A repeated pipeline bind must renew the cache age, including its boundary");
+    require(lifetime.canEvict(1047, MAXIMUM_AGE, completed),
+            "Completion must preserve the ordinary age-based reuse policy");
+}
+
+void independentQueuesAndFenceRelease() {
+    Lifetime lifetime;
+    auto ordinary = std::make_shared<Fence>();
+    ordinary->status = Status::COMPLETED;
+    auto protectedUse = std::make_shared<Fence>();
+    protectedUse->status = Status::PENDING;
+    std::weak_ptr<Fence> ordinaryWeak = ordinary;
+    lifetime.used(1, false, ordinary);
+    lifetime.used(2, true, protectedUse);
+    ordinary.reset();
+    require(!lifetime.canEvict(3, MAXIMUM_AGE, completed), "Young entries are retained");
+    require(ordinaryWeak.expired(),
+            "Completed native fences must be released even before pipeline age expires");
+    require(!lifetime.canEvict(1000, MAXIMUM_AGE, completed),
+            "Ordinary queue completion must not retire protected queue use");
+    protectedUse->status = Status::COMPLETED;
+    std::weak_ptr<Fence> protectedWeak = protectedUse;
+    protectedUse.reset();
+    require(lifetime.canEvict(1001, MAXIMUM_AGE, completed),
+            "Both queues complete permits old entry retirement");
+    require(protectedWeak.expired(), "Completion must release the final fence holder");
+}
+
+} // namespace
+
+int main() {
+    try {
+        stalledSubmission();
+        sameQueueAndRepeatedBind();
+        independentQueuesAndFenceRelease();
+        std::puts("Vulkan pipeline lifetime policy: PASS (recording, pending, errors, repeated binds, both queues, fence recycling)");
+        return 0;
+    } catch (std::exception const& error) {
+        std::fprintf(stderr, "Vulkan pipeline lifetime policy: FAIL: %s\n", error.what());
+        return 1;
+    }
+}
