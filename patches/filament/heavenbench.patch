new file mode 100644
index 0000000000000000000000000000000000000000..2d9a21823dbea3fe8aae8e6668a9d50f80537e4f
--- /dev/null
+++ b/filament/backend/src/opengl/OpenGLGpuProfiler.h
@@ -0,0 +1,81 @@
+/* Copyright (C) 2026 The Android Open Source Project
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may obtain a copy at http://www.apache.org/licenses/LICENSE-2.0
+ */
+#ifndef TNT_OPENGL_GPU_PROFILER_H
+#define TNT_OPENGL_GPU_PROFILER_H
+#include "GpuProfiler.h"
+#include "OpenGLContext.h"
+
+namespace filament::backend {
+class OpenGLGpuProfiler final : public GpuProfiler {
+public:
+    explicit OpenGLGpuProfiler(OpenGLContext& context)
+        : GpuProfiler(capabilities(context)), mContext(context) {}
+    ~OpenGLGpuProfiler() override;
+private:
+    static constexpr GLenum TIMESTAMP = 0x8E28;
+    static constexpr GLenum COUNTER_BITS = 0x8864;
+    static constexpr GLenum GPU_DISJOINT = 0x8FBB;
+    OpenGLContext& mContext;
+    std::array<GLuint, QUERY_COUNT> mQueries{};
+    std::array<uint32_t, FRAME_COUNT> mLastQuery{};
+    static Caps capabilities(OpenGLContext& context) noexcept {
+        Caps caps{};
+        caps.backend = utils::profiling::GpuBackend::OPENGL;
+        caps.pipeline_statistics_reason = "pipeline-statistics diagnostics are not implemented for OpenGL/GLES";
+        caps.executable_info_reason = "Vulkan pipeline executable information is unavailable on OpenGL/GLES";
+        caps.timestamp_period_ns = 1;
+        auto const& p = context.procs;
+        bool const supported = context.ext.EXT_disjoint_timer_query &&
+                !context.bugs.dont_use_timer_query && p.genQueries && p.deleteQueries &&
+                p.queryCounter && p.getQueryiv && p.getQueryObjectuiv && p.getQueryObjectui64v;
+        GLint bits = 0;
+        if (supported) p.getQueryiv(TIMESTAMP, COUNTER_BITS, &bits);
+        caps.timestamp_valid_bits = bits > 0 && bits <= 64 ? uint8_t(bits) : 0;
+        caps.hardware_timestamps = caps.timestamp_valid_bits > 0;
+        caps.reason = caps.hardware_timestamps ? "hardware timestamps; frame-relative clock" :
+                context.bugs.dont_use_timer_query ? "timer queries disabled by driver workaround" :
+                "timestamp queryCounter unavailable or counter bits are zero";
+        return caps;
+    }
+    bool initialize() noexcept override {
+        mContext.procs.genQueries(QUERY_COUNT, mQueries.data());
+        if (!mQueries[0] || !mQueries.back()) {
+            mCaps.reason = "dedicated timestamp query allocation failed";
+            return false;
+        }
+        return true;
+    }
+    void reset(uint32_t) noexcept override {}
+    void write(uint32_t index) noexcept override {
+        mContext.procs.queryCounter(mQueries[index], TIMESTAMP);
+        mLastQuery[index / QUERIES_PER_FRAME] = index;
+    }
+    QueryStatus read(uint32_t index, uint64_t& ticks) noexcept override {
+        GLuint available = GL_FALSE;
+        mContext.procs.getQueryObjectuiv(mQueries[index], GL_QUERY_RESULT_AVAILABLE, &available);
+        if (!available) return QueryStatus::PENDING;
+        GLuint64 result = 0;
+        mContext.procs.getQueryObjectui64v(mQueries[index], GL_QUERY_RESULT, &result);
+        ticks = uint64_t(result);
+        return QueryStatus::AVAILABLE;
+    }
+    bool ready(uint32_t slot) noexcept override {
+        uint64_t ignored = 0;
+        return read(mLastQuery[slot], ignored) == QueryStatus::AVAILABLE;
+    }
+    void close(uint32_t) noexcept override {}
+    QueryStatus validity() noexcept override {
+#if defined(BACKEND_OPENGL_VERSION_GLES) && defined(GL_EXT_disjoint_timer_query)
+        if (mCaps.hardware_timestamps) {
+            GLint disjoint = 0;
+            glGetIntegerv(GPU_DISJOINT, &disjoint);
+            if (disjoint) return QueryStatus::DISJOINT;
+        }
+#endif
+        return QueryStatus::AVAILABLE;
+    }
+};
+} // namespace filament::backend
+#endif
