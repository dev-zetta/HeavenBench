+namespace filament::backend::fvkutils {
+
+// Only this exact driver / hardware identity has reproduced the CCS corruption and
+// passed the alias-compatible image allocation controls. Unknown identities retain
+// their existing allocation policy, including when driver properties are unavailable.
+inline bool requiresIntelMesaColorImageAliasWorkaround(bool driverPropertiesSupported,
+        VkPhysicalDeviceProperties const& device,
+        VkPhysicalDeviceDriverProperties const& driver) noexcept {
+    return driverPropertiesSupported &&
+           driver.driverID == VK_DRIVER_ID_INTEL_OPEN_SOURCE_MESA &&
+           device.vendorID == 0x8086u && device.deviceID == 0xe223u &&
+           device.driverVersion == VK_MAKE_VERSION(26, 0, 8);
+}
