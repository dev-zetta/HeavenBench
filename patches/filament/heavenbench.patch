+// Native adapters own dedicated query storage. This bounded owner-thread state
+// machine never waits for a GPU result or reuses an in-flight query interval.
+class GpuProfiler {
+public:
+    static constexpr uint32_t PASS_COUNT = 256;
+    static constexpr uint32_t FRAME_COUNT = 16;
+    static constexpr uint32_t QUERIES_PER_FRAME = 1 + PASS_COUNT * 2;
+    static constexpr uint32_t QUERY_COUNT = FRAME_COUNT * QUERIES_PER_FRAME;
+    using Context = utils::profiling::Context;
+    using Sample = utils::profiling::GpuSample;
+    using QueryStatus = utils::profiling::GpuStatus;
+    using Caps = utils::profiling::GpuCapabilities;
+
+    explicit GpuProfiler(Caps caps) noexcept : mCaps(caps), mAdapter{
+            this,
+            [](void* p, Context c) noexcept { static_cast<GpuProfiler*>(p)->beginFrame(c); },
+            [](void* p) noexcept { static_cast<GpuProfiler*>(p)->endFrame(); },
+            [](void* p, Context c, uint64_t id, const char* n) noexcept {
+                static_cast<GpuProfiler*>(p)->beginPass(c, id, n); },
+            [](void* p, uint64_t id) noexcept { static_cast<GpuProfiler*>(p)->endPass(id); },
+            [](void* p, uint64_t c, uint64_t t, uint64_t v) noexcept {
+                static_cast<GpuProfiler*>(p)->counters(c, t, v); }} {}
+    virtual ~GpuProfiler();
+
+    static uint64_t primitiveCount(PrimitiveType type, uint32_t count, uint32_t instances) noexcept {
+        uint64_t primitives = 0;
+        switch (type) {
+            case PrimitiveType::POINTS: primitives = count; break;
+            case PrimitiveType::LINES: primitives = count / 2; break;
+            case PrimitiveType::LINE_STRIP: primitives = count > 1 ? count - 1 : 0; break;
+            case PrimitiveType::TRIANGLES: primitives = count / 3; break;
+            case PrimitiveType::TRIANGLE_STRIP: primitives = count > 2 ? count - 2 : 0; break;
+        }
+        return primitives * instances;
+    }
+    void recordPrimitives(PrimitiveType type, uint32_t count, uint32_t instances) noexcept {
+        counters(0, primitiveCount(type, count, instances), 0, instances);
+    }
+    void install() noexcept { utils::profiling::setGpuAdapter(&mAdapter); }
+    void uninstall() noexcept { utils::profiling::setGpuAdapter(nullptr); }
+    void poll() noexcept {
+        QueryStatus const state = validity();
+        for (uint32_t slot = 0; slot < FRAME_COUNT; ++slot) {
+            auto& frame = mFrames[slot];
+            if (!frame.busy) continue;
+            if (state != QueryStatus::AVAILABLE) frame.validity = state;
+            if (!frame.closed || !ready(slot)) continue;
+            // Even invalid/disjoint intervals keep their query storage until the GPU
+            // has completed it. A disjoint notification is not a completion fence.
+            if (frame.validity != QueryStatus::AVAILABLE) { retire(frame, frame.validity); continue; }
+            uint64_t origin = 0;
+            QueryStatus result = read(slot * QUERIES_PER_FRAME, origin);
+            if (result == QueryStatus::PENDING) continue;
+            if (result != QueryStatus::AVAILABLE) { retire(frame, result); continue; }
+            bool pending = false;
+            for (uint32_t i = 0; i < frame.count; ++i) {
+                auto& pass = frame.passes[i];
+                if (pass.retired) continue;
+                uint64_t start = 0, stop = 0;
+                result = pass.ended ? read(slot * QUERIES_PER_FRAME + 1 + i * 2, start) :
+                        QueryStatus::ERROR;
+                if (result == QueryStatus::AVAILABLE) {
+                    result = read(slot * QUERIES_PER_FRAME + 2 + i * 2, stop);
+                }
+                if (result == QueryStatus::PENDING) { pending = true; continue; }
+                if (result == QueryStatus::AVAILABLE &&
+                        (!relative(origin, start, pass.sample.begin_ns) ||
+                         !relative(origin, stop, pass.sample.end_ns) ||
+                         pass.sample.end_ns < pass.sample.begin_ns)) result = QueryStatus::ERROR;
+                emit(pass, result);
+            }
+            if (!pending) frame.busy = false;
+        }
+    }
+    void terminate() noexcept {
+        poll();
+        for (auto& frame : mFrames) if (frame.busy) retire(frame, QueryStatus::ERROR);
+        mCurrent = nullptr;
+        uninstall();
+    }
+
+protected:
+    virtual bool initialize() noexcept = 0;
+    virtual void reset(uint32_t slot) noexcept = 0;
+    virtual void write(uint32_t index) noexcept = 0;
+    virtual QueryStatus read(uint32_t index, uint64_t& ticks) noexcept = 0;
+    virtual bool ready(uint32_t slot) noexcept = 0;
+    virtual void close(uint32_t slot) noexcept = 0;
+    virtual QueryStatus validity() noexcept { return QueryStatus::AVAILABLE; }
+    Caps mCaps;
+
+private:
+    struct Pass {
+        Sample sample{};
+        std::array<char, 96> name{};
+        bool ended = false;
+        bool retired = false;
+    };
+    struct Frame {
+        Context context{};
+        std::array<Pass, PASS_COUNT> passes{};
+        uint32_t count = 0;
+        bool busy = false;
+        bool closed = false;
+        QueryStatus validity = QueryStatus::AVAILABLE;
+    };
+    std::array<Frame, FRAME_COUNT> mFrames{};
+    utils::profiling::GpuAdapter mAdapter;
+    Frame* mCurrent = nullptr;
+    uint32_t mCurrentSlot = 0;
+    int32_t mActivePass = -1;
+    uint64_t mCapsCapture = std::numeric_limits<uint64_t>::max();
+    bool mInitialized = false;
+    bool mInitializeAttempted = false;
+
+    bool relative(uint64_t origin, uint64_t ticks, int64_t& ns) const noexcept {
+        uint64_t const mask = mCaps.timestamp_valid_bits == 64 ? ~uint64_t(0) :
+                ((uint64_t(1) << mCaps.timestamp_valid_bits) - 1);
+        uint64_t const delta = (ticks - origin) & mask;
+        // More than half a counter revolution cannot be ordered unambiguously.
+        if (delta > (mask >> 1)) return false;
+        double const value = double(delta) * mCaps.timestamp_period_ns;
+        if (!std::isfinite(value) || value < 0 || value >= double(INT64_MAX)) return false;
+        ns = int64_t(value);
+        return true;
+    }
+    static void emit(Pass& pass, QueryStatus status) noexcept {
+        pass.sample.name = pass.name.data();
+        pass.sample.status = status;
+        if (status != QueryStatus::AVAILABLE) pass.sample.begin_ns = pass.sample.end_ns = -1;
+        utils::profiling::emitGpu(pass.sample);
+        pass.retired = status != QueryStatus::PENDING;
+    }
+    static void retire(Frame& frame, QueryStatus status) noexcept {
+        for (uint32_t i = 0; i < frame.count; ++i) {
+            if (!frame.passes[i].retired) emit(frame.passes[i], status);
+        }
+        frame.busy = false;
+    }
+    void beginFrame(Context context) noexcept {
+        poll();
+        if (mCurrent) endFrame();
+        mCurrent = nullptr;
+        mActivePass = -1;
+        // This command was accepted on the submitting thread. A capture can
+        // stop before its queued commands reach the driver; keep that identity.
+        if (!mInitializeAttempted) {
+            mInitializeAttempted = true;
+            mInitialized = mCaps.hardware_timestamps && initialize();
+            if (!mInitialized) mCaps.hardware_timestamps = false;
+        }
+        if (mCapsCapture != context.capture_id) {
+            utils::profiling::emitCapabilities(mCaps);
+            mCapsCapture = context.capture_id;
+        }
+        for (uint32_t slot = 0; slot < FRAME_COUNT; ++slot) {
+            if (mFrames[slot].busy) continue;
+            auto& frame = mFrames[slot];
+            frame.context = context;
+            frame.count = 0;
+            frame.busy = true;
+            frame.closed = false;
+            frame.validity = QueryStatus::AVAILABLE;
+            mCurrent = &frame;
+            mCurrentSlot = slot;
+            if (mInitialized) { reset(slot); write(slot * QUERIES_PER_FRAME); }
+            return;
+        }
+    }
+    void endFrame() noexcept {
+        if (!mCurrent) return;
+        auto& frame = *mCurrent;
+        frame.closed = true;
+        if (mInitialized) close(mCurrentSlot);
+        for (uint32_t i = 0; i < frame.count; ++i) {
+            emit(frame.passes[i], mInitialized ? QueryStatus::PENDING : QueryStatus::UNSUPPORTED);
+        }
+        if (!mInitialized) frame.busy = false;
+        mCurrent = nullptr;
+        mActivePass = -1;
+    }
+    void beginPass(Context context, uint64_t id, const char* name) noexcept {
+        if (!mCurrent || mCurrent->count == PASS_COUNT) {
+            utils::profiling::emitGpu(Sample{.context = context, .pass_id = id, .name = name,
+                    .status = QueryStatus::DROPPED});
+            mActivePass = -1;
+            return;
+        }
+        uint32_t const index = mCurrent->count++;
+        auto& pass = mCurrent->passes[index];
+        pass.sample = Sample{.context = context, .pass_id = id};
+        pass.ended = pass.retired = false;
+        size_t const length = name ? std::strlen(name) : 0;
+        size_t const copied = length < pass.name.size() ? length : pass.name.size() - 1;
+        if (copied) std::memcpy(pass.name.data(), name, copied);
+        pass.name[copied] = 0;
+        pass.sample.name_truncated = copied < length;
+        mActivePass = int32_t(index);
+        if (mInitialized) write(mCurrentSlot * QUERIES_PER_FRAME + 1 + index * 2);
+    }
+    void endPass(uint64_t id) noexcept {
+        if (!mCurrent || mActivePass < 0) return;
+        auto& pass = mCurrent->passes[size_t(mActivePass)];
+        if (pass.sample.pass_id != id) return;
+        if (mInitialized) write(mCurrentSlot * QUERIES_PER_FRAME + 2 + uint32_t(mActivePass) * 2);
+        pass.ended = true;
+        mActivePass = -1;
+    }
+    void counters(uint64_t commands, uint64_t primitives, uint64_t visible,
+            uint64_t instanceInvocations = 0) noexcept {
+        if (!mCurrent || mActivePass < 0) return;
+        auto& sample = mCurrent->passes[size_t(mActivePass)].sample;
+        sample.command_count += commands;
+        sample.primitive_count += primitives;
+        sample.visible_renderables += visible;
+        sample.draw_instance_invocations += instanceInvocations;
+    }
+};
+} // namespace filament::backend
+#endif
