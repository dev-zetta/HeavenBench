+/* Copyright (C) 2026 The Android Open Source Project
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may obtain a copy at http://www.apache.org/licenses/LICENSE-2.0
+ */
+#ifndef TNT_UTILS_PRIVATE_PROFILERTRACE_H
+#define TNT_UTILS_PRIVATE_PROFILERTRACE_H
+#include <utils/ProfilerTrace.h>
+
+namespace utils::profiling {
+UTILS_PUBLIC void begin(const char* category, const char* name) noexcept;
+UTILS_PUBLIC void end() noexcept;
+UTILS_PUBLIC void event(CpuEventKind kind, const char* category, const char* name,
+        int64_t value = 0, uint64_t cookie = 0) noexcept;
+UTILS_PUBLIC void emitGpu(GpuSample const& sample) noexcept;
+UTILS_PUBLIC void emitCapabilities(GpuCapabilities const& caps) noexcept;
+
+class ScopedTrace {
+    bool mActive;
+public:
+    ScopedTrace(const char* category, const char* name) noexcept : mActive(isEnabled()) {
+        if (mActive) begin(category, name);
+    }
+    ~ScopedTrace() noexcept { if (mActive) end(); }
+    ScopedTrace(ScopedTrace const&) = delete;
+    ScopedTrace& operator=(ScopedTrace const&) = delete;
+};
+class ScopedContext {
+    Context mPrevious;
+public:
+    explicit ScopedContext(Context context) noexcept : mPrevious(getContext()) { setContext(context); }
+    ~ScopedContext() noexcept { setContext(mPrevious); }
+};
+
+// Backend adapter is thread-local: native API work stays on the driver owner.
+// Other backends retain a truthful UNSUPPORTED result through the null adapter.
+struct GpuAdapter {
+    void* user;
+    void (*beginFrame)(void*, Context) noexcept;
+    void (*endFrame)(void*) noexcept;
+    void (*beginPass)(void*, Context, uint64_t, const char*) noexcept;
+    void (*endPass)(void*, uint64_t) noexcept;
+    void (*counters)(void*, uint64_t, uint64_t, uint64_t) noexcept;
+};
+UTILS_PUBLIC void setGpuAdapter(GpuAdapter const* adapter) noexcept;
+UTILS_PUBLIC void gpuBeginFrame(Context context) noexcept;
+UTILS_PUBLIC void gpuEndFrame() noexcept;
+UTILS_PUBLIC void gpuBeginPass(Context context, uint64_t id, const char* name) noexcept;
+UTILS_PUBLIC void gpuEndPass(uint64_t id) noexcept;
+UTILS_PUBLIC void gpuCounters(uint64_t commands, uint64_t primitives, uint64_t visible) noexcept;
+} // namespace utils::profiling
+#endif
