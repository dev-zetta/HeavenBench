+namespace filament::backend {
+class VulkanGpuProfiler final : public GpuProfiler {
+public:
+    VulkanGpuProfiler(VulkanPlatform& platform, VulkanCommands& commands, VulkanContext& context)
+        : GpuProfiler(capabilities(platform, context)), mDevice(platform.getDevice()),
+          mCommands(commands) {
+        mCommands.setBeforeFlush(this, [](void* user) noexcept {
+            static_cast<VulkanGpuProfiler*>(user)->invalidateAuxiliary(
+                    "pipeline-statistics scope crosses a native submission boundary");
+        });
+    }
+    ~VulkanGpuProfiler() override;
+private:
+    VkDevice mDevice;
+    VulkanCommands& mCommands;
+    VkQueryPool mPool = VK_NULL_HANDLE;
+    VkQueryPool mStatisticsPool = VK_NULL_HANDLE;
+    bool mDeviceLost = false;
+    std::array<std::shared_ptr<VulkanCmdFence>, FRAME_COUNT> mFences{};
+    void noteDeviceLoss(VkResult status) noexcept {
+        if (status != VK_ERROR_DEVICE_LOST) return;
+        mDeviceLost = true;
+        mCaps.pipeline_statistics_reason = "Vulkan device lost; native statistics are unavailable";
+        mCaps.reason = "Vulkan device lost; native timestamps are unavailable";
+    }
+
+    static Caps capabilities(VulkanPlatform& platform, VulkanContext& context) {
+        Caps caps = platform.getGpuDiagnosticsCapabilities();
+        caps.backend = utils::profiling::GpuBackend::VULKAN;
+        caps.timestamp_period_ns = context.getPhysicalDeviceLimits().timestampPeriod;
+        uint32_t count = 0;
+        bluevk::vkGetPhysicalDeviceQueueFamilyProperties(platform.getPhysicalDevice(), &count, nullptr);
+        std::vector<VkQueueFamilyProperties> families(count);
+        bluevk::vkGetPhysicalDeviceQueueFamilyProperties(platform.getPhysicalDevice(), &count,
+                families.data());
+        uint32_t const family = platform.getGraphicsQueueFamilyIndex();
+        if (family < count && families[family].timestampValidBits <= 64) {
+            caps.timestamp_valid_bits = uint8_t(families[family].timestampValidBits);
+        }
+        caps.hardware_timestamps = caps.timestamp_valid_bits > 0 &&
+                std::isfinite(caps.timestamp_period_ns) && caps.timestamp_period_ns > 0;
+        caps.reason = caps.hardware_timestamps ? "hardware timestamps; frame-relative clock" :
+                "graphics queue does not expose valid hardware timestamps";
+        return caps;
+    }
+    bool initialize() noexcept override {
+        VkQueryPoolCreateInfo const info{VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO, nullptr, 0,
+                VK_QUERY_TYPE_TIMESTAMP, QUERY_COUNT, 0};
+        if (bluevk::vkCreateQueryPool(mDevice, &info, nullptr, &mPool) != VK_SUCCESS) {
+            mCaps.reason = "dedicated timestamp query pool creation failed";
+            return false;
+        }
+        return true;
+    }
+    void reset(uint32_t slot) noexcept override {
+        if (mDeviceLost) return;
+        auto& commands = mCommands.get();
+        mFences[slot] = commands.getFenceStatus();
+        auto const buffer = commands.buffer();
+        if (mPool) bluevk::vkCmdResetQueryPool(buffer, mPool,
+                slot * QUERIES_PER_FRAME, QUERIES_PER_FRAME);
+        if (mStatisticsPool) bluevk::vkCmdResetQueryPool(buffer, mStatisticsPool,
+                slot * PASS_COUNT, PASS_COUNT);
+    }
+    void write(uint32_t index) noexcept override {
+        if (mDeviceLost) return;
+        auto& commands = mCommands.get();
+        bluevk::vkCmdWriteTimestamp(commands.buffer(), VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT,
+                mPool, index);
+        // Remember the submission containing the last timestamp. Closing after
+        // presentation must not acquire a fresh command buffer just for a fence.
+        mFences[index / QUERIES_PER_FRAME] = commands.getFenceStatus();
+    }
+    QueryStatus read(uint32_t index, uint64_t& ticks) noexcept override {
+        if (mDeviceLost) return QueryStatus::ERROR;
+        std::array<uint64_t, 2> result{};
+        VkResult const status = bluevk::vkGetQueryPoolResults(mDevice, mPool, index, 1,
+                sizeof(result), result.data(), sizeof(result),
+                VK_QUERY_RESULT_64_BIT | VK_QUERY_RESULT_WITH_AVAILABILITY_BIT);
+        noteDeviceLoss(status);
+        if (status != VK_SUCCESS && status != VK_NOT_READY) return QueryStatus::ERROR;
+        if (status == VK_NOT_READY || !result[1]) return QueryStatus::PENDING;
+        ticks = result[0];
+        return QueryStatus::AVAILABLE;
+    }
+    bool ready(uint32_t slot) noexcept override {
+        return mDeviceLost || (mFences[slot] && mFences[slot]->getStatus() == VK_SUCCESS);
+    }
+    QueryStatus validity() noexcept override {
+        for (auto const& fence : mFences) {
+            if (fence) noteDeviceLoss(fence->getStatus());
+        }
+        if (!mDeviceLost) return QueryStatus::AVAILABLE;
+        return QueryStatus::ERROR;
+    }
+    void close(uint32_t) noexcept override {}
+    bool initializeAuxiliary() noexcept override {
+        if (!mCaps.pipeline_statistics_enabled) return false;
+        VkQueryPoolCreateInfo const info{
+            VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO, nullptr, 0,
+            VK_QUERY_TYPE_PIPELINE_STATISTICS, FRAME_COUNT * PASS_COUNT,
+            VK_QUERY_PIPELINE_STATISTIC_INPUT_ASSEMBLY_VERTICES_BIT |
+            VK_QUERY_PIPELINE_STATISTIC_INPUT_ASSEMBLY_PRIMITIVES_BIT |
+            VK_QUERY_PIPELINE_STATISTIC_VERTEX_SHADER_INVOCATIONS_BIT |
+            VK_QUERY_PIPELINE_STATISTIC_CLIPPING_INVOCATIONS_BIT |
+            VK_QUERY_PIPELINE_STATISTIC_CLIPPING_PRIMITIVES_BIT |
+            VK_QUERY_PIPELINE_STATISTIC_FRAGMENT_SHADER_INVOCATIONS_BIT};
+        if (bluevk::vkCreateQueryPool(mDevice, &info, nullptr, &mStatisticsPool) != VK_SUCCESS) {
+            mCaps.pipeline_statistics_reason = "dedicated pipeline-statistics query pool creation failed";
+            return false;
+        }
+        return true;
+    }
+    void beginAuxiliary(uint32_t slot, uint32_t pass, Sample& sample) noexcept override {
+        sample.pipeline_statistics_reason = mCaps.pipeline_statistics_reason;
+        if (mDeviceLost) {
+            sample.pipeline_statistics_status = QueryStatus::ERROR;
+            return;
+        }
+        if (!mStatisticsPool) return;
+        auto& commands = mCommands.get();
+        bluevk::vkCmdBeginQuery(commands.buffer(), mStatisticsPool, slot * PASS_COUNT + pass, 0);
+        sample.pipeline_statistics_status = QueryStatus::PENDING;
+        sample.pipeline_statistics_reason = "pipeline-statistics query has not completed";
+        mFences[slot] = commands.getFenceStatus();
+    }
+    void endAuxiliary(uint32_t slot, uint32_t pass, Sample& sample) noexcept override {
+        if (mDeviceLost || !mStatisticsPool || sample.pipeline_statistics_status != QueryStatus::PENDING) return;
+        auto& commands = mCommands.get();
+        bluevk::vkCmdEndQuery(commands.buffer(), mStatisticsPool, slot * PASS_COUNT + pass);
+        mFences[slot] = commands.getFenceStatus();
+    }
+    QueryStatus readAuxiliary(uint32_t slot, uint32_t pass, Sample& sample) noexcept override {
+        if (!mStatisticsPool) return QueryStatus::UNSUPPORTED;
+        if (mDeviceLost) {
+            sample.pipeline_statistics_status = QueryStatus::ERROR;
+            sample.pipeline_statistics_reason = mCaps.pipeline_statistics_reason;
+            return QueryStatus::ERROR;
+        }
+        if (sample.pipeline_statistics_status == QueryStatus::ERROR) return QueryStatus::ERROR;
+        // Vulkan returns selected statistics in ascending flag-bit order, followed by availability.
+        std::array<uint64_t, 7> result{};
+        VkResult const status = bluevk::vkGetQueryPoolResults(mDevice, mStatisticsPool,
+                slot * PASS_COUNT + pass, 1, sizeof(result), result.data(), sizeof(result),
+                VK_QUERY_RESULT_64_BIT | VK_QUERY_RESULT_WITH_AVAILABILITY_BIT);
+        noteDeviceLoss(status);
+        if (status != VK_SUCCESS && status != VK_NOT_READY) {
+            sample.pipeline_statistics_status = QueryStatus::ERROR;
+            sample.pipeline_statistics_reason = mDeviceLost ? mCaps.pipeline_statistics_reason
+                    : "native pipeline-statistics read failed";
+        } else if (status == VK_NOT_READY || !result[6]) {
+            return QueryStatus::PENDING;
+        } else {
+            sample.input_assembly_vertices = result[0];
+            sample.input_assembly_primitives = result[1];
+            sample.vertex_shader_invocations = result[2];
+            sample.clipping_invocations = result[3];
+            sample.clipping_primitives = result[4];
+            sample.fragment_shader_invocations = result[5];
+            sample.pipeline_statistics_status = QueryStatus::AVAILABLE;
+            sample.pipeline_statistics_reason = "actual native pipeline-statistics query";
+        }
+        return sample.pipeline_statistics_status;
+    }
+};
+} // namespace filament::backend
+#endif
