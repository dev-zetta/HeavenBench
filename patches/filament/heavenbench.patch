diff --git a/filament/backend/test/test_FragmentShadingRate.cpp b/filament/backend/test/test_FragmentShadingRate.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..1e9ace995179791341e71632c1f8aab4b97cd906
--- /dev/null
+++ b/filament/backend/test/test_FragmentShadingRate.cpp
@@ -0,0 +1,189 @@
+/* Copyright (C) 2026 The Android Open Source Project
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may obtain a copy at http://www.apache.org/licenses/LICENSE-2.0
+ */
+#include "vulkan/utils/FragmentShadingRate.h"
+
+#include <initializer_list>
+#include <iostream>
+#include <vector>
+
+namespace {
+using Words = std::vector<uint32_t>;
+Words module() { return {spv::MagicNumber, 0x00010000, 0, 1024, 0}; }
+void append(Words& words, uint32_t op, std::initializer_list<uint32_t> operands) {
+    words.push_back((uint32_t(operands.size() + 1) << 16) | op);
+    words.insert(words.end(), operands);
+}
+Words sampleMask(uint32_t storageClass = spv::StorageClassOutput) {
+    Words words = module();
+    append(words, spv::OpDecorate, {9, spv::DecorationBuiltIn, spv::BuiltInSampleMask});
+    append(words, spv::OpTypePointer, {7, storageClass, 3});
+    append(words, spv::OpVariable, {7, 9, storageClass});
+    return words;
+}
+}
+
+int main() {
+    unsigned failures = 0;
+    auto const check = [&](char const* name, Words const& words, bool expected,
+            bool depthStencilSupported = false, bool sampleMaskSupported = false) {
+        bool const actual = filament::backend::fvkutils::fragmentShaderRequiresFullRate(
+                words.data(), words.size(), depthStencilSupported, sampleMaskSupported);
+        if (actual != expected) {
+            std::cerr << "FAIL " << name << ": full rate=" << actual << '\n';
+            ++failures;
+        }
+    };
+    Words normal = module();
+    append(normal, spv::OpCapability, {spv::CapabilityShader});
+    append(normal, spv::OpExecutionMode, {1, spv::ExecutionModeOriginUpperLeft});
+    check("ordinary fragment", normal, false);
+
+    Words depth = normal;
+    append(depth, spv::OpExecutionMode, {1, spv::ExecutionModeDepthReplacing});
+    check("DepthReplacing", depth, true);
+    check("DepthReplacing allowed by physical property", depth, false, true, false);
+    Words perSample = normal;
+    append(perSample, spv::OpCapability, {spv::CapabilitySampleRateShading});
+    check("SampleRateShading", perSample, true);
+    check("SampleRateShading remains full even with both properties", perSample, true, true, true);
+
+    for (uint32_t mode : {uint32_t(spv::ExecutionModePixelInterlockOrderedEXT),
+            uint32_t(spv::ExecutionModePixelInterlockUnorderedEXT),
+            uint32_t(spv::ExecutionModeSampleInterlockOrderedEXT),
+            uint32_t(spv::ExecutionModeSampleInterlockUnorderedEXT),
+            uint32_t(spv::ExecutionModeShadingRateInterlockOrderedEXT),
+            uint32_t(spv::ExecutionModeShadingRateInterlockUnorderedEXT)}) {
+        Words interlock = normal;
+        append(interlock, spv::OpExecutionMode, {1, mode});
+        check("interlock conservatively retains full", interlock, true, true, true);
+    }
+    for (uint32_t capability : {uint32_t(spv::CapabilityTileImageColorReadAccessEXT),
+            uint32_t(spv::CapabilityTileImageDepthReadAccessEXT),
+            uint32_t(spv::CapabilityTileImageStencilReadAccessEXT)}) {
+        Words tile = normal;
+        append(tile, spv::OpCapability, {capability});
+        check("tile image capability retains full", tile, true, true, true);
+    }
+
+    Words mask = sampleMask();
+    check("unused output SampleMask unsupported", mask, true);
+    check("unused output SampleMask supported", mask, false, false, true);
+    Words directMask = mask;
+    append(directMask, spv::OpStore, {9, 6});
+    check("direct output SampleMask write", directMask, true);
+    check("direct output SampleMask write supported", directMask, false, false, true);
+    Words untouchedMask = mask;
+    append(untouchedMask, spv::OpPhi, {3, 11, 4, 2, 5, 3});
+    append(untouchedMask, spv::OpStore, {12, 6});
+    check("unused output SampleMask with unrelated flow and store", untouchedMask, true);
+    check("supported SampleMask with unrelated flow and store", untouchedMask, false, false, true);
+    append(mask, spv::OpAccessChain, {7, 10, 9, 5});
+    append(mask, spv::OpStore, {10, 6});
+    check("output SampleMask element write", mask, true);
+    check("supported output SampleMask element write", mask, false, false, true);
+    Words input = sampleMask(spv::StorageClassInput);
+    append(input, spv::OpLoad, {3, 10, 9});
+    check("input SampleMask load unsupported", input, true);
+    check("input SampleMask load supported", input, false, false, true);
+    Words alias = sampleMask();
+    append(alias, spv::OpCopyObject, {7, 10, 9});
+    append(alias, spv::OpStore, {10, 6});
+    check("output SampleMask alias write", alias, true);
+    check("supported output SampleMask alias write", alias, false, false, true);
+    Words call = sampleMask();
+    append(call, spv::OpFunctionCall, {3, 10, 2, 9});
+    check("output SampleMask pointer call", call, true);
+    check("supported output SampleMask pointer call", call, false, false, true);
+    Words phi = sampleMask();
+    append(phi, spv::OpPhi, {7, 10, 9, 2, 11, 3});
+    check("output pointer phi", phi, true);
+    check("supported SampleMask output pointer phi", phi, false, false, true);
+
+    for (uint32_t builtin : {uint32_t(spv::BuiltInFragDepth),
+            uint32_t(spv::BuiltInFragStencilRefEXT)}) {
+        Words output = module();
+        append(output, spv::OpDecorate, {9, spv::DecorationBuiltIn, builtin});
+        append(output, spv::OpTypePointer, {7, spv::StorageClassOutput, 3});
+        append(output, spv::OpVariable, {7, 9, spv::StorageClassOutput});
+        check("unused fragment depth/stencil declaration unsupported", output, true);
+        check("unused fragment depth/stencil declaration supported", output, false, true, false);
+        append(output, spv::OpStore, {9, 6});
+        check("fragment depth/stencil write", output, true);
+        check("supported fragment depth/stencil write", output, false, true, false);
+        for (bool depthSupported : {false, true}) {
+            for (bool maskSupported : {false, true}) {
+                check("depth/stencil property matrix", output, !depthSupported, depthSupported, maskSupported);
+            }
+        }
+    }
+
+    Words structure = module();
+    append(structure, spv::OpMemberDecorate, {8, 0, spv::DecorationBuiltIn, spv::BuiltInSampleMask});
+    append(structure, spv::OpTypePointer, {7, spv::StorageClassOutput, 8});
+    append(structure, spv::OpVariable, {7, 9, spv::StorageClassOutput});
+    append(structure, spv::OpAccessChain, {7, 10, 9, 5});
+    append(structure, spv::OpStore, {10, 6});
+    check("interface structure write", structure, true);
+    check("supported SampleMask interface structure write", structure, false, false, true);
+
+    Words grouped = module();
+    append(grouped, spv::OpDecorationGroup, {8});
+    append(grouped, spv::OpDecorate, {8, spv::DecorationBuiltIn, spv::BuiltInSampleMask});
+    append(grouped, spv::OpGroupDecorate, {8, 9});
+    append(grouped, spv::OpTypePointer, {7, spv::StorageClassOutput, 3});
+    append(grouped, spv::OpVariable, {7, 9, spv::StorageClassOutput});
+    append(grouped, spv::OpStore, {9, 6});
+    check("group-decorated output write", grouped, true);
+    check("supported group-decorated output write", grouped, false, false, true);
+    Words unreferenced = module();
+    append(unreferenced, spv::OpDecorate, {9, spv::DecorationBuiltIn, spv::BuiltInSampleMask});
+    // Deliberately retain declarations not referenced by an entry-point interface. This is a
+    // conservative policy rather than entry-point-specific SPIR-V semantic validation.
+    for (bool depthSupported : {false, true}) {
+        for (bool maskSupported : {false, true}) {
+            check("unreferenced SampleMask declaration property matrix", unreferenced,
+                    !maskSupported, depthSupported, maskSupported);
+            check("SampleMask input property matrix", input, !maskSupported, depthSupported, maskSupported);
+            check("SampleMask output property matrix", mask, !maskSupported, depthSupported, maskSupported);
+        }
+    }
+
+    check("empty stream", {}, true);
+    check("truncated header", {spv::MagicNumber, 0x10000}, true);
+    Words malformed = normal;
+    malformed.push_back(0);
+    check("zero word instruction", malformed, true);
+    malformed = normal;
+    malformed.push_back((4u << 16) | spv::OpStore);
+    malformed.push_back(9);
+    check("truncated instruction", malformed, true);
+    malformed = normal;
+    append(malformed, spv::OpDecorate, {9, spv::DecorationBuiltIn});
+    check("truncated BuiltIn operand", malformed, true);
+    malformed = normal;
+    append(malformed, spv::OpTypePointer, {7, spv::StorageClassOutput});
+    check("truncated OpTypePointer operands", malformed, true);
+    malformed = normal;
+    append(malformed, spv::OpVariable, {7, 9});
+    check("truncated OpVariable operands", malformed, true);
+    malformed = normal;
+    malformed[0] = 0;
+    check("invalid magic", malformed, true);
+    malformed = normal;
+    malformed[3] = 0;
+    check("invalid id bound", malformed, true);
+    Words overflow = sampleMask();
+    for (uint32_t i = 0; i < 129; ++i) {
+        append(overflow, spv::OpAccessChain, {7, 20 + i, 9, 5});
+    }
+    check("long SampleMask alias chain unsupported", overflow, true);
+    check("long SampleMask alias chain supported without tracking", overflow, false, false, true);
+    if (!filament::backend::fvkutils::fragmentShaderRequiresFullRate(nullptr, 5)) {
+        std::cerr << "FAIL null input\n";
+        ++failures;
+    }
+    std::cout << "fragment shading rate policy: " << failures << " failures\n";
+    return failures ? 1 : 0;
+}
diff --git a/filament/backend/test/test_ProfilerTrace.cpp b/filament/backend/test/test_ProfilerTrace.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..0fb474724969acf42393021c6533fc3e77d6f5a9
--- /dev/null
+++ b/filament/backend/test/test_ProfilerTrace.cpp
@@ -0,0 +1,424 @@
+/* Copyright (C) 2026 The Android Open Source Project
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may obtain a copy at http://www.apache.org/licenses/LICENSE-2.0
+ */
+// Standalone contract test: link against utils and backend. No graphics device is required.
+#include "GpuProfiler.h"
+#include <private/utils/ProfilerTrace.h>
+#include <utils/JobSystem.h>
+#include <array>
+#include <atomic>
+#include <cstdio>
+#include <cstring>
+#include <functional>
+#include <memory>
+#include <stdexcept>
+
+namespace p = utils::profiling;
+using filament::backend::GpuProfiler;
+namespace {
+// Preserve upstream's native Job ABI, including Windows' larger std::function storage.
+struct alignas(utils::CACHELINE_SIZE) UnprofiledJobLayout {
+    static constexpr size_t STORAGE_BYTES =
+            sizeof(std::function<void()>) > 48 ? sizeof(std::function<void()>) : 48;
+    static constexpr size_t STORAGE_WORDS =
+            (STORAGE_BYTES + sizeof(void*) - 1) / sizeof(void*);
+    void* storage[STORAGE_WORDS];
+    utils::JobSystem::JobFunc function;
+    uint16_t parent;
+    utils::JobSystem::ThreadId id;
+    std::atomic<uint8_t> refCount;
+    std::atomic<uint32_t> runningJobCount;
+};
+static_assert(utils::JobSystem::Job::JOB_STORAGE_SIZE_BYTES == UnprofiledJobLayout::STORAGE_BYTES &&
+        utils::JobSystem::Job::JOB_STORAGE_SIZE_WORDS == UnprofiledJobLayout::STORAGE_WORDS,
+        "Profiler sidecar must preserve upstream Job storage policy");
+static_assert(sizeof(utils::JobSystem::Job) == sizeof(UnprofiledJobLayout),
+        "Profiler sidecar must preserve native Job size");
+static_assert(alignof(utils::JobSystem::Job) == alignof(UnprofiledJobLayout),
+        "Profiler sidecar must preserve native Job alignment");
+void require(bool condition, const char* message) {
+    if (!condition) throw std::runtime_error(message);
+}
+struct Records {
+    std::array<p::CpuEvent, 1024> cpu{};
+    std::array<std::array<char, 96>, 1024> cpuNames{};
+    std::atomic<uint32_t> cpuCount{0};
+    std::array<p::GpuSample, 18000> gpu{};
+    uint32_t gpuCount = 0;
+    p::GpuCapabilities caps{};
+    uint32_t capsCount = 0;
+    p::Observer observer{this,
+        [](void* ptr, p::CpuEvent const& event) noexcept {
+            auto& r = *static_cast<Records*>(ptr);
+            uint32_t const i = r.cpuCount.fetch_add(1);
+            if (i >= r.cpu.size()) return;
+            r.cpu[i] = event;
+            if (event.name) std::strncpy(r.cpuNames[i].data(), event.name, 95);
+        },
+        [](void* ptr, p::GpuSample const& sample) noexcept {
+            auto& r = *static_cast<Records*>(ptr);
+            if (r.gpuCount < r.gpu.size()) r.gpu[r.gpuCount++] = sample;
+        },
+        [](void* ptr, p::GpuCapabilities const& caps) noexcept {
+            auto& r = *static_cast<Records*>(ptr); r.caps = caps; ++r.capsCount;
+        }};
+    void clear() { cpuCount.store(0); gpuCount = 0; capsCount = 0; }
+};
+class Queries final : public GpuProfiler {
+public:
+    explicit Queries(bool supported = true, bool auxiliary = false) : GpuProfiler(Caps{
+            .backend = p::GpuBackend::VULKAN, .hardware_timestamps = supported,
+            .timestamp_valid_bits = 8, .timestamp_period_ns = 2,
+            .diagnostics_requested = auxiliary, .pipeline_statistics_supported = auxiliary,
+            .pipeline_statistics_enabled = auxiliary}), auxiliarySupported(auxiliary) {}
+    ~Queries() override;
+    bool available = false;
+    bool initializeOk = true;
+    QueryStatus valid = QueryStatus::AVAILABLE;
+    uint64_t nextTick = 250;
+    uint64_t step = 3;
+    uint32_t resets = 0;
+    int32_t pendingIndex = -1;
+    bool auxiliarySupported = false;
+    bool auxiliaryInitializeOk = true;
+    bool auxiliaryAvailable = false;
+    int32_t pendingAuxiliaryPass = -1;
+    uint32_t auxiliaryBegins = 0, auxiliaryEnds = 0, timestampReads = 0;
+    uint32_t auxiliaryCloseCalls = 0;
+    bool nestedAuxiliary = false;
+private:
+    std::array<uint64_t, QUERY_COUNT> ticks{};
+    bool initialize() noexcept override { return initializeOk; }
+    void reset(uint32_t) noexcept override { ++resets; }
+    void write(uint32_t index) noexcept override { ticks[index] = nextTick & 255; nextTick += step; }
+    QueryStatus read(uint32_t index, uint64_t& result) noexcept override {
+        ++timestampReads;
+        if (!available || int32_t(index) == pendingIndex) return QueryStatus::PENDING;
+        result = ticks[index]; return QueryStatus::AVAILABLE;
+    }
+    bool ready(uint32_t) noexcept override { return available; }
+    void close(uint32_t) noexcept override {}
+    QueryStatus validity() noexcept override { return valid; }
+    bool mAuxiliaryActive = false;
+    bool mAuxiliaryReady = false;
+    bool initializeAuxiliary() noexcept override {
+        mAuxiliaryReady = auxiliarySupported && auxiliaryInitializeOk;
+        return mAuxiliaryReady;
+    }
+    void beginAuxiliary(uint32_t, uint32_t, Sample& sample) noexcept override {
+        if (!auxiliarySupported) return;
+        if (!mAuxiliaryReady) {
+            sample.pipeline_statistics_reason = "fake dedicated query allocation failed";
+            return;
+        }
+        nestedAuxiliary |= mAuxiliaryActive;
+        mAuxiliaryActive = true;
+        ++auxiliaryBegins;
+        sample.pipeline_statistics_status = QueryStatus::PENDING;
+        sample.pipeline_statistics_reason = "fake hardware counter pending";
+    }
+    void endAuxiliary(uint32_t, uint32_t, Sample& sample) noexcept override {
+        if (!auxiliarySupported) return;
+        ++auxiliaryCloseCalls;
+        if (sample.pipeline_statistics_status != QueryStatus::PENDING) return;
+        mAuxiliaryActive = false;
+        ++auxiliaryEnds;
+    }
+    QueryStatus readAuxiliary(uint32_t, uint32_t index, Sample& sample) noexcept override {
+        if (!auxiliarySupported) return QueryStatus::UNSUPPORTED;
+        if (sample.pipeline_statistics_status == QueryStatus::ERROR) return QueryStatus::ERROR;
+        if (!auxiliaryAvailable || int32_t(index) == pendingAuxiliaryPass) return QueryStatus::PENDING;
+        sample.pipeline_statistics_status = QueryStatus::AVAILABLE;
+        sample.pipeline_statistics_reason = "fake actual pipeline query";
+        sample.input_assembly_vertices = 9001;
+        sample.input_assembly_primitives = 3000;
+        sample.vertex_shader_invocations = 4096;
+        sample.clipping_invocations = 2999;
+        sample.clipping_primitives = 3001;
+        sample.fragment_shader_invocations = 1234567;
+        return QueryStatus::AVAILABLE;
+    }
+};
+Queries::~Queries() = default;
+p::Context context(uint64_t capture = 7) {
+    return {11, 12, 13, 14, 15, capture};
+}
+void pass(uint64_t id = 1, p::Context c = context(), GpuProfiler* draws = nullptr) {
+    p::gpuBeginPass(c, id, "color");
+    p::gpuCounters(4, 12, 3);
+    if (draws) {
+        draws->recordPrimitives(filament::backend::PrimitiveType::TRIANGLES, 6, 3);
+        draws->recordPrimitives(filament::backend::PrimitiveType::LINES, 4, 2,
+                filament::backend::FragmentShadingRate::RATE_2X1);
+        draws->recordPrimitives(filament::backend::PrimitiveType::POINTS, 1, 1,
+                filament::backend::FragmentShadingRate::RATE_2X2);
+    }
+    p::gpuEndPass(id);
+}
+void cpuTests(Records& r) {
+    p::setContext(context()); p::setEnabled(true);
+    char mutableName[] = "outer";
+    p::begin("test", mutableName);
+    mutableName[0] = 'X';
+    p::begin("test", "inner"); p::end();
+    p::setEnabled(false); p::end();
+    require(r.cpuCount == 2, "balanced scopes complete after disabling");
+    require(r.cpu[0].parent_id == r.cpu[1].scope_id, "CPU parent identity");
+    require(r.cpu[0].context.capture_id == 7 && r.cpu[0].context.view_id == 15,
+            "CPU complete inherited context");
+    require(r.cpu[0].end_ns >= r.cpu[0].begin_ns, "CPU monotonic duration");
+    require(std::strcmp(r.cpuNames[1].data(), "outer") == 0, "CPU copies borrowed scope label");
+    r.clear();
+    p::begin("test", "disabled"); p::setEnabled(true); p::end();
+    require(r.cpuCount == 0, "disabled manual begin remains balanced across enable");
+    for (int i = 0; i != 129; ++i) p::begin("test", "bounded");
+    for (int i = 0; i != 129; ++i) p::end();
+    require(r.cpuCount == 129 && r.cpu[0].kind == p::CpuEventKind::DROPPED,
+            "CPU depth overflow is explicit and bounded");
+    r.clear();
+    p::begin("test", "after-overflow"); p::end();
+    require(r.cpu[0].parent_id == 0, "CPU overflow preserves later stack balance");
+
+    utils::JobSystem jobs(1, 1); jobs.adopt();
+    std::atomic<bool> parentCorrect{false}, childCorrect{false};
+    p::setContext(context(21));
+    auto* job = jobs.createJob(nullptr, [&](utils::JobSystem& js, utils::JobSystem::Job* parent) {
+        parentCorrect.store(p::getContext().capture_id == 21 && p::getContext().view_id == 15);
+        p::setContext(context(99));
+        auto* child = js.createJob(parent, [&](utils::JobSystem&, utils::JobSystem::Job*) {
+            childCorrect.store(p::getContext().capture_id == 21 && p::getContext().attempt_id == 11);
+        });
+        js.run(child);
+    });
+    p::setContext(context(22));
+    jobs.runAndWait(job);
+    require(parentCorrect && childCorrect, "queued jobs and descendants inherit creation context");
+    require(p::getContext().capture_id == 22, "job execution restores caller context");
+    jobs.emancipate();
+    p::setEnabled(false);
+}
+void gpuTests(Records& r) {
+    p::setEnabled(true); r.clear();
+    {
+        auto q = std::make_unique<Queries>(); q->install();
+        // Submission accepted while enabled, consumed after capture stopped.
+        p::setEnabled(false);
+        p::gpuBeginFrame(context()); pass(1, context(), q.get()); p::gpuEndFrame();
+        require(r.gpuCount == 1 && r.gpu[0].status == p::GpuStatus::PENDING &&
+                r.gpu[0].begin_ns == -1, "unavailable GPU queries stay pending with no zero time");
+        p::setEnabled(false); q->available = true; q->poll();
+        require(r.gpuCount == 2 && r.gpu[1].status == p::GpuStatus::AVAILABLE &&
+                r.gpu[1].begin_ns == 6 && r.gpu[1].end_ns == 12,
+                "valid-bit wrap converts to relative nanoseconds after disable");
+        require(r.gpu[1].context.capture_id == 7 && r.gpu[1].command_count == 4 &&
+                r.gpu[1].primitive_count == 23 && r.gpu[1].visible_renderables == 3 &&
+                r.gpu[1].draw_instance_invocations == 6 &&
+                r.gpu[1].native_draw_commands_available &&
+                r.gpu[1].native_draw_commands_full == 1 &&
+                r.gpu[1].native_draw_commands_2x1 == 1 &&
+                r.gpu[1].native_draw_commands_2x2 == 1,
+                "GPU delayed context and counters survive intact");
+        require(r.capsCount == 1 && !r.caps.cpu_clock_calibrated, "GPU clock explicitly uncalibrated");
+        q->terminate();
+    }
+    p::setEnabled(true); r.clear();
+    {
+        auto q = std::make_unique<Queries>(false); q->install();
+        p::gpuBeginFrame(context()); pass(1, context(), q.get()); p::gpuEndFrame(); q->poll();
+        require(r.gpuCount == 1 && r.gpu[0].status == p::GpuStatus::UNSUPPORTED &&
+                r.gpu[0].end_ns == -1 && q->resets == 0, "unsupported GPU never queries or invents time");
+        require(r.gpu[0].native_draw_commands_available &&
+                r.gpu[0].native_draw_commands_full == 1 &&
+                r.gpu[0].native_draw_commands_2x1 == 1 && r.gpu[0].native_draw_commands_2x2 == 1,
+                "native draw counters remain available without timestamp support");
+        q->terminate();
+    }
+    r.clear();
+    p::gpuBeginFrame(context()); pass(); p::gpuEndFrame();
+    require(r.gpuCount == 1 && r.gpu[0].status == p::GpuStatus::UNSUPPORTED &&
+            !r.gpu[0].native_draw_commands_available,
+            "missing native adapter does not claim measured zero draw counters");
+    r.clear();
+    {
+        auto q = std::make_unique<Queries>(); q->initializeOk = false; q->install();
+        p::gpuBeginFrame(context()); pass(1, context(), q.get()); p::gpuEndFrame();
+        require(r.gpuCount == 1 && r.gpu[0].status == p::GpuStatus::UNSUPPORTED &&
+                r.gpu[0].native_draw_commands_available && r.gpu[0].native_draw_commands_full == 1 &&
+                q->resets == 0, "native draw counters survive timestamp allocation failure");
+        q->terminate();
+    }
+    r.clear();
+    {
+        auto q = std::make_unique<Queries>(); q->install();
+        q->step = 100;
+        p::gpuBeginFrame(context()); pass(); p::gpuEndFrame(); q->available = true; q->poll();
+        require(r.gpu[1].status == p::GpuStatus::ERROR && r.gpu[1].begin_ns == -1,
+                "ambiguous timestamp wrap is rejected"); q->terminate();
+    }
+    r.clear();
+    {
+        auto q = std::make_unique<Queries>(); q->install();
+        for (uint32_t i = 0; i != GpuProfiler::FRAME_COUNT; ++i) {
+            p::gpuBeginFrame(context(30 + i)); pass(i + 1, context(30 + i)); p::gpuEndFrame();
+        }
+        q->valid = p::GpuStatus::DISJOINT; q->poll();
+        p::gpuBeginFrame(context(50)); pass(50, context(50)); p::gpuEndFrame();
+        require(q->resets == 16 && r.gpu[r.gpuCount - 1].status == p::GpuStatus::DROPPED,
+                "disjoint does not prematurely recycle in-flight query storage");
+        q->available = true; q->valid = p::GpuStatus::AVAILABLE; q->poll();
+        require(r.gpuCount == 33 && r.gpu[17].status == p::GpuStatus::DISJOINT,
+                "disjoint propagates explicitly after safe retirement");
+        p::gpuBeginFrame(context(51)); pass(51, context(51)); p::gpuEndFrame(); q->poll();
+        require(q->resets == 17 && r.gpu[r.gpuCount - 1].status == p::GpuStatus::AVAILABLE &&
+                r.gpu[r.gpuCount - 1].context.capture_id == 51,
+                "query slots recover and preserve new capture identity"); q->terminate();
+    }
+    r.clear();
+    {
+        auto q = std::make_unique<Queries>(); q->install(); q->step = 0;
+        p::gpuBeginFrame(context());
+        for (uint32_t i = 0; i != 257; ++i) pass(i + 1);
+        p::gpuEndFrame();
+        require(r.gpuCount == 257 && r.gpu[0].status == p::GpuStatus::DROPPED &&
+                !r.gpu[0].native_draw_commands_available,
+                "pass invocation overflow is explicit and bounded at 256");
+        q->available = true; q->pendingIndex = 1; q->poll();
+        require(r.gpuCount == 512, "partial query availability does not stall available peers");
+        q->pendingIndex = -1; q->poll();
+        require(r.gpuCount == 513 && r.gpu[512].status == p::GpuStatus::AVAILABLE,
+                "partially available frame retires exactly once per pass"); q->terminate();
+    }
+    require(GpuProfiler::primitiveCount(filament::backend::PrimitiveType::TRIANGLES, 6, 3) == 6 &&
+            GpuProfiler::primitiveCount(filament::backend::PrimitiveType::TRIANGLE_STRIP, 2, 1) == 0 &&
+            GpuProfiler::primitiveCount(filament::backend::PrimitiveType::LINE_STRIP, 5, 2) == 8,
+            "submission counters count topology primitives and instances");
+    p::setEnabled(false);
+}
+void pipelineStatisticsTests(Records& r) {
+    p::setEnabled(true); r.clear();
+    {
+        auto q = std::make_unique<Queries>(false, true); q->auxiliaryInitializeOk = false; q->install();
+        p::gpuBeginFrame(context()); pass(); p::gpuEndFrame();
+        require(r.caps.pipeline_statistics_enabled && r.gpuCount == 1 &&
+                r.gpu[0].pipeline_statistics_status == p::GpuStatus::UNSUPPORTED &&
+                std::strstr(r.gpu[0].pipeline_statistics_reason, "allocation failed") &&
+                q->auxiliaryBegins == 0 && q->resets == 0,
+                "failed query allocation must preserve logical feature attestation and explicit unavailability");
+        q->terminate();
+    }
+    r.clear();
+    {
+        auto q = std::make_unique<Queries>(false, true); q->install();
+        p::gpuBeginFrame(context()); pass(1, context(), q.get()); p::gpuEndFrame();
+        require(r.gpuCount == 1 && r.gpu[0].status == p::GpuStatus::UNSUPPORTED &&
+                r.gpu[0].pipeline_statistics_status == p::GpuStatus::PENDING && q->resets == 1,
+                "pipeline queries initialize independently of unsupported timestamps");
+        q->available = true; q->poll();
+        require(r.gpuCount == 1, "available fence does not fabricate missing pipeline statistics");
+        q->auxiliaryAvailable = true; q->poll();
+        require(r.gpuCount == 2 && r.gpu[1].status == p::GpuStatus::UNSUPPORTED &&
+                r.gpu[1].pipeline_statistics_status == p::GpuStatus::AVAILABLE &&
+                r.gpu[1].fragment_shader_invocations == 1234567 &&
+                r.gpu[1].vertex_shader_invocations == 4096 && r.gpu[1].primitive_count == 23 &&
+                q->timestampReads == 0, "actual invocation counters remain distinct from draw estimates");
+        q->terminate();
+    }
+    r.clear();
+    {
+        auto q = std::make_unique<Queries>(true, true); q->install();
+        p::gpuBeginFrame(context()); pass(1); pass(2); p::gpuEndFrame();
+        q->available = q->auxiliaryAvailable = true; q->pendingAuxiliaryPass = 0; q->poll();
+        require(r.gpuCount == 4 && r.gpu[2].pass_id == 1 &&
+                r.gpu[2].status == p::GpuStatus::AVAILABLE &&
+                r.gpu[2].pipeline_statistics_status == p::GpuStatus::PENDING &&
+                r.gpu[3].pass_id == 2 &&
+                r.gpu[3].pipeline_statistics_status == p::GpuStatus::AVAILABLE,
+                "out-of-order pipeline availability retires complete peers");
+        q->pendingAuxiliaryPass = -1; q->poll(); q->poll();
+        require(r.gpuCount == 5 && r.gpu[4].pass_id == 1,
+                "delayed pipeline statistics retire once with original pass identity");
+        q->terminate();
+    }
+    r.clear();
+    {
+        auto q = std::make_unique<Queries>(true, true); q->install();
+        p::gpuBeginFrame(context()); pass(); p::gpuEndFrame();
+        q->available = q->auxiliaryAvailable = true; q->pendingIndex = 0; q->poll();
+        require(r.gpuCount == 2 && r.gpu[1].status == p::GpuStatus::PENDING &&
+                r.gpu[1].pipeline_statistics_status == p::GpuStatus::AVAILABLE,
+                "completed statistics publish while timestamp origin remains pending");
+        q->pendingIndex = -1; q->poll();
+        require(r.gpuCount == 3 && r.gpu[2].status == p::GpuStatus::AVAILABLE &&
+                r.gpu[2].pipeline_statistics_status == p::GpuStatus::AVAILABLE,
+                "later timestamp completion preserves already measured statistics");
+        q->terminate();
+    }
+    r.clear();
+    {
+        auto q = std::make_unique<Queries>(false, true); q->install();
+        for (uint32_t i = 0; i < GpuProfiler::FRAME_COUNT; ++i) {
+            p::gpuBeginFrame(context(i + 1)); pass(i + 1, context(i + 1)); p::gpuEndFrame();
+        }
+        q->available = true; q->poll();
+        p::gpuBeginFrame(context(99)); pass(99); p::gpuEndFrame();
+        require(q->resets == 16 && r.gpu[r.gpuCount - 1].pipeline_statistics_status ==
+                p::GpuStatus::DROPPED, "unresolved statistics protect all sixteen query slots");
+        q->auxiliaryAvailable = true; q->poll();
+        p::gpuBeginFrame(context(100)); pass(100); p::gpuEndFrame(); q->poll();
+        require(q->resets == 17 && r.gpu[r.gpuCount - 1].pipeline_statistics_status ==
+                p::GpuStatus::AVAILABLE, "statistics slots reset only after complete retirement");
+        q->terminate();
+    }
+    r.clear();
+    {
+        auto q = std::make_unique<Queries>(false, true); q->install();
+        p::gpuBeginFrame(context());
+        p::gpuBeginPass(context(), 1, "outer");
+        p::gpuBeginPass(context(), 2, "overlapping"); p::gpuEndPass(2);
+        p::gpuBeginPass(context(), 3, "unclosed"); p::gpuEndFrame();
+        q->available = q->auxiliaryAvailable = true; q->poll();
+        require(!q->nestedAuxiliary && q->auxiliaryBegins == 3 && q->auxiliaryEnds == 3 &&
+                q->auxiliaryCloseCalls == 3 &&
+                r.gpuCount == 4 && r.gpu[0].pipeline_statistics_status == p::GpuStatus::ERROR &&
+                r.gpu[2].pipeline_statistics_status == p::GpuStatus::ERROR &&
+                r.gpu[3].pipeline_statistics_status == p::GpuStatus::AVAILABLE && r.gpu[3].pass_id == 2,
+                "overlapping and unclosed scopes close native queries and remain explicit errors");
+        q->terminate();
+    }
+    r.clear();
+    {
+        auto q = std::make_unique<Queries>(false, true); q->install();
+        p::gpuBeginFrame(context()); p::gpuBeginPass(context(), 1, "native boundary");
+        q->invalidateAuxiliary("secondary command boundary"); p::gpuEndPass(1); p::gpuEndFrame();
+        q->available = q->auxiliaryAvailable = true; q->poll();
+        require(q->auxiliaryEnds == 1 && q->auxiliaryCloseCalls == 1 && r.gpuCount == 1 &&
+                r.gpu[0].pipeline_statistics_status == p::GpuStatus::ERROR,
+                "native secondary boundary closes once and rejects partial counter coverage");
+        q->terminate();
+    }
+    r.clear();
+    {
+        auto q = std::make_unique<Queries>(false, true); q->install();
+        p::gpuBeginFrame(context()); pass(); p::gpuEndFrame(); q->terminate();
+        require(r.gpuCount == 2 && r.gpu[1].pipeline_statistics_status == p::GpuStatus::ERROR,
+                "cancelled unresolved statistics retain unavailable reason instead of measured zero");
+    }
+    p::setEnabled(false);
+}
+} // namespace
+int main() {
+    try {
+        std::printf("ProfilerTrace Job ABI: size=%zu alignment=%zu std::function=%zu\n",
+                sizeof(utils::JobSystem::Job), alignof(utils::JobSystem::Job),
+                sizeof(std::function<void()>));
+        auto records = std::make_unique<Records>();
+        p::setObserver(&records->observer);
+        cpuTests(*records); gpuTests(*records); pipelineStatisticsTests(*records);
+        p::setObserver(nullptr);
+        std::puts("ProfilerTrace contracts: PASS"); return 0;
+    } catch (std::exception const& e) {
+        p::setEnabled(false); p::setObserver(nullptr);
+        std::fprintf(stderr, "ProfilerTrace contracts: FAIL: %s\n", e.what()); return 1;
+    }
+}
