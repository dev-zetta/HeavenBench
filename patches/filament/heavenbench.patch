+#ifndef TNT_UTILS_PRIVATE_PROFILERTRACE_H
+#define TNT_UTILS_PRIVATE_PROFILERTRACE_H
+#include <utils/ProfilerTrace.h>
+
+namespace utils::profiling {
+UTILS_PUBLIC void begin(const char* category, const char* name) noexcept;
+UTILS_PUBLIC void end() noexcept;
+UTILS_PUBLIC void event(CpuEventKind kind, const char* category, const char* name,
