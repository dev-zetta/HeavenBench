+    highp vec3 center = frameUniforms.lightDirection;
+    highp float normalLength2 = dot(shading_contactShadowNormal, shading_contactShadowNormal);
+    if (!(normalLength2 > 0.0 && normalLength2 < 1.0e20)) {
+        return screenSpaceContactShadow(fallbackDirection);
+    }
+    highp vec3 ng = shading_contactShadowNormal * inversesqrt(normalLength2);
+    highp vec2 radius = normalize(frameUniforms.sun.xy);
+    highp float c = radius.x;
+    highp float s = radius.y;
+    if (!(c > 0.0 && c < 1.0 && s > 0.0)) {
+        return screenSpaceContactShadow(fallbackDirection);
+    }
+    highp float mu = clamp(dot(ng, center), -1.0, 1.0);
+    if (mu <= -s) {
+        return 1.0;
+    }
