diff --git a/filament/backend/src/vulkan/VulkanGpuProfiler.h b/filament/backend/src/vulkan/VulkanGpuProfiler.h
new file mode 100644
index 0000000000000000000000000000000000000000..701cdc67e90f72e370a0ca728ca741d665b083e3
--- /dev/null
+++ b/filament/backend/src/vulkan/VulkanGpuProfiler.h
@@ -0,0 +1,83 @@
+/* Copyright (C) 2026 The Android Open Source Project
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may obtain a copy at http://www.apache.org/licenses/LICENSE-2.0
+ */
+#ifndef TNT_VULKAN_GPU_PROFILER_H
+#define TNT_VULKAN_GPU_PROFILER_H
+#include "GpuProfiler.h"
+#include "VulkanCommands.h"
+#include "VulkanContext.h"
+#include <backend/platforms/VulkanPlatform.h>
+#include <vector>
+
+namespace filament::backend {
+class VulkanGpuProfiler final : public GpuProfiler {
+public:
+    VulkanGpuProfiler(VulkanPlatform& platform, VulkanCommands& commands, VulkanContext& context)
+        : GpuProfiler(capabilities(platform, context)), mDevice(platform.getDevice()),
+          mCommands(commands) {}
+    ~VulkanGpuProfiler() override;
+private:
+    VkDevice mDevice;
+    VulkanCommands& mCommands;
+    VkQueryPool mPool = VK_NULL_HANDLE;
+    std::array<std::shared_ptr<VulkanCmdFence>, FRAME_COUNT> mFences{};
+
+    static Caps capabilities(VulkanPlatform& platform, VulkanContext& context) {
+        Caps caps{};
+        caps.backend = utils::profiling::GpuBackend::VULKAN;
+        caps.timestamp_period_ns = context.getPhysicalDeviceLimits().timestampPeriod;
+        uint32_t count = 0;
+        bluevk::vkGetPhysicalDeviceQueueFamilyProperties(platform.getPhysicalDevice(), &count, nullptr);
+        std::vector<VkQueueFamilyProperties> families(count);
+        bluevk::vkGetPhysicalDeviceQueueFamilyProperties(platform.getPhysicalDevice(), &count,
+                families.data());
+        uint32_t const family = platform.getGraphicsQueueFamilyIndex();
+        if (family < count && families[family].timestampValidBits <= 64) {
+            caps.timestamp_valid_bits = uint8_t(families[family].timestampValidBits);
+        }
+        caps.hardware_timestamps = caps.timestamp_valid_bits > 0 &&
+                std::isfinite(caps.timestamp_period_ns) && caps.timestamp_period_ns > 0;
+        caps.reason = caps.hardware_timestamps ? "hardware timestamps; frame-relative clock" :
+                "graphics queue does not expose valid hardware timestamps";
+        return caps;
+    }
+    bool initialize() noexcept override {
+        VkQueryPoolCreateInfo const info{VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO, nullptr, 0,
+                VK_QUERY_TYPE_TIMESTAMP, QUERY_COUNT, 0};
+        if (bluevk::vkCreateQueryPool(mDevice, &info, nullptr, &mPool) != VK_SUCCESS) {
+            mCaps.reason = "dedicated timestamp query pool creation failed";
+            return false;
+        }
+        return true;
+    }
+    void reset(uint32_t slot) noexcept override {
+        mFences[slot].reset();
+        bluevk::vkCmdResetQueryPool(mCommands.get().buffer(), mPool,
+                slot * QUERIES_PER_FRAME, QUERIES_PER_FRAME);
+    }
+    void write(uint32_t index) noexcept override {
+        auto& commands = mCommands.get();
+        bluevk::vkCmdWriteTimestamp(commands.buffer(), VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT,
+                mPool, index);
+        // Remember the submission containing the last timestamp. Closing after
+        // presentation must not acquire a fresh command buffer just for a fence.
+        mFences[index / QUERIES_PER_FRAME] = commands.getFenceStatus();
+    }
+    QueryStatus read(uint32_t index, uint64_t& ticks) noexcept override {
+        std::array<uint64_t, 2> result{};
+        VkResult const status = bluevk::vkGetQueryPoolResults(mDevice, mPool, index, 1,
+                sizeof(result), result.data(), sizeof(result),
+                VK_QUERY_RESULT_64_BIT | VK_QUERY_RESULT_WITH_AVAILABILITY_BIT);
+        if (status != VK_SUCCESS && status != VK_NOT_READY) return QueryStatus::ERROR;
+        if (status == VK_NOT_READY || !result[1]) return QueryStatus::PENDING;
+        ticks = result[0];
+        return QueryStatus::AVAILABLE;
+    }
+    bool ready(uint32_t slot) noexcept override {
+        return mFences[slot] && mFences[slot]->getStatus() == VK_SUCCESS;
+    }
+    void close(uint32_t) noexcept override {}
+};
+} // namespace filament::backend
+#endif
