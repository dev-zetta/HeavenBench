+#include <cstring>
 
 #if defined(__linux__)
 
@@ -298,3 +303,109 @@ Profiler::Counters Profiler::readCounters() noexcept {
 #endif // __linux__
 
 } // namespace utils
+
+namespace utils::profiling {
+namespace {
+std::atomic<Observer const*> sObserver{nullptr};
+std::atomic<bool> sEnabled{false};
+std::atomic<uint64_t> sNextId{1};
+thread_local Context sContext{};
+thread_local GpuAdapter const* sGpuAdapter = nullptr;
+struct Scope {
+    CpuEvent event;
+    Observer const* observer;
+    std::array<char, 96> name{};
+    std::array<char, 64> category{};
+};
+struct ThreadScopes {
+    std::array<Scope, 128> stack{};
+    uint32_t size = 0;
+    uint32_t ignored = 0;
+    uint64_t thread = std::hash<std::thread::id>{}(std::this_thread::get_id());
+};
+thread_local ThreadScopes sScopes;
+int64_t now() noexcept {
+    return std::chrono::duration_cast<std::chrono::nanoseconds>(
+            std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+}
+void setObserver(Observer const* observer) noexcept { sObserver.store(observer, std::memory_order_release); }
+void setEnabled(bool enabled) noexcept { sEnabled.store(enabled, std::memory_order_release); }
+bool isEnabled() noexcept {
+    return sEnabled.load(std::memory_order_relaxed) && sObserver.load(std::memory_order_acquire);
+}
+Context getContext() noexcept { return sContext; }
+void setContext(Context context) noexcept { sContext = context; }
+uint64_t nextId() noexcept { return sNextId.fetch_add(1, std::memory_order_relaxed); }
+void begin(const char* category, const char* name) noexcept {
+    auto& scopes = sScopes;
+    auto const* observer = sObserver.load(std::memory_order_acquire);
+    if (scopes.ignored || !sEnabled.load(std::memory_order_relaxed) || !observer || !observer->cpu) {
+        ++scopes.ignored;
+        return;
+    }
+    if (scopes.size == scopes.stack.size()) {
+        ++scopes.ignored;
+        CpuEvent lost{.context = sContext, .thread_id = scopes.thread,
+                .begin_ns = now(), .category = category, .name = name,
+                .kind = CpuEventKind::DROPPED, .value = 1};
+        lost.end_ns = lost.begin_ns;
+        observer->cpu(observer->user, lost);
+        return;
+    }
+    uint64_t const parent = scopes.size ? scopes.stack[scopes.size - 1].event.scope_id : 0;
+    auto& slot = scopes.stack[scopes.size++];
+    slot = {CpuEvent{.context = sContext, .scope_id = nextId(), .parent_id = parent,
+            .thread_id = scopes.thread, .begin_ns = now(), .category = category, .name = name}, observer};
+    if (name) std::strncpy(slot.name.data(), name, slot.name.size() - 1);
+    if (category) std::strncpy(slot.category.data(), category, slot.category.size() - 1);
+    slot.event.name = slot.name.data();
+    slot.event.category = slot.category.data();
+}
+void end() noexcept {
+    auto& scopes = sScopes;
+    if (scopes.ignored) { --scopes.ignored; return; }
+    if (!scopes.size) return;
+    auto& slot = scopes.stack[--scopes.size];
+    slot.event.end_ns = now();
+    slot.observer->cpu(slot.observer->user, slot.event);
+}
+void event(CpuEventKind kind, const char* category, const char* name,
+        int64_t value, uint64_t cookie) noexcept {
+    if (!isEnabled()) return;
+    auto const* observer = sObserver.load(std::memory_order_acquire);
+    if (!observer || !observer->cpu) return;
+    CpuEvent record{.context = sContext, .scope_id = nextId(),
+            .parent_id = sScopes.size ? sScopes.stack[sScopes.size - 1].event.scope_id : 0,
+            .thread_id = sScopes.thread, .begin_ns = now(), .category = category,
+            .name = name, .kind = kind, .value = value, .cookie = cookie};
+    record.end_ns = record.begin_ns;
+    observer->cpu(observer->user, record);
+}
+void emitGpu(GpuSample const& sample) noexcept {
+    auto const* observer = sObserver.load(std::memory_order_acquire);
+    if (observer && observer->gpu) observer->gpu(observer->user, sample);
+}
+void emitCapabilities(GpuCapabilities const& caps) noexcept {
+    auto const* observer = sObserver.load(std::memory_order_acquire);
+    if (observer && observer->capabilities) observer->capabilities(observer->user, caps);
+}
+void setGpuAdapter(GpuAdapter const* adapter) noexcept { sGpuAdapter = adapter; }
+void gpuBeginFrame(Context context) noexcept {
+    setContext(context);
+    if (sGpuAdapter) sGpuAdapter->beginFrame(sGpuAdapter->user, context);
+}
+void gpuEndFrame() noexcept { if (sGpuAdapter) sGpuAdapter->endFrame(sGpuAdapter->user); }
+void gpuBeginPass(Context context, uint64_t id, const char* name) noexcept {
+    setContext(context);
+    if (sGpuAdapter) sGpuAdapter->beginPass(sGpuAdapter->user, context, id, name);
+    else emitGpu(GpuSample{.context = context, .pass_id = id, .name = name,
+            .status = GpuStatus::UNSUPPORTED});
+}
+void gpuEndPass(uint64_t id) noexcept {
+    if (sGpuAdapter) sGpuAdapter->endPass(sGpuAdapter->user, id);
+}
+void gpuCounters(uint64_t commands, uint64_t primitives, uint64_t visible) noexcept {
+    if (sGpuAdapter) sGpuAdapter->counters(sGpuAdapter->user, commands, primitives, visible);
+}
+} // namespace utils::profiling
