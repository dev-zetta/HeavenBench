+void VulkanDriver::nativeCommand(NativeCommand command) {
+    FVK_SYSTRACE_SCOPE();
+    if (!command.callback) return;
+    assert_invariant(!mCurrentRenderPass.commandBuffer);
+    auto& commands = mCommands.get();
+    VulkanCommandContext context;
+    context.instance = mPlatform->getInstance();
+    context.physicalDevice = mPlatform->getPhysicalDevice();
+    context.device = mPlatform->getDevice();
+    context.queueFamily = mPlatform->getGraphicsQueueFamilyIndex();
+    context.commandBuffer = commands.buffer();
+    std::array<resource_ptr<VulkanTexture>, NativeCommand::TEXTURE_COUNT> textures;
+    std::array<VulkanLayout, NativeCommand::TEXTURE_COUNT> layouts{};
+    bool hasTextures = false;
+    for (size_t i = 0; i < textures.size(); ++i) {
+        if (command.textures[i] == HandleBase::nullid) continue;
+        hasTextures = true;
+        textures[i] = resource_ptr<VulkanTexture>::cast(&mResourceManager,
+                TextureHandle(command.textures[i]));
+        auto& texture = textures[i];
+        layouts[i] = texture->getLayout(0, 0);
+        const auto range = texture->getPrimaryViewRange();
+        if (layouts[i] == VulkanLayout::UNDEFINED || texture->samples != 1 ||
+                range.levelCount != 1 || range.layerCount != 1) {
+            command.callback(command.user, nullptr);
+            return;
+        }
+    }
+    bool discard = false;
+    if (hasTextures) {
+        if (mGpuProfiler) mGpuProfiler->invalidateAuxiliary(
+                "native secondary work has independent diagnostic coverage");
+        context.commandBuffer = commands.beginNativeCommands();
+        if (!context.commandBuffer) {
+            command.callback(command.user, nullptr);
+            return;
+        }
+        context.discard = &discard;
+    }
+    for (size_t i = 0; i < textures.size(); ++i) {
+        auto& texture = textures[i];
+        if (!texture) continue;
+        texture->transitionLayout(&commands, texture->getPrimaryViewRange(),
+                VulkanLayout::COMPUTE_READ);
+        commands.acquire(texture);
+        context.images[i] = { texture->getVkImage(), texture->getVkFormat(),
+                {texture->width, texture->height}, VK_IMAGE_LAYOUT_GENERAL,
+                texture->getImageAspect() };
+        context.images[i].view = texture->getView(texture->getPrimaryViewRange());
+        context.images[i].memory = texture->getVkMemory();
+        context.images[i].usage = texture->getVkUsage();
+        context.images[i].restoredLayout = fvkutils::getVkLayout(layouts[i]);
+    }
+    command.callback(command.user, &context);
+    if (hasTextures) {
+        auto const result = vkEndCommandBuffer(context.commandBuffer);
+        FILAMENT_CHECK_POSTCONDITION(result == VK_SUCCESS)
+                << "Native secondary command recording failed: " << result;
+        if (!discard) vkCmdExecuteCommands(commands.buffer(), 1, &context.commandBuffer);
+    }
+    invalidateBoundState();
+    for (size_t i = 0; i < textures.size(); ++i) {
+        auto& texture = textures[i];
+        if (texture) texture->transitionLayout(&commands, texture->getPrimaryViewRange(), layouts[i]);
+    }
+}
