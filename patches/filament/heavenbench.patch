+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+#ifndef TNT_FILAMENT_BACKEND_VULKAN_UTILS_LINEARSTAGEIMAGE_H
+#define TNT_FILAMENT_BACKEND_VULKAN_UTILS_LINEARSTAGEIMAGE_H
+
+#include <bluevk/BlueVK.h>
+
+namespace filament::backend::fvkutils {
+
+// Host writes to a linear image require PREINITIALIZED or GENERAL. The first
+// submitted transition must preserve the bytes, and reused images stay GENERAL.
+// The pool's existing fence-backed resource ownership serializes every reuse.
+class LinearStageImageState {
+public:
+    static constexpr VkImageLayout INITIAL_LAYOUT = VK_IMAGE_LAYOUT_PREINITIALIZED;
+    static constexpr VkImageLayout READ_LAYOUT = VK_IMAGE_LAYOUT_GENERAL;
+    static constexpr VkPipelineStageFlags HOST_STAGE = VK_PIPELINE_STAGE_HOST_BIT;
+    static constexpr VkPipelineStageFlags READ_STAGE = VK_PIPELINE_STAGE_TRANSFER_BIT;
+
+    VkImageMemoryBarrier hostWriteBarrier(VkImage image) noexcept {
+        VkImageMemoryBarrier const barrier{
+            .sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER,
+            .srcAccessMask = VK_ACCESS_HOST_WRITE_BIT,
+            .dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT,
+            .oldLayout = mLayout,
+            .newLayout = READ_LAYOUT,
+            .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+            .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+            .image = image,
+            .subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1},
+        };
+        mLayout = READ_LAYOUT;
+        return barrier;
+    }
+
+private:
+    VkImageLayout mLayout = INITIAL_LAYOUT;
+};
+
+} // namespace filament::backend::fvkutils
+#endif
