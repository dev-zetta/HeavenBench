+UTILS_PUBLIC void emitCapabilities(GpuCapabilities const& caps) noexcept;
+UTILS_PUBLIC void emitPipelineExecutable(PipelineExecutableEvent const& event) noexcept;
+
+class ScopedTrace {
+    bool mActive;
+public:
+    ScopedTrace(const char* category, const char* name) noexcept : mActive(isEnabled()) {
+        if (mActive) begin(category, name);
+    }
+    ~ScopedTrace() noexcept { if (mActive) end(); }
+    ScopedTrace(ScopedTrace const&) = delete;
+    ScopedTrace& operator=(ScopedTrace const&) = delete;
+};
+class ScopedContext {
+    Context mPrevious;
+public:
+    explicit ScopedContext(Context context) noexcept : mPrevious(getContext()) { setContext(context); }
+    ~ScopedContext() noexcept { setContext(mPrevious); }
+};
+
+// Backend adapter is thread-local: native API work stays on the driver owner.
+// Other backends retain a truthful UNSUPPORTED result through the null adapter.
