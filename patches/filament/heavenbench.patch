index 0000000000000000000000000000000000000000..aab097ec100400ac2e513e671e3b15725a172d0f
--- /dev/null
+++ b/filament/backend/src/vulkan/VulkanPipelineDiagnostics.h
@@ -0,0 +1,322 @@
+/* Copyright (C) 2026 The Android Open Source Project
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may obtain a copy at http://www.apache.org/licenses/LICENSE-2.0
+ */
+#ifndef TNT_VULKAN_PIPELINE_DIAGNOSTICS_H
+#define TNT_VULKAN_PIPELINE_DIAGNOSTICS_H
+
+#include <bluevk/BlueVK.h>
+#include <private/utils/ProfilerTrace.h>
+#include <algorithm>
+#include <array>
+#include <memory>
+#include <string>
+#include <vector>
+
+namespace filament::backend {
+
+// Cold-path, diagnostic-only compiler metadata. Driver enumeration and bounded temporary
+// allocations occur at pipeline compilation; callbacks replay only from the backend tick.
+// Capture flags can change compiler behavior, so these pipelines are never scored baselines.
+class VulkanPipelineDiagnostics {
+    using Event = utils::profiling::PipelineExecutableEvent;
+    using Kind = utils::profiling::PipelineExecutableEventKind;
+    using DiagnosticStatus = utils::profiling::GpuStatus;
+    static constexpr size_t MAX_BYTES = 16u * 1024u * 1024u;
+    static constexpr size_t MAX_IR_BYTES = 4u * 1024u * 1024u;
+    static constexpr size_t MAX_METADATA_BYTES = MAX_BYTES - MAX_IR_BYTES;
+    static constexpr size_t MAX_PIPELINES = 4096;
+    static constexpr size_t MAX_METADATA_EVENTS = 32768;
+    static constexpr size_t MAX_IR_EVENTS = 4096;
+    static constexpr size_t MAX_EVENTS = MAX_METADATA_EVENTS + MAX_IR_EVENTS;
+    static constexpr uint32_t MAX_EXECUTABLES = 8;
+    static constexpr uint32_t MAX_STATISTICS = 64;
+    static constexpr uint32_t MAX_REPRESENTATIONS = 8;
+    static constexpr size_t MAX_TEXT_BYTES = 4096;
+    static constexpr size_t MAX_DRIVER_TEXT_BYTES = 64u * 1024u;
+    struct Identity {
+        uint64_t pipeline, program;
+        std::string name;
+        size_t bytes() const noexcept { return sizeof(Identity) + name.capacity() + 1 + 64; }
+    };
+    using IdentityPtr = std::shared_ptr<Identity const>;
+    struct OwnedEvent {
+        Event event;
+        IdentityPtr identity;
+        std::string name, description, text;
+        char const* reason = "";
+        bool optionalIr = false;
+        size_t bytes() const noexcept {
+            // Charge inline capacity again conservatively and reserve allocator bookkeeping.
+            // Program identity/name storage is shared once per actual compiled pipeline.
+            return sizeof(OwnedEvent) + name.capacity() + description.capacity() +
+                    text.capacity() + 3 + 64;
+        }
+        void emit(utils::profiling::Context context) noexcept {
+            event.context = context;
+            event.program_name = identity->name.c_str();
+            event.name = name.c_str();
+            event.description = description.c_str();
+            event.text = text.c_str();
+            event.reason = reason;
+            utils::profiling::emitPipelineExecutable(event);
+        }
+    };
+    VkDevice mDevice;
+    PFN_vkGetPipelineExecutablePropertiesKHR mProperties;
+    PFN_vkGetPipelineExecutableStatisticsKHR mStatistics;
+    PFN_vkGetPipelineExecutableInternalRepresentationsKHR mRepresentations;
+    bool mCaptureText;
+    std::vector<std::unique_ptr<OwnedEvent>> mEvents;
+    size_t mMetadataBytes = MAX_EVENTS * sizeof(std::unique_ptr<OwnedEvent>);
+    size_t mIrBytes = 0;
+    size_t mMetadataEvents = 0;
+    size_t mIrEvents = 0;
+    size_t mCursor = 0;
+    size_t mPipelineCount = 0;
+    uint64_t mLost = 0;
+    uint64_t mReportedLost = 0;
+    uint64_t mLostIr = 0;
+    uint64_t mReportedLostIr = 0;
+    utils::profiling::Context mCaptureContext{};
+
+    bool append(OwnedEvent event) {
+        size_t const bytes = event.bytes();
+        bool const ir = event.optionalIr || event.event.kind == Kind::INTERNAL_REPRESENTATION;
+        if (ir) {
+            if (mIrEvents == MAX_IR_EVENTS || bytes > MAX_IR_BYTES - mIrBytes) {
+                ++mLostIr;
+                return false;
+            }
+            mIrBytes += bytes;
+            ++mIrEvents;
+        } else {
+            if (mMetadataEvents == MAX_METADATA_EVENTS || bytes > MAX_METADATA_BYTES - mMetadataBytes) {
+                ++mLost;
+                return false;
+            }
+            mMetadataBytes += bytes;
+            ++mMetadataEvents;
+        }
+        mEvents.push_back(std::make_unique<OwnedEvent>(std::move(event)));
+        return true;
+    }
+    static std::string bounded(char const* value, size_t capacity) {
+        size_t count = 0;
+        while (count < capacity && value[count]) ++count;
+        return std::string(value, count);
+    }
+    static OwnedEvent base(IdentityPtr const& identity) {
+        OwnedEvent result{};
+        result.event.pipeline_id = identity->pipeline;
+        result.event.program_id = identity->program;
+        result.identity = identity;
+        return result;
+    }
+    void loss(IdentityPtr const& identity, char const* reason,
+            uint64_t original = 0, bool optionalIr = false) {
+        auto event = base(identity);
+        event.event.kind = Kind::LOSS;
+        event.event.status = DiagnosticStatus::DROPPED;
+        event.event.original_size = original;
+        event.event.truncated = true;
+        event.reason = reason;
+        event.optionalIr = optionalIr;
+        append(std::move(event));
+    }
+public:
+    VulkanPipelineDiagnostics(VkDevice device, bool text) noexcept
+        : mDevice(device),
+          mProperties(reinterpret_cast<PFN_vkGetPipelineExecutablePropertiesKHR>(
+                  bluevk::vkGetDeviceProcAddr(device, "vkGetPipelineExecutablePropertiesKHR"))),
+          mStatistics(reinterpret_cast<PFN_vkGetPipelineExecutableStatisticsKHR>(
+                  bluevk::vkGetDeviceProcAddr(device, "vkGetPipelineExecutableStatisticsKHR"))),
+          mRepresentations(reinterpret_cast<PFN_vkGetPipelineExecutableInternalRepresentationsKHR>(
+                  bluevk::vkGetDeviceProcAddr(device, "vkGetPipelineExecutableInternalRepresentationsKHR"))),
+          mCaptureText(text) { mEvents.reserve(MAX_EVENTS); }
+
+    uint64_t capture(VkPipeline pipeline, uint64_t program, char const* name) {
+        uint64_t const id = utils::profiling::nextId();
+        if (mPipelineCount++ >= MAX_PIPELINES) { ++mLost; return id; }
+        auto identity = std::make_shared<Identity>(Identity{id, program,
+                name ? bounded(name, 1024) : std::string{}});
+        if (identity->bytes() > MAX_METADATA_BYTES - mMetadataBytes) { ++mLost; return id; }
+        mMetadataBytes += identity->bytes();
+        if (!mProperties || !mStatistics) {
+            loss(identity, "logical executable extension entry points are unavailable");
+            return id;
+        }
+        VkPipelineInfoKHR const info{VK_STRUCTURE_TYPE_PIPELINE_INFO_KHR, nullptr, pipeline};
+        uint32_t count = 0;
+        VkResult status = mProperties(mDevice, &info, &count, nullptr);
+        if (status != VK_SUCCESS || count > MAX_EXECUTABLES || count == 0) {
+            loss(identity, status == VK_SUCCESS
+                    ? "driver executable count is empty or exceeds bounded storage"
+                    : "driver executable enumeration failed", count);
+            return id;
+        }
+        std::array<VkPipelineExecutablePropertiesKHR, MAX_EXECUTABLES> executables{};
+        for (auto& entry : executables) entry.sType = VK_STRUCTURE_TYPE_PIPELINE_EXECUTABLE_PROPERTIES_KHR;
+        status = mProperties(mDevice, &info, &count, executables.data());
+        if (status != VK_SUCCESS || count > MAX_EXECUTABLES) {
+            loss(identity, "driver executable enumeration changed or failed", count);
+            return id;
+        }
+        for (uint32_t i = 0; i < count; ++i) {
+            auto const& executable = executables[i];
+            auto header = base(identity);
+            header.event.executable_index = i;
+            header.event.stages = executable.stages;
+            header.event.subgroup_size = executable.subgroupSize;
+            header.event.status = DiagnosticStatus::AVAILABLE;
+            header.name = bounded(executable.name, sizeof(executable.name));
+            header.description = bounded(executable.description, sizeof(executable.description));
+            header.reason = "driver-reported diagnostic compiler metadata; not runtime counters";
+            if (!append(header)) break;
+            VkPipelineExecutableInfoKHR const executableInfo{
+                VK_STRUCTURE_TYPE_PIPELINE_EXECUTABLE_INFO_KHR, nullptr, pipeline, i};
+            uint32_t statisticCount = 0;
+            status = mStatistics(mDevice, &executableInfo, &statisticCount, nullptr);
+            if (status != VK_SUCCESS || statisticCount > MAX_STATISTICS) {
+                loss(identity, "driver statistic count exceeds bounds or enumeration failed",
+                        statisticCount);
+                continue;
+            }
+            std::array<VkPipelineExecutableStatisticKHR, MAX_STATISTICS> statistics{};
+            for (auto& entry : statistics) entry.sType = VK_STRUCTURE_TYPE_PIPELINE_EXECUTABLE_STATISTIC_KHR;
+            status = mStatistics(mDevice, &executableInfo, &statisticCount, statistics.data());
+            if (status != VK_SUCCESS || statisticCount > MAX_STATISTICS) {
+                loss(identity, "driver statistic enumeration changed or failed", statisticCount);
+                continue;
+            }
+            for (uint32_t j = 0; j < statisticCount; ++j) {
+                auto event = header;
+                auto const& statistic = statistics[j];
+                event.event.kind = Kind::STATISTIC;
+                event.name = bounded(statistic.name, sizeof(statistic.name));
+                event.description = bounded(statistic.description, sizeof(statistic.description));
+                using Format = utils::profiling::PipelineStatisticFormat;
+                switch (statistic.format) {
+                    case VK_PIPELINE_EXECUTABLE_STATISTIC_FORMAT_BOOL32_KHR:
+                        event.event.format = Format::BOOL32;
+                        event.event.bool_value = statistic.value.b32 != VK_FALSE;
+                        break;
+                    case VK_PIPELINE_EXECUTABLE_STATISTIC_FORMAT_INT64_KHR:
+                        event.event.format = Format::INT64;
+                        event.event.signed_value = statistic.value.i64;
+                        break;
+                    case VK_PIPELINE_EXECUTABLE_STATISTIC_FORMAT_UINT64_KHR:
+                        event.event.format = Format::UINT64;
+                        event.event.unsigned_value = statistic.value.u64;
+                        break;
+                    case VK_PIPELINE_EXECUTABLE_STATISTIC_FORMAT_FLOAT64_KHR:
+                        event.event.format = Format::FLOAT64;
+                        event.event.float_value = statistic.value.f64;
+                        break;
+                    default:
+                        event.event.status = DiagnosticStatus::ERROR;
+                        event.reason = "unknown driver statistic format";
+                        break;
+                }
+                if (!append(std::move(event))) break;
+            }
+            if (!mCaptureText) continue;
+            if (!mRepresentations) {
+                loss(identity, "internal-representation entry point is unavailable", 0, true);
+                continue;
+            }
+            uint32_t representationCount = 0;
+            status = mRepresentations(mDevice, &executableInfo, &representationCount, nullptr);
+            if (status != VK_SUCCESS || representationCount > MAX_REPRESENTATIONS) {
+                loss(identity, "driver IR count exceeds bounds or enumeration failed",
+                        representationCount, true);
+                continue;
+            }
+            std::array<VkPipelineExecutableInternalRepresentationKHR, MAX_REPRESENTATIONS> reps{};
+            for (auto& entry : reps) {
+                entry.sType = VK_STRUCTURE_TYPE_PIPELINE_EXECUTABLE_INTERNAL_REPRESENTATION_KHR;
+            }
+            status = mRepresentations(mDevice, &executableInfo, &representationCount, reps.data());
+            if (status != VK_SUCCESS || representationCount > MAX_REPRESENTATIONS) {
+                loss(identity, "driver IR enumeration changed or failed", representationCount, true);
+                continue;
+            }
+            for (uint32_t j = 0; j < representationCount; ++j) {
+                auto event = header;
+                auto& representation = reps[j];
+                event.event.kind = Kind::INTERNAL_REPRESENTATION;
+                event.event.original_size = representation.dataSize;
+                event.name = bounded(representation.name, sizeof(representation.name));
+                event.description = bounded(representation.description, sizeof(representation.description));
+                size_t const estimatedBytes = event.bytes() +
+                        (representation.isText && representation.dataSize <= MAX_DRIVER_TEXT_BYTES
+                            ? std::min(representation.dataSize, MAX_TEXT_BYTES) : 0);
+                if (mIrEvents == MAX_IR_EVENTS || estimatedBytes > MAX_IR_BYTES - mIrBytes) {
+                    ++mLostIr;
+                    continue;
+                }
+                if (!representation.isText || representation.dataSize > MAX_DRIVER_TEXT_BYTES) {
+                    event.event.status = DiagnosticStatus::UNSUPPORTED;
+                    event.event.truncated = representation.dataSize > MAX_DRIVER_TEXT_BYTES;
+                    event.reason = !representation.isText ? "binary internal representation is not exported"
+                            : "driver text exceeds bounded 64 KiB retrieval storage";
+                } else {
+                    // Query only this representation: entries before it retain null pData.
+                    std::vector<char> text(std::max(size_t(1), representation.dataSize), 0);
+                    representation.pData = text.data();
+                    uint32_t const capacity = representationCount;
+                    status = mRepresentations(mDevice, &executableInfo, &representationCount, reps.data());
+                    representation.pData = nullptr;
+                    if (status == VK_SUCCESS && representationCount == capacity &&
+                            representation.dataSize <= text.size()) {
+                        size_t const length = std::min(representation.dataSize, text.size());
+                        event.text = bounded(text.data(), std::min(length, MAX_TEXT_BYTES));
+                        event.event.truncated = length > MAX_TEXT_BYTES;
+                        event.reason = event.event.truncated ? "driver text retained as a bounded 4096-byte snippet"
+                                : "driver text internal representation";
+                    } else {
+                        event.event.status = DiagnosticStatus::ERROR;
+                        event.reason = "driver IR size changed or retrieval failed";
+                    }
+                }
+                append(std::move(event));
+            }
+        }
+        return id;
+    }
+
+    void poll(utils::profiling::Context const* snapshot) noexcept {
+        if (snapshot) {
+            mCaptureContext = *snapshot;
+            mCursor = 0;
+            mReportedLost = 0;
+            mReportedLostIr = 0;
+        }
+        if (!mCaptureContext.capture_id) return;
+        while (mCursor < mEvents.size()) mEvents[mCursor++]->emit(mCaptureContext);
+        if (mLost != mReportedLost) {
+            Event event{};
+            event.kind = Kind::LOSS;
+            event.context = mCaptureContext;
+            event.status = DiagnosticStatus::DROPPED;
+            event.unsigned_value = mLost - mReportedLost;
+            event.reason = "bounded 4096-pipeline / 32768-record / 12 MiB compiler metadata cache exhausted";
+            event.truncated = true;
+            utils::profiling::emitPipelineExecutable(event);
+            mReportedLost = mLost;
+        }
+        if (mLostIr != mReportedLostIr) {
+            Event event{};
+            event.kind = Kind::LOSS;
+            event.context = mCaptureContext;
+            event.status = DiagnosticStatus::DROPPED;
+            event.unsigned_value = mLostIr - mReportedLostIr;
+            event.reason = "bounded 4096-record / 4 MiB optional compiler IR cache exhausted; headers and statistics retained separately";
+            event.truncated = true;
+            utils::profiling::emitPipelineExecutable(event);
+            mReportedLostIr = mLostIr;
+        }
+    }
+};
+} // namespace filament::backend
+#endif
