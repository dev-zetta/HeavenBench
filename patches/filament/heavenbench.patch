@@ -0,0 +1,28 @@
+/*
+ * Copyright (C) 2026 HeavenBench contributors
+ * Licensed under the Apache License, Version 2.0.
+ */
+#ifndef TNT_BACKEND_NATIVE_COMMAND_H
+#define TNT_BACKEND_NATIVE_COMMAND_H
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+
+namespace filament::backend {
+
+// Commands are copied into the ordinary driver stream. The callback runs there,
+// outside a render pass, and must not call frontend Filament APIs. The owner
+// drains the engine before retiring callback data or an external GPU resource.
+struct NativeCommand {
+    static constexpr size_t TEXTURE_COUNT = 5;
+    using Callback = void (*)(void* user, void const* vulkanContext) noexcept;
+    // color, depth, motion, UI and optional bidirectional distortion field.
+    std::array<uint32_t, TEXTURE_COUNT> textures{
+        UINT32_MAX, UINT32_MAX, UINT32_MAX, UINT32_MAX, UINT32_MAX};
+    Callback callback = nullptr;
+    void* user = nullptr;
+};
+
+} // namespace filament::backend
+#endif
