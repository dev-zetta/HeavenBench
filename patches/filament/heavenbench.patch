+#include <cstdint>
+
+namespace filament::backend::fvkutils {
+
+// A bounded, allocation-free policy check on already compiled fragment SPIR-V, not a validator.
+// Vulkan's hardware clamps depend on built-in declarations/interfaces, not observable stores.
+// Treat declarations anywhere in the module conservatively, including an unused decoration group
+// or another entry point. Device properties decide whether depth/stencil and SampleMask are allowed.
+inline bool fragmentShaderRequiresFullRate(uint32_t const* words, size_t wordCount,
+        bool withShaderDepthStencilWrites = false, bool withShaderSampleMask = false) noexcept {
+    if (!words || wordCount < 5 || words[0] != spv::MagicNumber || !words[3]) return true;
+    auto const sensitiveBuiltin = [=](uint32_t builtin) noexcept {
+        return (!withShaderDepthStencilWrites && (builtin == spv::BuiltInFragDepth ||
+                builtin == spv::BuiltInFragStencilRefEXT)) ||
+                (!withShaderSampleMask && builtin == spv::BuiltInSampleMask);
+    };
+    for (size_t cursor = 5; cursor < wordCount;) {
+        uint32_t const instruction = words[cursor];
+        size_t const size = instruction >> 16;
+        uint32_t const op = instruction & 0xffffu;
+        if (!size || size > wordCount - cursor) return true;
+        auto const* data = words + cursor;
+        switch (op) {
+            case spv::OpExecutionMode:
+            case spv::OpExecutionModeId:
+                if (size < 3) return true;
+                if (!withShaderDepthStencilWrites && data[2] == spv::ExecutionModeDepthReplacing) {
+                    return true;
+                }
+                // These packages are not used by Filament. Keep interlock conservative without
+                // relying on another optional physical property or performing shader data flow.
+                if (data[2] >= spv::ExecutionModePixelInterlockOrderedEXT &&
+                        data[2] <= spv::ExecutionModeShadingRateInterlockUnorderedEXT) return true;
+                break;
+            case spv::OpCapability:
+                if (size < 2 || data[1] == spv::CapabilitySampleRateShading ||
+                        data[1] == spv::CapabilityTileImageColorReadAccessEXT ||
+                        data[1] == spv::CapabilityTileImageDepthReadAccessEXT ||
+                        data[1] == spv::CapabilityTileImageStencilReadAccessEXT) return true;
+                break;
+            case spv::OpDecorate:
+                if (size < 3) return true;
+                if (data[2] == spv::DecorationBuiltIn) {
+                    if (size < 4) return true;
+                    if (sensitiveBuiltin(data[3])) return true;
+                }
+                break;
+            case spv::OpMemberDecorate:
+                if (size < 4) return true;
+                if (data[3] == spv::DecorationBuiltIn) {
+                    if (size < 5) return true;
+                    if (sensitiveBuiltin(data[4])) return true;
+                }
+                break;
+            case spv::OpGroupDecorate:
+                if (size < 3) return true;
+                break;
+            case spv::OpGroupMemberDecorate:
+                if (size < 4 || (size & 1u)) return true;
+                break;
+            case spv::OpTypePointer:
+                if (size != 4) return true;
+                break;
+            case spv::OpVariable:
+                if (size < 4) return true;
+                break;
+            default:
+                break;
+        }
+        cursor += size;
+    }
+    return false;
+}
+
+} // namespace filament::backend::fvkutils
+#endif
