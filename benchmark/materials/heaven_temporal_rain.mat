// Optional temporal contributor: shared visible shape, independent accepted history.
material {
    name : heaven_temporal_rain,
    requires : [ uv0, custom0 ],
    shadingModel : unlit,
    blending : opaque,
    doubleSided : true,
    flipUV : false,
    // Falling rain is occluded by closer scene geometry (depth test on, the
    // default) but must not write depth, so transparent streaks behind it still
    // composite correctly — same convention as the smoke particles.
    depthWrite : true,
    parameters : [
        { type : float4x4, name : currentClipFromUserWorld },
        { type : float4x4, name : previousClipFromUserWorld },
        { type : float4x4, name : previousModel },
        { type : float3, name : previousCamera },
        { type : float3, name : previousRight },
        { type : float3, name : previousUp },
        { type : float3x3, name : previousWorldToUser },
        { type : float, name : previousTime },
        { type : bool, name : historyValid },
        { type : float,  name : time },
        { type : float,  name : rainIntensity },
        { type : int,    name : activeStreaks },
        { type : float3, name : cameraPos, precision : high },
        { type : float,  name : volumeExtent },
        { type : float,  name : fallSpeed },
        { type : float,  name : streakLenMin },
        { type : float,  name : streakLenMax },
        { type : float4, name : rainShaderTuning }
    ],
    variables : [ currentClip, previousClip,
        // .x = accept flag (1 = active streak, 0 = collapsed) — fades the
        //      fragment so inactive / non-raining streaks draw nothing.
        // .y = per-drop brightness/alpha scale in ~[0.5, 1.0] (a pure function
        //      of the per-streak seed) so drops differ in brightness — the
        //      fragment multiplies its alpha by this.
        streakParams
    ]
}
vertex {
    #define HEAVEN_TEMPORAL_RAIN 1
    #include "includes/effect_rain_vertex.glsl"
    #include "includes/temporal_effect_vertex.glsl"
    void materialVertex(inout MaterialVertexInputs material) { temporalEffectVertex(material); }
}
fragment {
    #define HEAVEN_TEMPORAL_RAIN 1
    #define HEAVEN_TEMPORAL_EFFECT 1
    float3 effectTemporalWorld;
    #include "includes/effect_rain_fragment.glsl"
    #include "includes/temporal_effect_fragment.glsl"
    void material(inout MaterialInputs material) { temporalEffectFragment(material); }
}
