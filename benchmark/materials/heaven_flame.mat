// Heaven Benchmark — Torch / brazier flame (fully procedural)

// No sprite atlas: the entire flame is generated in the fragment
// shader from FBM noise, so it animates smoothly at any framerate
// and never shows the "sliding sprite frames" look of the old
// texture-atlas version.

// Geometry: ONE tall camera-facing billboard per torch, anchored at
// the wick and rising upward (set up by the vertex shader). The
// fragment shader carves a vertical flame plume out of the quad:
//   - a height-dependent width profile (narrow base, taper to a tip)
//   - horizontal domain-warp by upward-scrolling noise (the flicker)
//   - a fire colour ramp (white-hot core → yellow → orange → red)

// Animation speed is driven by `flameSpeed` against a wall-clock
// `time` uniform (renderer getUserTime()), so it's identical at
// 60 FPS and 15000 FPS.

// Compiled with: matc -a all -p desktop -o heaven_flame.filamat heaven_flame.mat

material {
    name : heaven_flame,
    requires : [ uv0, custom0, custom1 ],
    shadingModel : unlit,
    // Additive blending: where the cross-planes overlap, their
    // brightness accumulates, producing a dense bright core and a
    // softer halo at the edges — exactly how layered fire planes
    // build up volume. Additive also sidesteps transparent
    // draw-order sorting between the intersecting planes.
    blending : add,
    doubleSided : true,
    flipUV : false,
    depthWrite : false,
    parameters : [
        { type : float,  name : time },
        { type : float3, name : tint },
        { type : float,  name : alphaScale },
        { type : float,  name : flameSpeed },
        { type : float,  name : seed },
        { type : float4, name : particleShapeTuning }
    ],
    variables : [
        flameUV    // .xy = local quad UV (0..1),.z = per-emitter seed
    ]
}

vertex {
    #include "includes/effect_flame_vertex.glsl"
    void materialVertex(inout MaterialVertexInputs material) {
        effectVertex(material, materialParams.time,
            float3(frameUniforms.worldFromViewMatrix[0].xyz),
            float3(frameUniforms.worldFromViewMatrix[1].xyz),
            getWorldCameraPosition(), (getUserWorldFromWorldMatrix() * float4(getWorldCameraPosition(), 1.0)).xyz);
    }
}

fragment {
    #include "includes/effect_flame_fragment.glsl"
    void material(inout MaterialInputs material) { effectShade(material); }
}
