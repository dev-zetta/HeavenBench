// Heaven Benchmark — Torch / brazier flame (fully procedural)

// No sprite atlas: the entire flame is generated in the fragment
// shader from FBM noise, so it animates smoothly at any framerate
// and never shows the "sliding sprite frames" look of the old
// texture-atlas version.

// Geometry: ONE tall camera-facing billboard per torch, anchored at
// the wick and rising upward (set up by the vertex shader). The
// fragment shader carves a vertical flame plume out of the quad:
//   - a height-dependent width profile (narrow base, taper to a tip)
//   - horizontal domain-warp by upward-scrolling noise (the flicker)
//   - a fire colour ramp (white-hot core → yellow → orange → red)

// Animation speed is driven by `flameSpeed` against a wall-clock
// `time` uniform (renderer getUserTime()), so it's identical at
// 60 FPS and 15000 FPS.

// Compiled with: matc -a all -p desktop -o heaven_flame.filamat heaven_flame.mat

material {
    name : heaven_flame,
    requires : [ uv0, custom0, custom1 ],
    shadingModel : unlit,
    // Additive blending: where the cross-planes overlap, their
    // brightness accumulates, producing a dense bright core and a
    // softer halo at the edges — exactly how layered fire planes
    // build up volume. Additive also sidesteps transparent
    // draw-order sorting between the intersecting planes.
    blending : add,
    doubleSided : true,
    flipUV : false,
    depthWrite : false,
    parameters : [
        { type : float,  name : time },
        { type : float3, name : tint },
        { type : float,  name : alphaScale },
        { type : float,  name : flameSpeed },
        { type : float,  name : seed },
        { type : float4, name : particleShapeTuning }
    ],
    variables : [
        flameUV    // .xy = local quad UV (0..1),.z = per-emitter seed
    ]
}

vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        // POSITION holds the wick world position (same for all 4
        // verts of a plane). UV0 is the corner id in [0,1].
        // CUSTOM0.x is the plane index (0..N-1), CUSTOM0.y the
        // authored base radius.
        float3 wick   = material.worldPosition.xyz;
        float2 uv01   = material.uv0.xy;
        float4 c0     = getCustom0();
        float  plane  = c0.x;
        float  base_radius = c0.y;

        float half_width =
            max(0.05, base_radius) * materialParams.particleShapeTuning.x;
        float height =
            max(0.05, base_radius) * materialParams.particleShapeTuning.y;

        // ── World-oriented cross-planes ────────────────────────
        // Each plane is a vertical quad rotated about the world Z
        // (up) axis by a fixed yaw. With 3 planes at 0/60/120° the
        // flame reads as a 3D volume from any side — orbiting the
        // torch shows the planes overlapping rather than one flat
        // card rotating to face you. kPlanes MUST match kFlamePlanes
        // in filament_backend.cpp.
        const float kPlanes = 3.0;
        float yaw = plane * (3.14159265 / kPlanes);
        float3 right_axis = float3(cos(yaw), sin(yaw), 0.0);
        float3 up_axis    = float3(0.0, 0.0, 1.0);

        // Drop the quad so its lower third sits BELOW the emitter
        // origin — the flame should wrap around and rise out of the
        // torch cup, not float a gap above it. The emitter origin
        // (from torch_light.node) sits a little above the cup, so
        // sinking the base by ~0.35× the height tucks the flame
        // root back down into the torch head.
        float anchor_drop = height * materialParams.particleShapeTuning.z;

        float cx = uv01.x * 2.0 - 1.0;       // [-1,1] across width
        float3 world = wick
                     + cx * right_axis * half_width
                     + (uv01.y * height - anchor_drop) * up_axis;
        material.worldPosition = float4(world, 1.0);

        // Per-plane seed offset so each plane flickers differently.
        material.flameUV = float4(uv01, materialParams.seed + plane * 1.37, 0.0);
    }
}

fragment {
    // ── Noise kit (hash → value noise → fbm) ────────────────────
    float hash21(float2 p) {
        p = fract(p * float2(123.34, 456.21));
        p += dot(p, p + 45.32);
        return fract(p.x * p.y);
    }
    float vnoise(float2 p) {
        float2 i = floor(p);
        float2 f = fract(p);
        f = f * f * (3.0 - 2.0 * f);
        float a = hash21(i);
        float b = hash21(i + float2(1.0, 0.0));
        float c = hash21(i + float2(0.0, 1.0));
        float d = hash21(i + float2(1.0, 1.0));
        return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
    }
    float fbm(float2 p) {
        float s = 0.0, a = 0.5;
        for (int i = 0; i < 4; ++i) { s += a * vnoise(p); p *= 2.02; a *= 0.5; }
        return s;
    }

    void material(inout MaterialInputs material) {
        prepareMaterial(material);

        float2 uv   = variable_flameUV.xy;     // 0..1, y=0 at wick
        float  seed = variable_flameUV.z;
        // Upward-scrolling time term: noise flows DOWN the UV so the
        // flame appears to rise. flameSpeed keeps it slow and
        // framerate-independent.
        float  t = materialParams.time * materialParams.flameSpeed + seed * 7.0;

        // Centre x around 0 so |x| is the distance from the flame axis.
        float2 p = float2(uv.x - 0.5, uv.y);

        // ── Horizontal turbulence (the flicker) ────────────────
        // Domain-warp the axis sideways by upward-scrolling noise.
        // The warp grows with height so the base stays anchored on
        // the wick and the tip whips around.
        float warp = (fbm(float2(p.x * 3.0 + seed, p.y * 2.5 - t)) - 0.5);
        p.x += warp * 0.35 * p.y;

        // ── Flame envelope ─────────────────────────────────────
        // Flickering top height (so the flame breathes up and down).
        float top = 0.82 + 0.16 * (fbm(float2(seed * 3.1, -t * 0.9)) - 0.5) * 2.0;

        // Width profile: a teardrop — pinched at the very base,
        // bulging low, tapering to a point at `top`. Narrower than
        // before so the flame is a slim tongue, not a fat blob.
        float yn = clamp(p.y / max(top, 1e-3), 0.0, 1.0);
        float width = 0.26 * sin(3.14159 * pow(yn, 0.65)) * (1.0 - yn * 0.15);
        width = max(width, 1e-3);

        // Distance from the axis, normalised by the local width.
        float d = abs(p.x) / width;

        // Core mask: 1 on the axis, 0 at the flame edge; cut above top.
        float body = (1.0 - d) * step(p.y, top);
        body = clamp(body, 0.0, 1.0);

        // High-frequency detail eats INTO the flame so it looks like
        // wispy licking tongues rather than a solid teardrop. We
        // subtract a noise field (rather than just modulating) so
        // holes and gaps open up through the body, especially toward
        // the edges and tip.
        float detail = fbm(float2(p.x * 8.0 + seed * 5.0, p.y * 6.0 - t * 1.8));
        // Erode: stronger erosion higher up and nearer the edge.
        float erode = (0.35 + 0.5 * d + 0.4 * yn) * (1.0 - detail);
        body = clamp(body - erode, 0.0, 1.0);

        // Intensity: sharpen the core so the centre reads white-hot.
        float intensity = smoothstep(0.04, 0.45, body);

        // ── Fire colour ramp ───────────────────────────────────
        // edge → deep red, mid → orange, inner → yellow, core → white
        float3 col = float3(0.55, 0.04, 0.0);
        col = mix(col, float3(1.0, 0.42, 0.05), smoothstep(0.05, 0.45, intensity));
        col = mix(col, float3(1.0, 0.85, 0.25), smoothstep(0.45, 0.75, intensity));
        col = mix(col, float3(1.0, 0.98, 0.85), smoothstep(0.80, 1.0, intensity));

        // Apply the per-emitter tint and push into HDR so bloom
        // catches the bright core. Per-plane brightness kept modest
        // because 3 overlapping planes accumulate additively.
        col *= materialParams.tint * 1.0;

        // Body mask with a soft silhouette fade. For additive
        // blending we premultiply the colour by this mask so masked
        // regions add nothing. Kept low so the flame stays airy and
        // translucent — you can see through the wisps rather than it
        // being a solid opaque tongue.
        float a = smoothstep(0.02, 0.40, body) *
                  materialParams.alphaScale *
                  materialParams.particleShapeTuning.w;

        // Additive output — RGB is added to the framebuffer; the
        // alpha channel is unused by `add` blending but we keep it
        // consistent.
        material.baseColor = float4(col * a, a);
    }
}
