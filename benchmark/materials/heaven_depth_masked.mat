// Heaven Benchmark — Scene depth-output material (ALPHA-MASKED variant)

// Companion to heaven_depth.mat for alpha-tested foliage (trees, branches,
// leaves). The plain heaven_depth material is opaque and ignores alpha, so a
// fir-tree billboard card writes a SOLID rectangular silhouette into the
// linear scene-depth texture — which the screen-space consumers (fog, god
// rays, volumetric clouds, rain splash) then read as a solid occluder,
// producing flat tree-card-shaped phantom artifacts that do not match the
// see-through foliage actually on screen.

// This variant alpha-tests the foliage exactly like the visible material
// (heaven_lit_twosided.mat, which is `blending: masked, maskThreshold: 0.5`),
// so only the real foliage pixels write depth and the depth silhouette matches
// the sparse foliage. Vertex writes linear eye-space forward distance (metres)
// to baseColor.r as in heaven_depth; the fragment additionally samples the
// foliage diffuse alpha and lets `blending: masked` discard the gaps.

// Compiled with: matc -a all -p desktop -o heaven_depth_masked.filamat heaven_depth_masked.mat

material {
    name : heaven_depth_masked,
    requires : [ uv0, custom0, tangents, custom1, custom2, custom3, custom4, custom5, custom6, custom7 ],
    shadingModel : unlit,
    // Alpha-tested cutout, matching heaven_lit_twosided's cutoff so the depth
    // silhouette equals the visible foliage silhouette (spec).
    blending : masked,
    maskThreshold : 0.5,
    // Foliage is two-sided; the depth silhouette must cover both faces.
    doubleSided : true,
    flipUV : false,
    depthWrite : true,
    depthCulling : true,
    parameters : [
        // Foliage diffuse map — only its ALPHA channel is used (the cutout).
        { type : sampler2d, name : baseColorMap },
        { type : sampler2d, name : geometryHeightMap, stages : [ vertex ] },
        { type : bool,      name : geometryDisplacement },
        // UV transform (uv*xy + zw) so the alpha is sampled with the same UVs
        // the visible material uses. Defaults to identity {1,1,0,0}.
        { type : float4,    name : baseTransform },
        { type : float4,    name : displacementParams }
    ],
    variables : [
        // .x = eye-space forward distance in metres;.yzw unused.
        eyeDepth
    ]
}

vertex {
    #include "includes/bounded_displacement.glsl"
    void materialVertex(inout MaterialVertexInputs material) {
        if (materialParams.geometryDisplacement && getCustom7().w > 0.0) {
            applyParentChord(material);
        } else if (materialParams.geometryDisplacement) {
            float3 userWorldPosition =
                    (getUserWorldFromWorldMatrix() * material.worldPosition).xyz;
            float distance = length(userWorldPosition - getMaterialGlobal1().xyz);
            float normalizedDistance = clamp(
                    (distance - materialParams.displacementParams.z)
                    * materialParams.displacementParams.w, 0.0, 8.0);
            float fade = pow(saturate(1.0 - normalizedDistance),
                             materialParams.displacementParams.y);
            float2 uv = material.uv0.xy * materialParams.baseTransform.xy
                      + materialParams.baseTransform.zw;
            // A vertex is one sample of the height field. Filter frequencies
            // finer than its incident UV edges before moving the geometry;
            // otherwise sparse triangles alias into false shadow-casting folds.
            // CUSTOM0.yz is the UV footprint, populated by MeshStore. Keep the
            // authored distance fade independent of this sampling LOD.
            float2 footprint = getCustom0().yz * abs(materialParams.baseTransform.xy)
                             * float2(textureSize(materialParams_geometryHeightMap, 0));
            float meshLod = log2(max(max(footprint.x, footprint.y), 1.0));
            float heightLod = max(normalizedDistance, meshLod);
            float height = textureLod(materialParams_geometryHeightMap, uv, heightLod).r;
            float offset = (height - 127.0 / 255.0)
                         * materialParams.displacementParams.x * fade
                         * getCustom0().x;
            material.worldPosition.xyz += normalize(material.worldNormal) * offset;
        }
        // Same forward eye-space distance as heaven_depth.mat.
        float4 viewPos = getViewFromWorldMatrix() * material.worldPosition;
        material.eyeDepth = float4(-viewPos.z, 0.0, 0.0, 0.0);
    }
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);

        // Sample the foliage diffuse alpha at the (transformed) UV. `masked`
        // blending discards fragments whose alpha < maskThreshold (0.5), so
        // only solid foliage pixels survive and write depth — the cutout
        // matches the visible heaven_lit_twosided silhouette.
        float2 uv = getUV0() * materialParams.baseTransform.xy
                  + materialParams.baseTransform.zw;
        float alpha = texture(materialParams_baseColorMap, uv).a;

        // Red = linear eye-space distance (metres); alpha drives the cutout.
        material.baseColor = float4(variable_eyeDepth.x, 0.0, 0.0, alpha);
    }
}
