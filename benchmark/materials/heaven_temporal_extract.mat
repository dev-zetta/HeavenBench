// Separate full-resolution SDK inputs from the packed temporal proxy target.
material {
    name : heaven_temporal_extract,
    shadingModel : unlit,
    vertexDomain : device,
    blending : opaque,
    doubleSided : true,
    depthWrite : false,
    depthCulling : false,
    parameters : [
        { type : sampler2d, name : packedTexture },
        { type : bool, name : extractDepth }
    ]
}
fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        float2 uv = uvToRenderTargetUV(getNormalizedViewportCoord().xy);
        float4 packed = texture(materialParams_packedTexture, uv);
        material.baseColor = materialParams.extractDepth
            ? float4(packed.z, 0.0, 0.0, 1.0)
            : float4(packed.xy, 0.0, 1.0);
    }
}
