// Heaven Benchmark — Chimney heat-haze refraction (grab-pass)

// Per-quad billboard above each chimney. The fragment shader
// samples the captured scene texture at screen_uv + noise_offset
// and outputs it with mask alpha so overlapping quads composite
// into a continuous shimmer that distorts the building behind.

// Replicates the technique in Heaven's
// `core/shaders/default/particles/fragment_base_refraction.shader`:
// the original engine writes a packed normal-offset buffer in
// the refraction pass and a later screen-space step samples the
// scene at screen_uv + offset. We collapse those two steps into
// one shader since we already hold the scene-capture texture as
// a sampler.

// Per-quad attributes (same layout as heaven_smoke.mat so we can
// share its vertex / index buffers):
//   POSITION.xyz = quad world position
//   UV0.xy       = corner ID (0..1)
//   CUSTOM0.xyzw = (slot, base_radius, growth, rise_speed)
//   CUSTOM1.x    = lifetime

// Material parameters:
//   sceneTexture: sampler2D — captured scene framebuffer
//   resolution: float2 — viewport (w, h) in pixels
//   time: float — animation time
//   spawnInterval: float — phase offset between staggered quads
//   strength: float — peak refraction normal magnitude

// Compiled with:
//   matc -a all -p desktop -o heaven_heat_haze.filamat heaven_heat_haze.mat

material {
    name : heaven_heat_haze,
    requires : [ uv0, custom0, custom1 ],
    shadingModel : unlit,
    blending : transparent,
    doubleSided : true,
    flipUV : false,
    depthWrite : false,
    depthCulling : false,
    parameters : [
        { type : sampler2d, name : sceneTexture },
        { type : sampler2d, name : sceneDepth },
        { type : float,     name : time },
        { type : float,     name : spawnInterval },
        { type : float,     name : strength },
        // Fadeout distance: heat haze is only visible up close in
        // the original benchmark. Beyond `fadeFar` the alpha is
        // zero; below `fadeNear` it's at full strength; in between
        // it ramps linearly. Both are world-space metres.
        { type : float,     name : fadeNear },
        { type : float,     name : fadeFar },
        { type : float4,    name : hazeShapeTuning }
    ],
    variables : [
        ageInfo  // .x = t01,.y = slot,.z = eye-space dist (m),.w = unused
    ]
}

vertex {
    float hash11(float x) {
        x = fract(x * 0.1031);
        x *= x + 33.33;
        x *= x + x;
        return fract(x);
    }

    void materialVertex(inout MaterialVertexInputs material) {
        float3 emitter_origin = material.worldPosition.xyz;
        float2 corner = material.uv0.xy * 2.0 - 1.0;
        float4 c0 = getCustom0();
        float4 c1 = getCustom1();
        float slot       = c0.x;
        float base_radius= c0.y;
        float growth     = c0.z;
        float velocity   = c0.w;
        float lifetime   = c1.x;

        float total_cycle = lifetime + materialParams.spawnInterval;
        float slot_phase  = slot * materialParams.spawnInterval;
        float age = mod(materialParams.time - slot_phase, total_cycle);

        float r1 = hash11(slot * 1.7);
        float r2 = hash11(slot * 3.1 + 4.0);
        float r3 = hash11(slot * 5.3 + 9.0);

        float alive = step(age, lifetime);
        float t01   = age / lifetime;

        // Heat haze rises slightly faster than the smoke does — the
        // distortion is the leading edge of the warm air column.
        float rise = (velocity * materialParams.hazeShapeTuning.x) * age +
                     materialParams.hazeShapeTuning.y * age * age;
        float wander =
            materialParams.hazeShapeTuning.z *
            sin(materialParams.time * 0.6 + slot * 2.7);
        float3 pos_local = float3(
            (r1 - 0.5) * 0.04 + wander * t01,
            (r2 - 0.5) * 0.04 + wander * 0.6 * t01,
            rise);

        // Quads start small at the chimney mouth and expand upward
        // as the heated air cools and disperses.
        float size_ramp = 0.30 + 1.20 * t01;
        float radius = (base_radius * size_ramp + growth * age * 0.5) * alive;

        float3 cam_right = float3(frameUniforms.worldFromViewMatrix[0].xyz);
        float3 cam_up    = float3(frameUniforms.worldFromViewMatrix[1].xyz);
        float roll = r3 * 6.28318530718;
        float cs = cos(roll), sn = sin(roll);
        float3 right = (cam_right *  cs + cam_up *  sn) * radius;
        float3 up    = (cam_right * -sn + cam_up *  cs) * radius;

        float3 world = emitter_origin + pos_local
                     + corner.x * right + corner.y * up;
        material.worldPosition = float4(world, 1.0);

        // Eye-space forward distance (metres) of this haze fragment, for
        // the linear scene-depth occlusion test in the fragment shader.
        // The scene-depth texture stores the same quantity (-viewZ of the
        // nearest opaque surface), so the comparison is apples-to-apples.
        float4 viewPos  = getViewFromWorldMatrix() * float4(world, 1.0);
        float  quadDist = -viewPos.z;
        material.ageInfo = float4(t01, slot, quadDist, 0.0);
    }
}

fragment {
    float hash21(float2 p) {
        p = fract(p * float2(123.34, 456.21));
        p += dot(p, p + 45.32);
        return fract(p.x * p.y);
    }

    float vnoise(float2 p) {
        float2 i = floor(p);
        float2 f = fract(p);
        f = f * f * (3.0 - 2.0 * f);
        float a = hash21(i);
        float b = hash21(i + float2(1.0, 0.0));
        float c = hash21(i + float2(0.0, 1.0));
        float d = hash21(i + float2(1.0, 1.0));
        return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
    }

    float fbm(float2 p) {
        float s = 0.0;
        float a = 0.5;
        for (int i = 0; i < 4; ++i) {
            s += a * vnoise(p);
            p *= 2.07;
            a *= 0.5;
        }
        return s;
    }

    void material(inout MaterialInputs material) {
        prepareMaterial(material);

        float t01  = variable_ageInfo.x;
        float slot = variable_ageInfo.y;
        float2 ouv = (getUV0() - 0.5) * 2.0; // [-1,1]

        // Generous discard outside the disc.
        float r2 = dot(ouv, ouv);
        if (r2 > 1.0) discard;

        // ── Linear scene-depth occlusion ───────────────────────

        // The haze quad billboards in 3D world space, but we draw
        // them in a separate composite pass that doesn't share
        // Filament's automatic depth test against the main scene.
        // Sample the linear scene-depth texture (F, eye-space
        // forward distance in metres) produced by the depth pre-pass
        // heaven_depth proxy render, and discard wherever opaque
        // scene geometry sits in FRONT of this fragment — otherwise
        // the shimmer shows through walls.

        // Sampling convention is LOCKED (scene-depth-pipeline task
        // the offscreen RT is Y-flipped versus the quad UV
        // (Vulkan top-down framebuffer), so the depth is sampled at
        // float2(uv.x, 1 - uv.y) — the same convention as heaven_blit
        // godrays / volfog / lens flare. getNormalizedViewportCoord()
        // .xy == gl_FragCoord.xy * getResolution().zw.
        float2 fUV = getNormalizedViewportCoord().xy;
        float2 dUV = uvToRenderTargetUV(fUV);
        float sceneDist = texture(materialParams_sceneDepth, dUV).r;

        // Graceful fallback: a null/unbound depth texture reads
        // a non-positive value. Treat that as "far / no geometry" so
        // the haze is NOT occluded before the depth pre-pass produces
        // a valid texture.
        if (sceneDist <= 0.0) sceneDist = 2000.0;

        // Occlude when opaque geometry is nearer to the camera than
        // this haze fragment. A small bias in metres keeps the haze
        // from self-rejecting where it sits just in front of the
        // chimney it rises from (coplanar tolerance).
        float quadDist = variable_ageInfo.z;
        if (sceneDist < quadDist - 0.05) discard;

        // Per-slot UV offset so each quad has unique noise.
        float2 seed_off = float2(hash21(float2(slot, 0.0)),
                                 hash21(float2(0.0, slot))) * 17.0;

        // Scroll noise upward — that's the rising warm-air pattern.
        float2 nuv = ouv * 2.5 + seed_off +
                     float2(0.0,
                            -materialParams.time *
                                materialParams.hazeShapeTuning.w);

        // Two-channel fbm gives us a 2D distortion field.
        float n1 = fbm(nuv);
        float n2 = fbm(nuv + float2(7.3, 2.1));
        float2 dn = (float2(n1, n2) - 0.5) * 2.0;

        // Life envelope: refraction fades in quickly, plateaus,
        // fades out gently.
        float fade_in  = clamp(t01 / 0.20, 0.0, 1.0);
        float fade_out = clamp(1.0 - (t01 - 0.30) / 0.70, 0.0, 1.0);
        float env      = fade_in * fade_out;

        // Soft circular alpha falloff so the disc edge is invisible.
        float alpha_disc = smoothstep(1.0, 0.5, r2);

        // ── Distance fadeout ───────────────────────────────────

        // Heat haze in the original Heaven benchmark is only
        // visible from close range — at the world's scale the
        // shimmer just becomes screen-pixel noise across distant
        // terrain. We compute the distance from the camera to
        // this fragment in world units and fade alpha to zero
        // beyond `fadeFar`.
        float3 cam_pos = float3(frameUniforms.worldFromViewMatrix[3].xyz);
        float  dist    = length(getWorldPosition().xyz - cam_pos);
        float  dist_alpha = 1.0 - smoothstep(materialParams.fadeNear,
                                             materialParams.fadeFar,
                                             dist);
        if (dist_alpha <= 0.001) discard;

        // ── Sample the captured scene at screen_uv + offset ────

        // Filament gives us `getNormalizedViewportCoord()` which
        // is the fragment's NDC position in [0,1]; that's the
        // correct UV for sampling a fullscreen capture texture.
        // The Vulkan capture target is Y-flipped relative to the
        // texture's natural orientation; we flip V to compensate
        // (matches the heaven_blit shader and godrays/volfog).
        float2 uv = uvToRenderTargetUV(getNormalizedViewportCoord().xy);
        float2 distorted = uv + dn * (materialParams.strength * env);

        // Clamp so we don't sample outside the texture (avoids
        // black borders at the screen edges).
        distorted = clamp(distorted, float2(0.001), float2(0.999));

        float4 sampled = texture(materialParams_sceneTexture, distorted);

        // Output the bent sample; alpha controls how strongly it
        // overrides the existing framebuffer (which already shows
        // the unbent scene from the blit pass).
        float alpha = alpha_disc * env * dist_alpha;
        material.baseColor = float4(sampled.rgb * alpha, alpha);
    }
}
