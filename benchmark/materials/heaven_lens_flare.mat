// Heaven Benchmark — Lamp / window lens flare

// Per-light camera-facing billboard. Each flare is a 4-vertex quad with
// the LIGHT WORLD POSITION baked into the POSITION attribute of every
// vertex (same pattern the smoke / firefly particle materials use). The
// vertex shader reads the world-space lamp position from
// material.worldPosition.xyz, then adds camera-aligned corner offsets to
// build the camera-facing quad.

// Occlusion is SOFT and screen-space, sampling the linear scene-depth
// texture (F, eye-space forward distance in metres) produced by the
// depth pre-pass / heaven_depth proxy render. depthCulling is OFF: the
// hardware depth test hid occluded flares correctly but hard-clipped the
// flat quad against the wall the lamp is mounted on. Instead the fragment
// shader compares both the flare anchor and each halo pixel against scene
// depth. The anchor test fades the whole flare when the lamp is hidden; the
// per-pixel test trims halo spill where the additive quad overlaps nearby
// walls / hull panels, preventing the close-range white blobs.

// Sampling convention is LOCKED (scene-depth-pipeline): the
// offscreen RT is Y-flipped versus the quad UV (Vulkan top-down
// framebuffer), so the depth is sampled at float2(uv.x, 1 - uv.y) — the
// same convention as heaven_blit / godrays / volfog / the depth debug viz.

// Compiled with: matc -a all -p desktop -o heaven_lens_flare.filamat heaven_lens_flare.mat

material {
    name : heaven_lens_flare,
    requires : [ uv0 ],
    shadingModel : unlit,
    blending : add,
    doubleSided : true,
    flipUV : false,
    depthWrite : false,
    // Depth-culling OFF — occlusion is the soft scene-depth comparison in
    // the fragment shader, not the hardware depth test (which hard-clipped
    // the quad against the lamp's mounting surface).
    depthCulling : false,
    parameters : [
        { type : sampler2d, name : flareTex },
        // Linear scene-depth texture (F, eye-space forward metres) for
        // the soft occlusion test. Bound by LensFlareFeature;
        // a null/unbound texture reads as "far" so the flare is not
        // occluded before the depth pre-pass produces a real texture.
        { type : sampler2d, name : depthTexture },
        { type : float3,    name : tint },
        { type : float,     name : fadeFar },
        { type : float,     name : fadeNear },
        { type : float,     name : maxRadius },
        { type : float,     name : brightness },
        { type : float4,    name : flareShaderTuning }
    ],
    variables : [
        flareCtx,
        // .xy = the lamp ANCHOR's screen-space UV (0..1), used to sample scene
        // depth at the lamp position for whole-flare occlusion..zw unused.
        anchorInfo
    ]
}

vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        // POSITION holds the lamp world position (same for all 4 verts).
        // UV0 is the corner id in [0,1].
        float3 lpos   = material.worldPosition.xyz;
        float2 corner = material.uv0.xy * 2.0 - 1.0;

        // Both positions must use Filament's shifted/rotated world frame.
        // A user-world camera uniform would apply the camera offset twice.
        float3 cpos    = getWorldCameraPosition();
        float3 toCam   = cpos - lpos;
        float  dist    = length(toCam);
        float3 dirCam  = toCam / max(dist, 1e-4);

        // Anchor the billboard AT the lamp position. The camera-ward push
        // is gone — soft depth occlusion replaces the hardware depth test,
        // so the quad no longer needs to be shoved in front of the wall to
        // avoid a hard clip. Keep the near-plane clamp so a lamp closer
        // than the 0.5 m near plane still anchors just in front of it and
        // stays visible. Moving along the camera→light ray would
        // not change the on-screen position; here D == dist for any lamp
        // beyond the near plane, so anchor == lpos.
        float D    = max(dist, 0.55);
        float3 anchor = cpos - dirCam * D;

        // Proximity ramp: tiny far away, larger and softer up close.
        float close_t = clamp((materialParams.fadeFar - dist) /
                              max(0.001, materialParams.fadeFar - materialParams.fadeNear),
                              0.0, 1.0);
        float near_t = close_t * close_t;

        // Lens flares are perceived in screen/angle space. Build a world-space
        // radius from an angular size so far lamps stay as small glints while
        // nearby lamps naturally grow on screen. maxRadius is a safety cap,
        // not the primary sizing curve.
        float angularRadius = mix(0.0045, 0.070, near_t);
        float radius = angularRadius * dist;
        radius = min(radius, mix(materialParams.maxRadius * 0.45,
                                 materialParams.maxRadius * 1.85,
                                 near_t));
        // Keep the billboard half-extent in front of the anchor.
        radius = min(radius, D * 0.85);

        float3 cam_right = float3(frameUniforms.worldFromViewMatrix[0].xyz);
        float3 cam_up    = float3(frameUniforms.worldFromViewMatrix[1].xyz);

        float3 world = anchor
                     + corner.x * cam_right * radius
                     + corner.y * cam_up    * radius;
        material.worldPosition = float4(world, 1.0);

        // Eye-space forward distance (metres) of the flare anchor, for the
        // soft depth-occlusion test in the fragment shader. The scene-depth
        // texture stores the same quantity (-viewZ of the nearest surface),
        // so the comparison is apples-to-apples.
        float4 anchorView = getViewFromWorldMatrix() * float4(anchor, 1.0);
        float quadDist = -anchorView.z;

        material.flareCtx = float4(close_t, dist, quadDist, 0.0);

        // Screen-space UV of the lamp ANCHOR (not this vertex), so the fragment
        // shader can fade the WHOLE flare by the lamp's own visibility.
        float4 anchorClip = getClipFromViewMatrix() * anchorView;
        float2 anchorNDC  = anchorClip.xy / max(anchorClip.w, 1e-4);
        material.anchorInfo = float4(anchorNDC * 0.5 + 0.5, 0.0, 0.0);
    }
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);

        float dist = variable_flareCtx.y;

        // Sample the flare halo (fire_glow_dr.dds — radial gradient).
        float2 uv = getUV0();
        float halo = texture(materialParams_flareTex, uv).r;

        // Radial coordinate: 0 at centre, 1 at edge midpoints.
        float2 ouv = (uv - 0.5) * 2.0;
        float r = length(ouv);

        // Radial starburst overlay. It grows with proximity: distant lamps are
        // mostly soft bloom, close lamps develop visible aperture streaks.
        float angle = atan(ouv.y, ouv.x);
        float streak = pow(max(0.0, cos(angle * 3.0)), 12.0)
                     + pow(max(0.0, cos(angle * 3.0 + 1.57)), 12.0);
        float streakMask = streak * exp(-1.35 * r);

        // Soft circular window so the additive quad never shows its
        // square silhouette — keeps the glint round.
        float window = smoothstep(1.0, 0.15, r);

        // Brightness ramp. Fade in from far distance and keep the close-up
        // lamp glint visible; the per-pixel depth trim below handles spill
        // against nearby opaque surfaces.
        float prox = clamp((materialParams.fadeFar - dist) /
                           max(0.001, materialParams.fadeFar - materialParams.fadeNear),
                           0.0, 1.0);
        float closeFade = smoothstep(0.20, 0.75, dist);
        float ramp = prox * closeFade;

        float nearShape = clamp((materialParams.fadeNear - dist) /
                                max(0.001, materialParams.fadeNear),
                                0.0, 1.0);
        float core = halo * mix(1.0, 1.45, nearShape)
                   + streakMask * mix(0.28, 0.80, nearShape);
        float intensity = core * window * ramp
                        * materialParams.brightness * mix(2.3, 3.2, nearShape);

        // ── Soft depth occlusion ───────────────────────────────────────
        // Anchor occlusion fades the whole flare when the lamp itself is
        // hidden. Pixel occlusion trims additive spill where the quad overlaps
        // nearby opaque geometry. Both use the locked render-target UV helper.
        float2 aUV = clamp(variable_anchorInfo.xy, 0.0, 1.0);
        float anchorDist = texture(materialParams_depthTexture,
                                   uvToRenderTargetUV(aUV)).r;
        float pixelDist = texture(materialParams_depthTexture,
                                  uvToRenderTargetUV(getNormalizedViewportCoord().xy)).r;

        // Graceful fallback: a null/unbound depth texture reads a
        // non-positive value. Treat that as "far / no geometry" so the
        // flare is NOT occluded before the depth pre-pass produces a valid
        // texture.
        if (anchorDist <= 0.0) anchorDist = materialParams.flareShaderTuning.x;
        if (pixelDist <= 0.0) pixelDist = materialParams.flareShaderTuning.x;

        // Occlude when opaque geometry sits in FRONT of the lamp anchor.
        // `tol` tolerates geometry within a small distance ahead of the
        // emitter (the lamp's own housing/glass); `band` gives a
        // soft fade so the flare has no hard pop as the lamp goes behind
        // geometry. When no geometry is in front (sceneDist >=
        // quadDist, including the far/sky value) occl == 0.
        float quadDist = variable_flareCtx.z;
        float anchorTol = materialParams.flareShaderTuning.y;
        float anchorBand = materialParams.flareShaderTuning.z;
        float anchorOccl = smoothstep(anchorTol, anchorTol + anchorBand,
                                      quadDist - anchorDist);

        const float pixelTol  = 0.15;
        const float pixelBand = 0.65;
        float pixelOccl = smoothstep(pixelTol, pixelTol + pixelBand,
                                     quadDist - pixelDist);
        float spillTrim = smoothstep(0.55, 1.05, r);
        intensity *=
            (1.0 - anchorOccl) *
            (1.0 - pixelOccl * spillTrim *
                       materialParams.flareShaderTuning.w);

        float3 rgb = materialParams.tint * intensity;
        material.baseColor = float4(rgb, 1.0);
    }
}
