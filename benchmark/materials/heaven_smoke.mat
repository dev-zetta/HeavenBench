// Heaven Benchmark — GPU-driven smoke particles

// Each emitter renderable has N quads pre-allocated at scene-load time.
// Per-particle state (position, size, alpha) is computed entirely in the
// vertex shader from a per-slot seed and a `time` uniform — zero CPU
// work per frame after the buffer is built once.

// Vertex attributes (one quad = 4 vertices):
//   POSITION.xyz = emitter origin in world space (same for all 4 verts)
//   UV0.xy       = corner ID in [0,1] (BL, BR, TR, TL)
//   CUSTOM0.xyzw = (slot index, base_radius, growth, velocity)
//   CUSTOM1.x    = lifetime (seconds)

// Material parameters (set per emitter MaterialInstance):
//   time: float — global animation time (seconds)
//   tint: float3 — RGB tint baked from the emitter material
//   alphaScale: float — peak alpha during plateau
//   spawnInterval: float — seconds between staggered slot spawns

// Compiled with: matc -a all -p desktop -o heaven_smoke.filamat heaven_smoke.mat

material {
    name : heaven_smoke,
    requires : [ uv0, custom0, custom1 ],
    shadingModel : lit,
    blending : transparent,
    doubleSided : true,
    flipUV : false,
    depthWrite : false,
    transparency : twoPassesTwoSides,
    parameters : [
        { type : float,  name : time },
        { type : float3, name : tint },
        { type : float,  name : alphaScale },
        { type : float,  name : spawnInterval },
        { type : float4, name : particleMotionTuning },
        { type : float4, name : particleShapeTuning }
    ],
    variables : [
        ageNorm,        // .x = age/life,.y = slot seed,.z = rise (m above emitter)
        worldPos        // world-space position for noise sampling
    ]
}

vertex {
    #include "includes/effect_smoke_vertex.glsl"
    void materialVertex(inout MaterialVertexInputs material) {
        effectVertex(material, materialParams.time,
            float3(frameUniforms.worldFromViewMatrix[0].xyz),
            float3(frameUniforms.worldFromViewMatrix[1].xyz),
            getWorldCameraPosition(), (getUserWorldFromWorldMatrix() * float4(getWorldCameraPosition(), 1.0)).xyz);
    }
}

fragment {
    #include "includes/effect_smoke_fragment.glsl"
    void material(inout MaterialInputs material) { effectShade(material); }
}
