// Heaven Benchmark — Standard lit material
// Displacement is handled by CPU tessellation at load time (not POM).

material {
    name : heaven_lit,
    requires : [ uv0, uv1, custom0, custom1, custom2, custom3, custom4, custom5, custom6, custom7 ],
    shadingModel : lit,
    blending : opaque,
    doubleSided : false,
    flipUV : false,
    // This material supplies scalar visibility, not an authored bent-normal map.
    // Use the scalar fallback; Filament still applies screen-space bent-normal
    // cones when the View provides them. Do not invent an ambient aperture from
    // the normal-map shading direction on grazing surfaces.
    specularAmbientOcclusion : simple,
    multiBounceAmbientOcclusion : true,
    // Specular anti-aliasing. The feature is COMPILED IN here
    // with `specularAntiAliasing: true`; its per-instance strength — variance
    // and threshold — is NOT a user `parameter` you declare in this block.
    // Filament exposes the tuning through dedicated MaterialInstance setters
    // (MaterialInstance::setSpecularAntiAliasingVariance /
    // setSpecularAntiAliasingThreshold, verified in
    // lib/filament/.../filament/MaterialInstance.h). So the wiring is purely in
    // MaterialInstanceCache::set_specular_aa (knob → variance/threshold via
    // heaven::spec_aa_strength), and no parameter declarations are added here.
    // When the feature is disabled the cache never calls the setters, so the
    // instance keeps Filament's defaults (≤1/255 parity).
    specularAntiAliasing : true,
    parameters : [
        { type : sampler2d, name : baseColorMap },
        { type : bool,      name : hasBaseColor },
        { type : int,       name : legacyColorFlags },
        { type : sampler2d, name : normalMap },
        { type : bool,      name : hasNormal },
        { type : float,     name : normalStrength },
        { type : sampler2d, name : specularMap },
        { type : bool,      name : hasSpecular },
        { type : sampler2d, name : emissiveMap },
        { type : bool,      name : hasEmissive },
        { type : float3,    name : emissionTint },
        { type : float,     name : emissionScale },
        { type : sampler2d, name : detailMap },
        { type : sampler2d, name : detailNormalMap },
        { type : sampler2d, name : detailSpecularMap },
        { type : bool,      name : hasDetail },
        { type : int,       name : detailMode },
        { type : float3,    name : detailStrength },
        { type : bool,      name : detailUsesBaseAlpha },
        { type : float4,    name : detailTransform },
        { type : float4,    name : baseTransform },
        { type : sampler2d, name : heightMap },
        // Vertex geometry uses a separate isotropic trilinear sampler.
        { type : sampler2d, name : geometryHeightMap, stages : [ vertex ] },
        { type : bool,      name : geometryDisplacement },
        { type : bool,      name : displacedSurfaceNormal },
        { type : bool,      name : groundReliefSurface },
        { type : float4,    name : displacementParams },
        { type : bool,      name : hasHeight },
        { type : float,     name : displacementScale },
        // Authoritative metallic flag, derived in the C++ code from
        // the material's parent chain (true ⇔ ancestor is
        // mesh_paint_reflection_cube_base or its tessellation
        // sibling). Drives whether the spec map contributes to
        // metallic + low roughness, or just to a subtle dielectric
        // gloss.
        { type : bool,      name : isMetallic },
        { type : bool,      name : specGlossWorkflow },
        { type : float4,    name : surfaceSamplingTuning },
        { type : float4,    name : surfaceMetallicTuning },
        { type : float4,    name : surfaceDielectricTuning },
        { type : float4,    name : surfaceReflectanceTuning },
        { type : float4,    name : surfaceEmissionTuning },
        { type : float4,    name : surfaceMaskedEmissionTuning },
        { type : float4,    name : surfaceWetnessTuning },
        { type : float2,    name : surfaceWetnessShape },
        { type : float4,    name : groundReliefTuning },
        { type : float3,    name : groundReliefCavityTuning }
    ],
}

vertex {
    #include "includes/bounded_displacement.glsl"
    void materialVertex(inout MaterialVertexInputs material) {
        if (materialParams.geometryDisplacement && getCustom7().w > 0.0) {
            applyParentChord(material);
        } else if (materialParams.geometryDisplacement) {
            float3 userWorldPosition =
                    (getUserWorldFromWorldMatrix() * material.worldPosition).xyz;
            float distance = length(userWorldPosition - getMaterialGlobal1().xyz);
            float normalizedDistance = clamp(
                    (distance - materialParams.displacementParams.z)
                    * materialParams.displacementParams.w, 0.0, 8.0);
            float fade = pow(saturate(1.0 - normalizedDistance),
                             materialParams.displacementParams.y);
            float2 uv = material.uv0.xy * materialParams.baseTransform.xy
                      + materialParams.baseTransform.zw;
            // A vertex is one sample of the height field. Filter frequencies
            // finer than its incident UV edges before moving the geometry;
            // otherwise sparse triangles alias into false shadow-casting folds.
            // CUSTOM0.yz is the UV footprint, populated by MeshStore. Keep the
            // authored distance fade independent of this sampling LOD.
            float2 footprint = getCustom0().yz * abs(materialParams.baseTransform.xy)
                             * float2(textureSize(materialParams_geometryHeightMap, 0));
            float meshLod = log2(max(max(footprint.x, footprint.y), 1.0));
            float heightLod = max(normalizedDistance, meshLod);
            float height = textureLod(materialParams_geometryHeightMap, uv, heightLod).r;
            float offset = (height - 127.0 / 255.0)
                         * materialParams.displacementParams.x * fade
                         * getCustom0().x;
            material.worldPosition.xyz += normalize(material.worldNormal) * offset;
        }
    }
}

fragment {
    #include "includes/surface_color.glsl"
    void material(inout MaterialInputs material) {
        // Apply Heaven's per-material UV transform — uv*scale + offset.
        // Most materials use the identity {1,1,0,0}; ruins/airship
        // materials use scaled/offset values to wrap the texture at
        // a different rate (e.g. ruins_merlon: vec4(2,1,-1,0)).
        float2 uv = getUV0() * materialParams.baseTransform.xy
                  + materialParams.baseTransform.zw;
        float4 baseSample = materialParams.hasBaseColor
                ? texture(materialParams_baseColorMap, uv)
                : float4(materialParams.surfaceSamplingTuning.xxx, 1.0);
        float4 detailSample =
            float4(materialParams.surfaceSamplingTuning.yyy, 1.0);
        float3 detailBlend = float3(0.0);
        float2 detailUV = uv;
        if (materialParams.hasDetail) {
            float2 detailBaseUV =
                    (materialParams.detailMode == 2 || materialParams.detailMode == 4)
                    ? getUV1() : uv;
            detailUV = detailBaseUV * materialParams.detailTransform.xy
                     + materialParams.detailTransform.zw;
            detailSample = texture(materialParams_detailMap, detailUV);
            float blendAlpha = detailSample.a;
            if (materialParams.detailUsesBaseAlpha) {
                blendAlpha *= baseSample.a;
            }
            detailBlend = materialParams.detailStrength * blendAlpha;
        }

        // ── Normal map + height bump — MUST precede prepareMaterial() ──
        // Filament consumes material.normal INSIDE prepareMaterial() (it bakes
        // shading_normal then); assigning material.normal afterwards is silently
        // ignored. This block was previously after prepareMaterial(), so normal
        // mapping and the height-derived bump were dead on every lit surface.
        float3 tangentNormal = float3(0.0, 0.0, 1.0);
        if (materialParams.hasNormal) {
            float3 n = texture(materialParams_normalMap, uv).xyz;
            if (n.b < materialParams.surfaceSamplingTuning.z) {
                n.xy = n.xy * 2.0 - 1.0;
                n.z = sqrt(max(0.0, 1.0 - dot(n.xy, n.xy)));
            } else {
                n = n * 2.0 - 1.0;
            }
            n = normalize(float3(
                    n.xy * materialParams.normalStrength, max(n.z, 1e-4)));
            if (materialParams.groundReliefSurface) {
                n = normalize(float3(
                        n.xy * materialParams.groundReliefTuning.x,
                        max(n.z, 1e-4)));
            }
            tangentNormal = n;
        }
        if (materialParams.hasDetail && detailBlend.y > 0.0) {
            float2 detailNormal = texture(materialParams_detailNormalMap, detailUV).xy
                                * 2.0 - 1.0;
            tangentNormal.xy += detailNormal * detailBlend.y
                              * materialParams.normalStrength;
        }
        // Height-only materials retain the inexpensive supplemental bump. The
        // village ground instead derives its low/mid-frequency normal from the
        // actual displaced position below, so sampling the same height again
        // here would count that relief twice.
        if (materialParams.hasHeight &&
            !materialParams.displacedSurfaceNormal) {
            float texel = materialParams.surfaceSamplingTuning.w;
            float hc = texture(materialParams_heightMap, uv).r;
            float hx = texture(materialParams_heightMap, uv + float2(texel, 0.0)).r;
            float hy = texture(materialParams_heightMap, uv + float2(0.0, texel)).r;
            float3 bump = float3(hc - hx, hc - hy, 0.0) * 2.0;
            tangentNormal = normalize(tangentNormal + bump);
        }
        if (materialParams.displacedSurfaceNormal) {
            // CPU tessellation supplies enough triangles for the generated
            // height field, while the vertex shader applies distance and
            // boundary fades. Screen derivatives therefore recover the normal
            // of the final visible geometry, including those fades.
            float3 displacedWorldNormal = normalize(cross(
                    dFdx(getWorldPosition()), dFdy(getWorldPosition())));
            mat3 tangentFrame = getWorldTangentFrame();
            float3 originalWorldNormal = normalize(tangentFrame[2]);
            if (dot(displacedWorldNormal, originalWorldNormal) < 0.0) {
                displacedWorldNormal = -displacedWorldNormal;
            }
            float3 displacedTangentNormal = normalize(float3(
                    dot(displacedWorldNormal, normalize(tangentFrame[0])),
                    dot(displacedWorldNormal, normalize(tangentFrame[1])),
                    dot(displacedWorldNormal, originalWorldNormal)));

            // Reoriented normal mapping preserves both the displaced base
            // orientation and the authored BC5 detail. Flat detail returns the
            // displaced normal; a flat displaced base returns tangentNormal.
            float3 rnmBase = displacedTangentNormal + float3(0.0, 0.0, 1.0);
            float3 rnmDetail = tangentNormal * float3(-1.0, -1.0, 1.0);
            tangentNormal = normalize(
                    rnmBase * dot(rnmBase, rnmDetail)
                    / max(rnmBase.z, 1e-4) - rnmDetail);
        }
        if (materialParams.hasNormal || materialParams.hasDetail ||
            materialParams.hasHeight || materialParams.displacedSurfaceNormal) {
            material.normal = normalize(tangentNormal);
        }

        prepareMaterial(material);

        material.baseColor = baseSample;

        material.baseColor.rgb = composeSurfaceColor(
                baseSample.rgb, detailSample.rgb, detailBlend.x,
                materialParams.hasDetail, materialParams.detailMode,
                materialParams.legacyColorFlags);

        if (materialParams.hasSpecular) {
            // Heaven's specular maps encode different things
            // depending on whether the material is authored against
            // the metallic or dielectric pipeline. The classifier
            // is the `isMetallic` flag, derived in the C++ from the
            // material's parent chain (mesh_paint_reflection_cube_base
            // → metal; mesh_base / mesh_tessellation_base → dielectric).

            //   - METAL: spec.r ≈ glossy fresnel intensity. We map
            //     it to roughness (low spec → rough copper, high
            //     spec → polished brass) and let `metallic = 1`
            //     pull F0 from baseColor.
            //   - DIELECTRIC: spec.r is just an authored gloss
            //     mask for crisp ambient highlights. We never
            //     drive `metallic` from it — even bright stucco
            //     spec values must stay matte. Roughness comes
            //     from the spec map but stays in a high range so
            //     plaster doesn't get plastic highlights.
            float3 specColor = texture(materialParams_specularMap, uv).rgb;
            if (materialParams.hasDetail && detailBlend.z > 0.0) {
                float3 detailSpec =
                        texture(materialParams_detailSpecularMap, detailUV).rgb;
                if (materialParams.detailMode <= 2) {
                    specColor = clamp(
                            specColor + (detailSpec * 2.0 - 1.0) * detailBlend.z,
                            0.0, 1.0);
                } else {
                    specColor *= clamp(
                            detailSpec + 1.0 - detailBlend.z, 0.0, 1.0);
                }
            }
            float gloss = clamp(dot(specColor, float3(0.2126, 0.7152, 0.0722)),
                                0.0, 1.0);
            if (materialParams.specGlossWorkflow && materialParams.isMetallic) {
                material.baseColor.rgb *= specColor;
                material.metallic = 1.0;
                material.roughness =
                    clamp(1.0 - gloss,
                          materialParams.surfaceReflectanceTuning.w, 1.0);
                material.reflectance = 0.5;
            } else if (materialParams.specGlossWorkflow) {
                material.metallic = 0.0;
                material.roughness =
                    clamp(1.0 - gloss,
                          materialParams.surfaceReflectanceTuning.w, 1.0);
                material.reflectance = clamp(gloss, 0.16, 1.0);
            } else if (materialParams.isMetallic) {
                material.metallic    = 1.0;
                material.roughness = clamp(
                    1.0 - gloss * materialParams.surfaceMetallicTuning.y,
                    materialParams.surfaceMetallicTuning.z,
                    materialParams.surfaceMetallicTuning.w);
                material.reflectance = 0.5;
            } else {
                material.metallic    = 0.0;
                material.roughness = clamp(
                    1.0 - gloss * materialParams.surfaceDielectricTuning.x,
                    materialParams.surfaceDielectricTuning.y,
                    materialParams.surfaceDielectricTuning.z);
                // Slightly raise dielectric F0 only for surfaces
                // with a meaningful spec map, so e.g. waxed wood
                // or polished tile reads a touch brighter than
                // chalky plaster — capped low so nothing approaches
                // a metallic highlight.
                material.reflectance =
                    mix(materialParams.surfaceDielectricTuning.w,
                        materialParams.surfaceReflectanceTuning.x, gloss);
            }
        } else {
            // No spec map → matte dielectric.
            material.roughness = materialParams.surfaceReflectanceTuning.y;
            material.metallic    = 0.0;
            material.reflectance = materialParams.surfaceReflectanceTuning.z;
        }

        if (materialParams.groundReliefSurface) {
            // Keep dry gravel rough, but not so rough that its authored and
            // displaced normals disappear from broad environment highlights.
            // Wetness is layered later and still approaches the shared 0.30
            // target, so this does not weaken the wet look.
            material.roughness = clamp(
                    material.roughness,
                    materialParams.groundReliefTuning.y,
                    materialParams.groundReliefTuning.z);
            material.reflectance = max(
                    material.reflectance,
                    materialParams.groundReliefTuning.w);

            // Compare the generated height against a coarse mip-local mean.
            // Only concave texels occlude, and ambientOcclusion affects
            // indirect light rather than painting a directional shadow into
            // the diffuse map. Two samples keep this cheaper than a spatial
            // height kernel while retaining deterministic packed mips.
            if (materialParams.hasHeight) {
                float localHeight = texture(materialParams_heightMap, uv).r;
                float meanHeight = textureLod(
                        materialParams_heightMap, uv,
                        materialParams.groundReliefCavityTuning.x).r;
                float cavity = min(
                        max(meanHeight - localHeight, 0.0)
                            * materialParams.groundReliefCavityTuning.y,
                        materialParams.groundReliefCavityTuning.z);
                material.ambientOcclusion = 1.0 - cavity;
            }
        }

        if (materialParams.hasEmissive) {
            float4 esample = texture(materialParams_emissiveMap, uv);
            // The.mat `emission_scale` lives on a roughly linear LDR
            // range where 0.9 is a "subtle tint" (balloon fabric),
            // 4..6 is a "lit window/door", and the backend forces it
            // up to ~3.5 for any lamp/lantern/torch/glass surface
            // (because Heaven only enables those at night via a
            // material variant we don't track).

            // For low scales (< 1.0) we want near-zero output: the
            // balloon fabric should show emission *tint* on the
            // diffuse, not glow. For high scales (> ~3) we want the
            // texture to emit at HDR values that punch through bloom.

            // The smoothstep mask is here so DXT-compressed dark
            // pixels don't trigger emission, but it's gated to a
            // narrow band (0.05.. 0.20). Pixels brighter than that
            // pass through at full strength.

            // Final curve:
            //   scl_in <= 1.0 → near-black emission (preserves balloon
            //                   tint behaviour)
            //   scl_in > 1.0  → linear ramp, with a 4× boost so a
            //                   bulb texel at ~0.5 lum bursts to ~6.0
            //                   in HDR — well over Filament's bloom
            //                   threshold of 1.0, producing the warm
            //                   halo Heaven's `_on` materials gave.
            float scl_in   = materialParams.emissionScale;
            float scl_out =
                max(0.0, scl_in - materialParams.surfaceEmissionTuning.x) *
                materialParams.surfaceEmissionTuning.y;
            float lum      = max(esample.r, max(esample.g, esample.b));
            float mask = smoothstep(materialParams.surfaceEmissionTuning.z,
                                    materialParams.surfaceEmissionTuning.w,
                                    lum);
            float3 tint    = materialParams.emissionTint;
            material.emissive = float4(esample.rgb * tint * mask * scl_out, 0.0);
        }

        // Wetness (Weather_System). g = getMaterialGlobal0():
        //   g.x = specular boost, g.y = diffuse darken, g.z = wet amount in [0,1].
        // Default {0,0,0,1} ⇒ zero change ⇒ exact Shipping_Look parity.
        vec4 g = getMaterialGlobal0();
        float wetAmt = g.z;

        // ─────────────────────────────────────────────────────────────────
        // STAGED DEBUG VISUALIZATION (diagnostic only)

        // We cannot see the screen; the USER runs the build and reports what
        // they observe. These modes bisect the wetness DATA PATH so we can find
        // empirically WHERE the cue is lost — is the wetness global reaching
        // the shader at all, is the Z-up normal alignment right, and does the
        // `wet = g.z * up` term that actually drives the look light up on the
        // ground the user is looking at? Each mode (except 0) writes an
        // unmistakable greyscale into baseColor and SKIPS the real wet shading
        // below, so the screen shows the raw quantity directly. Re-point
        // WET_DEBUG to a different number and re-run `./scripts/build.sh
        // --materials` to switch views.

        //   0 = real shading (no debug) — SHIP DEFAULT.
        //   1 = incoming wetness global as greyscale: baseColor.rgb = vec3(g.z)
        //         → BLACK during rain ⇒ the global is NOT reaching the shader
        //           (data-path / setMaterialGlobal plumbing is the bug).
        //         → GREY/WHITE during rain ⇒ the data path works end-to-end and
        //           the problem is purely the LOOK STRENGTH, not the plumbing.
        //   2 = up-facing term as greyscale: baseColor.rgb =
        //         vec3(clamp(getWorldNormalVector().z, 0, 1))
        //         → WHITE on flat ground facing up, BLACK on walls. Confirms the
        //           Z-up alignment is correct on the ground the user looks at
        //           (if flat ground reads BLACK here, the up-axis is wrong and
        //           every wet cue is being multiplied to ~0 by `up`).
        //   3 = the final drive term as greyscale: baseColor.rgb =
        //         vec3(g.z * clamp(getWorldNormalVector().z, 0, 1))
        //         → this is EXACTLY what scales the wet look. If modes 1 and 2
        //           are bright but this is dark, the two are not overlapping on
        //           the surface in view; if this is bright but mode 0 still
        //           looks dry, the in-shader multipliers are simply too weak.

        // NOTE: every debug mode runs regardless of the `wetAmt > 0.0` gate so
        // the greyscale still shows the raw quantity (and stays black at zero
        // wetness, which is the correct dry reading). The real shading branch
        // below is only compiled into mode 0.
        // ─────────────────────────────────────────────────────────────────
        #define WET_DEBUG 0

        #if WET_DEBUG == 1
            material.baseColor.rgb = vec3(g.z);
        #elif WET_DEBUG == 2
            material.baseColor.rgb = vec3(clamp(getWorldNormalVector().z, 0.0, 1.0));
        #elif WET_DEBUG == 3
            material.baseColor.rgb = vec3(g.z * clamp(getWorldNormalVector().z, 0.0, 1.0));
        #else
        if (wetAmt > 0.0) {
            // Upward-facing surfaces pool water; downward-facing stay drier.
            float up = clamp(getWorldNormalVector().z, 0.0, 1.0); // Heaven world is Z-up
            float wet = wetAmt * up;
            float pool = up * up;                                       // deepest on flat ground

            // ── Diffuse darkening — the dominant, sky-independent wet cue ──
            // LOOK PASS 4 (decisive overcast read): rain-darkened ground is the
            // strongest wet cue that does NOT depend on reflecting the sky, so we
            // make it deep and unmistakable. Three terms, all growing with `wet`
            // (== g.z·up) so the cue reads at the default medium rain (w≈0.48),
            // not only at full storm:
            //   • g.y·wet      — the endpoint-scaled darken from types.h.
            //   • wet·0.30     — a base wet-stone darken applied to ALL wet
            //                    up-faces (even moderately sloped ground reads
            //                    clearly darker, not just perfect puddles).
            //   • wetAmt·pool·0.55 — extra crevice/puddle pooling, biased hard
            //                    toward horizontal ground by up² (a 45° face gets
            //                    only ~0.25 of it).
            // The clamp FLOOR is lowered 0.35 → 0.45-of-dry so heavily-pooled flat
            // ground reaches ~0.45 of its dry albedo at full wetness — clearly,
            // unmistakably darker than dry, yet physically plausible (wet stone
            // darkens, never pure black). Each term is non-decreasing in g.z for a
            // fixed normal, so the darkening is MONOTONIC in g.z. All purely a
            // diffuse multiply ⇒ survives the overcast lighting and the ACES
            // tonemap without leaning on any sky reflection.
            float darken = g.y * wet                                    // endpoint-scaled darken
                         + wet * materialParams.surfaceWetnessTuning.x
                         + wetAmt * pool * materialParams.surfaceWetnessTuning.y;
            material.baseColor.rgb *=
                clamp(1.0 - darken, materialParams.surfaceWetnessShape.x, 1.0);

            // ── Sun/light-driven specular WET SHEEN (sky-independent) ──
            // LOOK PASS 5 (stop the swimming glint): the previous pass dropped
            // roughness to a near-mirror 0.06 floor. At that roughness the
            // analytic sun/point-light specular forms a TIGHT, bright glint.
            // Because the view vector V at a fixed surface point depends on the
            // eye POSITION, that pinpoint highlight SWIMS across the ground as the
            // camera translates (rotating in place leaves it fixed) — exactly the
            // "moving wet spots" the user reported. The fix is to keep the wet
            // ground glossy but BROAD: blend roughness toward a moderate 0.30
            // target so the specular lobe spreads over a wide area. The wet ground
            // still brightens under the sun/lights (reads as sheened/wet), but the
            // highlight is a soft broad sheen that slides gently rather than a hard
            // moving dot. Stays dielectric — only roughness + reflectance move,
            // metallic is untouched (wet water is not metal). Monotonic in g.z:
            // more wet ⇒ glossier (lower roughness toward 0.30), dry (g.z==0) is
            // untouched. The dominant, view-INDEPENDENT cue remains the diffuse
            // darkening above, which never moves with the camera.
            float wetGloss =
                clamp(wet * materialParams.surfaceWetnessShape.y, 0.0, 1.0);
            material.roughness = clamp(
                mix(material.roughness, materialParams.surfaceWetnessTuning.z,
                    wetGloss),
                materialParams.surfaceWetnessTuning.w, 1.0);
            material.reflectance  = clamp(material.reflectance + g.x * wet, 0.0, 1.0); // spec up
        }
        #endif
    }
}
