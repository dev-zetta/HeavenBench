// Heaven Benchmark — Soft halo glow particles

// Used by two distinct effects that share the same look:
//   1. The `fire_glow` particle in `torch_light.node` — a slow,
//      large halo that pulses around each torch flame.
//   2. The lamp / torch *glare* effect — a camera-facing billboard
//      anchored at every emissive light. As the camera approaches a
//      lamp the glare grows and brightens, mimicking the lens-bloom
//      response of the original benchmark.

// Material samples `fire_glow_dr.dds` (64×64 soft halo) and outputs
// premultiplied-alpha. Each particle picks a slot-deterministic phase
// so a row of torches doesn't pulse in lock-step.

// Compiled with: matc -a all -p desktop -o heaven_glow.filamat heaven_glow.mat

material {
    name : heaven_glow,
    requires : [ uv0, custom0, custom1 ],
    shadingModel : unlit,
    blending : transparent,
    doubleSided : true,
    flipUV : false,
    depthWrite : false,
    transparency : twoPassesTwoSides,
    parameters : [
        { type : sampler2d, name : glowTex },
        { type : float,     name : time },
        { type : float3,    name : tint },
        { type : float,     name : alphaScale },
        { type : float,     name : spawnInterval },
        { type : float4,    name : particleShapeTuning }
    ],
    variables : [
        ageNorm
    ]
}

vertex {
    #include "includes/effect_glow_vertex.glsl"
    void materialVertex(inout MaterialVertexInputs material) {
        effectVertex(material, materialParams.time,
            float3(frameUniforms.worldFromViewMatrix[0].xyz),
            float3(frameUniforms.worldFromViewMatrix[1].xyz),
            getWorldCameraPosition(), (getUserWorldFromWorldMatrix() * float4(getWorldCameraPosition(), 1.0)).xyz);
    }
}

fragment {
    #include "includes/effect_glow_fragment.glsl"
    void material(inout MaterialInputs material) { effectShade(material); }
}
