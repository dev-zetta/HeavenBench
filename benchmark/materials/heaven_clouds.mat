// Heaven Benchmark — Cloud layer material

// Renders a cloud layer at a fixed world height by ray-plane intersection.
// Uses two scrolling cloud textures multiplied with a mask for density.
// Alpha-blended over the sky at far depth. Existing opaque/masked geometry
// occludes the layer; it is sorted before other transparent effects.

// Compiled with: matc -a all -p desktop -o heaven_clouds.filamat heaven_clouds.mat

material {
    name : heaven_clouds,
    requires : [ uv0 ],
    shadingModel : unlit,
    vertexDomain : device,
    blending : transparent,
    doubleSided : true,
    flipUV : false,
    depthWrite : false,
    depthCulling : true,
    parameters : [
        { type : sampler2d, name : cloudTex1 },
        { type : sampler2d, name : cloudTex2 },
        { type : sampler2d, name : cloudMask },
        { type : float3,    name : cameraPos },
        { type : float3,    name : sunDir },
        { type : float3,    name : sunColor },
        { type : float3,    name : skyColor },
        { type : float,     name : time },
        { type : float,     name : cloudHeight },
        { type : float4,    name : cloudShapeTuning },
        { type : float4,    name : cloudMotionTuning },
        { type : float4,    name : cloudDetailTuning },
        { type : float2,    name : cloudDensityLightingTuning }
    ],
}

vertex {
    #include "includes/effect_clouds_vertex.glsl"
    void materialVertex(inout MaterialVertexInputs material) {
        effectVertex(material, materialParams.time,
            float3(frameUniforms.worldFromViewMatrix[0].xyz),
            float3(frameUniforms.worldFromViewMatrix[1].xyz),
            getWorldCameraPosition(), (getUserWorldFromWorldMatrix() * float4(getWorldCameraPosition(), 1.0)).xyz);
    }
}

fragment {
    #include "includes/effect_clouds_fragment.glsl"
    void material(inout MaterialInputs material) { effectShade(material); }
}
