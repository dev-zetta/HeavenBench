// Test-only SURFACE package. No custom depth: opaque lit color is VRS eligible.
material {
    name : smoke_vrs_lit,
    shadingModel : lit,
    blending : opaque,
    doubleSided : true,
    parameters : [ { type : int, name : pattern } ],
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        // Filament's native helper takes the target resolution and normalizes
        // Vulkan / GL Y conventions. The native fixture uses a 128x128 target.
        highp vec2 pixel = floor(getFragCoord(vec2(128.0)));
        float checker = mod(pixel.x + pixel.y, 2.0);
        vec3 color = mix(vec3(0.85, 0.10, 0.05), vec3(0.10, 0.85, 0.05), checker);
        if (materialParams.pattern == 1) {
            // Four phases reveal 2-pixel groups; a 1-pixel checker alone
            // aliases to constant color at even coarse sampling intervals.
            color = vec3((mod(pixel.x, 4.0) + 1.0) / 5.0,
                         (mod(pixel.y, 4.0) + 1.0) / 5.0, 0.10);
        }
        material.baseColor = vec4(0.0, 0.0, 0.0, 1.0);
        // Zero diffuse and specular BRDFs: only the finite emission pattern
        // may reach the oracle, while the package remains opaque lit SURFACE.
        material.metallic = 1.0;
        material.reflectance = 0.0;
        material.roughness = 1.0;
        material.emissive = vec4(color, 0.0);
    }
}
