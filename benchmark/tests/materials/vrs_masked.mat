// Test-only masked lit control; its fragment shading must remain full rate.
material {
    name : smoke_vrs_masked,
    shadingModel : lit,
    blending : masked,
    maskThreshold : 0.5,
    alphaToCoverage : true,
    doubleSided : true,
    parameters : [ { type : int, name : pattern } ],
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        highp vec2 pixel = floor(getFragCoord(vec2(128.0)));
        float checker = mod(pixel.x + pixel.y, 2.0);
        vec3 color = mix(vec3(0.85, 0.10, 0.05), vec3(0.10, 0.85, 0.05), checker);
        if (materialParams.pattern == 1) {
            color = vec3((mod(pixel.x, 4.0) + 1.0) / 5.0,
                         (mod(pixel.y, 4.0) + 1.0) / 5.0, 0.10);
        }
        material.baseColor = vec4(0.0, 0.0, 0.0, 1.0);
        material.metallic = 1.0;
        material.reflectance = 0.0;
        material.roughness = 1.0;
        material.emissive = vec4(color, 0.0);
    }
}
